local lastSkillChat = 0

local function waitMyAnimationEnd(maxSec)
    maxSec = maxSec or 0.85
    local t0 = tick()
    while tick() - t0 < maxSec and UnloadSystem.Active do
        local tr = currentAnimTrack
        if not tr then break end
        local playing = false
        pcall(function() playing = tr.IsPlaying == true end)
        if not playing then break end
        local done = false
        pcall(function()
            if tr.Length and tr.Length > 0 and tr.TimePosition >= tr.Length - 0.08 then
                done = true
            end
        end)
        if done then break end
        task.wait(0.04)
    end
end

local function doTargetSkill(n)
    n = math.clamp(tonumber(n) or 0, 1, 4)
    if n < 1 then return end
    -- не блокируем следующий скилл долго
    if standSkillBusy and (tick() - lastSkillChat) < 0.12 then return end
    if tick() - lastSkillChat < 0.12 then return end
    lastSkillChat = tick()
    standSkillBusy = true
    -- держим спереди 1.5 сек после вылета
    local frontHold = 1.5
    standSkillFrontUntil = tick() + frontHold + 0.2

    task.spawn(function()
        local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if not root then
            standSkillBusy = false
            return
        end

        local _, _, tRoot = getProtectTarget()
        local frontStart = tick()
        -- скилл 4: +1 stud дальше вперёд; всегда чуть правее
        local frontDist = (n == 4) and 3.5 or 2.5
        local rightBias = 0.85

        -- 1) МГНОВЕННЫЙ телепорт вперёд (не медленный полёт)
        root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if root and tRoot and tRoot.Parent then
            local look = tRoot.CFrame.LookVector
            local right = tRoot.CFrame.RightVector
            local desired = tRoot.Position + look * frontDist + right * rightBias + Vector3.new(0, 0.45, 0)
            local lookFwd = tRoot.Position + look * 14 + Vector3.new(0, 1.0, 0)
            root.CFrame = CFrame.lookAt(desired, lookFwd)
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
        end

        -- 2) сразу скилл
        local keys = {
            [1] = Enum.KeyCode.One,
            [2] = Enum.KeyCode.Two,
            [3] = Enum.KeyCode.Three,
            [4] = Enum.KeyCode.Four,
        }
        local kc = keys[n]
        pcall(function()
            if VirtualInputManager and kc then
                VirtualInputManager:SendKeyEvent(true, kc, false, game)
                task.defer(function()
                    pcall(function() VirtualInputManager:SendKeyEvent(false, kc, false, game) end)
                end)
            end
        end)
        playStandAnim("skill", n)

        -- 3) остаёмся ВПЕРЕДИ ровно 1.5с с момента вылета (RenderStepped тоже держит фронт)
        frontStart = tick()
        standSkillFrontUntil = frontStart + frontHold
        while tick() < frontStart + frontHold and UnloadSystem.Active do
            task.wait(0.05)
        end
        standSkillBusy = false
        standSkillFrontUntil = tick() + 0.05
    end)
end

local function onMaybeSkillMsg(player, msg)
    if not Settings.TargetSkillChat then return end
    if not player or player == LocalPlayer then return end
    local name = Settings.FarmTargetName ~= "" and Settings.FarmTargetName or Settings.TrollingTarget
    if not name or name == "" then name = next(SelectedFlingTargets) end
    if not name then return end
    if player.Name ~= name and player.DisplayName ~= name then return end
    local m = tostring(msg or ""):match("^%s*(%d)%s*$")
    if m then doTargetSkill(tonumber(m)) end
end

-- Команды: show / hide / appear / disappear + русские
local function onStandChatCommand(player, msg)
    if not player or player ~= LocalPlayer then return end
    local t = string.lower(tostring(msg or ""):gsub("^%s+", ""):gsub("%s+$", ""))
    -- show / appear / появись / покажись
    if t == "show" or t == "appear" or t == "появись" or t == "покажись" or t == "появиться" then
        setStandBodyVisible(true)
        return
    end
    -- hide / disappear / спрячься / скрыться
    if t == "hide" or t == "disappear" or t == "спрячься" or t == "скрыться" or t == "спрятаться" then
        setStandBodyVisible(false)
        return
    end
end

UnloadSystem:TrackConnection(Players.PlayerAdded:Connect(function(plr)
    UnloadSystem:TrackConnection(plr.Chatted:Connect(function(msg)
        onMaybeSkillMsg(plr, msg)
    end))
end))
for _, plr in ipairs(Players:GetPlayers()) do
    if plr ~= LocalPlayer then
        UnloadSystem:TrackConnection(plr.Chatted:Connect(function(msg)
            onMaybeSkillMsg(plr, msg)
        end))
    end
end
-- свои сообщения → show/hide
UnloadSystem:TrackConnection(LocalPlayer.Chatted:Connect(function(msg)
    onStandChatCommand(LocalPlayer, msg)
end))
pcall(function()
    if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
        UnloadSystem:TrackConnection(TextChatService.MessageReceived:Connect(function(msg)
            local src = msg.TextSource
            if not src then return end
            local plr = Players:GetPlayerByUserId(src.UserId)
            onMaybeSkillMsg(plr, msg.Text)
            onStandChatCommand(plr, msg.Text)
        end))
    end
end)



