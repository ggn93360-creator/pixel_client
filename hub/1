			local S = env.S
			local segLen = S.len * s / S.segs
			env.st.segLen, env.st.welds = segLen, {}
			local prev = root
			for k = 1, S.segs do
				local f = (k - 1) / math.max(S.segs - 1, 1)
				local p = pt(model, S, Vector3.new(S.wid * s * (1 + 0.25 * f), segLen * 1.1, 0.06), S.color:Lerp(S.color2, f))
				env.st.welds[k] = weld(prev, p, CFrame.new())
