local function PushMessage(title, text, duration)
    duration = duration or 3
    local key = tostring(title) .. "|" .. tostring(text)
    local now = tick()
    -- антиспам одинаковых сообщений
    if lastMsgSpam[key] and (now - lastMsgSpam[key]) < 3.5 then
        return
    end
    lastMsgSpam[key] = now

    table.insert(messageLog, 1, {
        title = title,
        text = text,
        expires = now + duration
    })
    if #messageLog > 10 then table.remove(messageLog) end

    if Settings.MessageHUD ~= false then
        ShowSideToast(title, text, duration)
    end
end

