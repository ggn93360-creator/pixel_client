        task.wait(0.15)
        standM1Busy = false
        standSkillFrontUntil = tick() + 0.05
    end)
end

local function standProtectTick(dt)
    if not Settings.StandEnabled then
        if blockHeld then setBlockHeld(false) end
        return
    end
    local plr, char, tRoot, hum = getProtectTarget()
    if not tRoot then
        if blockHeld then setBlockHeld(false) end
        return
    end

    local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not myRoot then return end

    -- жёстко: никогда не пишем в tRoot / тело таргета
    if Settings.StandNoMoveTarget ~= false then
        -- no-op guard (все move только myRoot ниже)
    end

    local look = tRoot.CFrame.LookVector
    local right = tRoot.CFrame.RightVector
    -- чуть правее при блоке/скилле
    local closeFront = tRoot.Position + look * 2.25 + right * 0.85 + Vector3.new(0, 0.45, 0)
    local skillFront = tRoot.Position + look * 2.6 + right * 0.85 + Vector3.new(0, 0.5, 0)
    local forwardLook = tRoot.Position + look * 12 + Vector3.new(0, 1.0, 0)

    -- M1 counter: таргет ударил → мы влетели ударили отлетели
    if Settings.StandM1Counter and not standSkillBusy and not standM1Busy then
        if isPlayerM1(char, hum, plr) and (tick() - lastTargetM1Detect) > 0.25 then
            lastTargetM1Detect = tick()
            if PushMessage then
                PushMessage("Stand M1", "вижу удар → counter", 0.8)
            end
            standDoM1Counter(tRoot, char)
        end
    end

    if standM1Busy or standSkillBusy or tick() < standSkillFrontUntil then
        standMoveSelfOnly(myRoot, skillFront, forwardLook, (dt or 0.016) * 2.5)
        return
    end

    local blocking = isPlayerBlocking(char, hum)
    if blocking then
        standMoveSelfOnly(myRoot, closeFront, forwardLook, (dt or 0.016) * 1.8)
        setBlockHeld(true)
        protectBlocking = true
        lastProtect = tick()
    else
        if protectBlocking or blockHeld then
            setBlockHeld(false)
        end
        protectBlocking = false
        local slot = getStandShoulderSlot(tRoot)
        standMoveSelfOnly(myRoot, slot, forwardLook, dt)
    end
end

