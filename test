            w.Part1 = p
            w.Parent = p
        end
        brim:FindFirstChildOfClass("Weld").C0 = CFrame.new(0, 0.75, 0)
        cone:FindFirstChildOfClass("Weld").C0 = CFrame.new(0, 1.25, 0)
