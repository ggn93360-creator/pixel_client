            local on = isOnMobileBar()
            bindBtn.Text = on and "📱✓" or "📱"
            bindBtn.TextColor3 = on and COLOR_TITLE or COLOR_TEXT_MUTED
            bindBtn.BackgroundColor3 = on and COLOR_TAB_ACTIVE or COLOR_SIDEBAR
        else
            local currentBind = Settings.Binds and Settings.Binds[settingKey]
            bindBtn.Text = currentBind and currentBind.Name or "Bind"
            bindBtn.TextColor3 = COLOR_TEXT_MUTED
            bindBtn.BackgroundColor3 = COLOR_SIDEBAR
        end
