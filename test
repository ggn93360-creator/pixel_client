Settings.AnimLoop = true
Settings.AnimSpeed = 1
Settings.AnimPreview = true

local currentAnimTrack = nil

local function getRigType(char)
    if not char then return "Unknown" end
    if char:FindFirstChild("Torso") and not char:FindFirstChild("UpperTorso") then
        return "R6"
    end
    if char:FindFirstChild("UpperTorso") then
        return "R15"
    end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum then
        local ok, rt = pcall(function() return hum.RigType end)
        if ok and rt == Enum.HumanoidRigType.R6 then return "R6" end
        if ok and rt == Enum.HumanoidRigType.R15 then return "R15" end
    end
    return "Unknown"
end

local function stopCurrentAnim()
    if currentAnimTrack then
        pcall(function() currentAnimTrack:Stop(0.1) end)
        pcall(function() currentAnimTrack:Destroy() end)
        currentAnimTrack = nil
    end
    -- stop competing action tracks on R6
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if hum then
        pcall(function()
            for _, tr in ipairs(hum:GetPlayingAnimationTracks()) do
                local pri = tr.Priority
                if pri == Enum.AnimationPriority.Action
                    or pri == Enum.AnimationPriority.Action2
                    or pri == Enum.AnimationPriority.Action3
                    or pri == Enum.AnimationPriority.Action4 then
                    pcall(function() tr:Stop(0.1) end)
                end
            end
        end)
        local animator = hum:FindFirstChildOfClass("Animator")
        if animator then
            pcall(function()
                for _, tr in ipairs(animator:GetPlayingAnimationTracks()) do
                    local pri = tr.Priority
                    if pri == Enum.AnimationPriority.Action
                        or pri == Enum.AnimationPriority.Action2
                        or pri == Enum.AnimationPriority.Action3
                        or pri == Enum.AnimationPriority.Action4 then
                        pcall(function() tr:Stop(0.1) end)
                    end
                end
            end)
        end
    end
end

local function playAnimById(animId, name, opts)
    opts = opts or {}
    local silent = opts.silent == true
    local forceLoop = opts.loop
    local char = LocalPlayer.Character
    if not char then
        if not silent and PushMessage then PushMessage("Anim", "Нет персонажа", 2) end
        return
    end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end

    local rig = getRigType(char)
    stopCurrentAnim()

    local id = tonumber(tostring(animId):match("%d+")) or 0
    if id <= 0 then
        if not silent and PushMessage then PushMessage("Anim", "Неверный ID", 2) end
        return
    end

    local anim = Instance.new("Animation")
    anim.AnimationId = "rbxassetid://" .. tostring(id)

    local track = nil
    local ok1, tr1 = pcall(function()
        return hum:LoadAnimation(anim)
    end)
    if ok1 and tr1 then
        track = tr1
    else
        local animator = hum:FindFirstChildOfClass("Animator")
        if not animator then
            animator = Instance.new("Animator")
            animator.Parent = hum
        end
        local ok2, tr2 = pcall(function()
            return animator:LoadAnimation(anim)
        end)
        if ok2 and tr2 then track = tr2 end
    end

    if not track then
        if not silent and PushMessage then
            PushMessage("Anim", "Fail " .. tostring(name or id) .. " [" .. rig .. "]", 2)
        end
        return
    end

    if forceLoop ~= nil then
        track.Looped = forceLoop and true or false
    else
        track.Looped = Settings.AnimLoop and true or false
    end
    pcall(function() track.Priority = Enum.AnimationPriority.Action4 end)
    pcall(function() track:AdjustSpeed(Settings.AnimSpeed or 1) end)
    pcall(function() track:Play(0.12) end)
    currentAnimTrack = track

    if not silent and PushMessage then
        PushMessage("Anim", string.format("%s · %s%s", tostring(name or id), rig, track.Looped and " loop" or ""), 2)
    end
    pcall(function()
        track.Stopped:Connect(function()
            if currentAnimTrack == track then currentAnimTrack = nil end
        end)
    end)
end

