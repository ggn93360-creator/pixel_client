local function LoadConfig()
    if not readfile or not isfile or not isfile(CONFIG_FILE) then return end
    local success, result = pcall(function()
        return HttpService:JSONDecode(readfile(CONFIG_FILE))
    end)
    if success and type(result) == "table" then
        if result.Settings then
            for k, v in pairs(result.Settings) do
                if Settings[k] ~= nil and k ~= "Killstreak" and k ~= "Binds" then
                    Settings[k] = v
                end
            end
        end

        -- Сначала сбрасываем все бинды, потом ставим только сохранённые
        if result.Binds then
            for _, k in ipairs(ALL_BIND_KEYS) do
                Settings.Binds[k] = nil
            end
            for k, keyName in pairs(result.Binds) do
                if keyName and keyName ~= "None" and Enum.KeyCode[keyName] then
                    Settings.Binds[k] = Enum.KeyCode[keyName]
                end
            end
        end

        if result.CustomMusicList then musicList = result.CustomMusicList end
        if result.CustomKillSoundList then killSoundList = result.CustomKillSoundList end
        
        currentVolume = Settings.MusicVolume or 0.5
        killSoundVolume = Settings.KillSoundVolume or 0.8
        isLooped = Settings.MusicLooped or false
        currentPlayingIndex = Settings.LastTrackIndex or 0
        currentKillSoundIndex = Settings.LastKillSoundIndex or 1
        
        backgroundSound.Volume = currentVolume
        backgroundSound.Looped = isLooped
        for _, s in ipairs(killSoundPool) do s.Volume = killSoundVolume end
    end
end

