local function UpdateMusicHUD()
    if currentPlayingIndex > 0 and musicList[currentPlayingIndex] then
        MusicTitle.Text = "Music: " .. musicList[currentPlayingIndex].name
    else
        MusicTitle.Text = "Music: Stopped"
    end
end

local function PlayMusic(index, forceChange)
    if musicList[index] then
        if currentPlayingIndex == index and not forceChange then
            if backgroundSound.IsPlaying then
                backgroundSound:Pause()
            else
                if backgroundSound.IsPaused then
                    backgroundSound:Resume()
                else
                    backgroundSound:Play()
                end
            end
        else
            currentPlayingIndex = index
            backgroundSound:Stop()
            local id = musicList[index].id
            if not string.find(tostring(id), "rbxassetid://") then
                id = "rbxassetid://" .. tostring(id)
            end
            backgroundSound.SoundId = id
            backgroundSound.Volume = currentVolume
            backgroundSound.Looped = isLooped
            -- Ждём загрузки звука
            task.spawn(function()
                local t0 = tick()
                while not backgroundSound.IsLoaded and tick() - t0 < 5 do
                    task.wait(0.1)
                end
                if currentPlayingIndex == index then
                    backgroundSound:Play()
                end
            end)
        end
        SaveConfig()
        UpdateMusicHUD()
    end
end

