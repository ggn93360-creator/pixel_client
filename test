local function onlineDeviceOf(user)
    if type(user) ~= "table" then return "?" end
    if type(user.device) == "string" and user.device ~= "" then return user.device end
    if type(user.features) == "table" then
        for _, f in ipairs(user.features) do
            local s = string.lower(tostring(f))
            if s == "pc" then return "PC" end
            if s == "mobile" or s == "phone" or s == "android" or s == "ios" then return "Mobile" end
        end
    end
    return "?"
end

local function onlineExecOf(user)
    if type(user) ~= "table" then return nil end
    if type(user.executor) == "string" and user.executor ~= "" then return user.executor end
    if type(user.features) == "table" then
        for _, f in ipairs(user.features) do
            local s = tostring(f)
            local sl = string.lower(s)
            if sl ~= "pc" and sl ~= "mobile" and sl ~= "phone" and sl ~= "android" and sl ~= "ios"
                and sl ~= "pixelclient" and sl ~= "pixels_online" then
                return s
            end
        end
    end
    return nil
end

local function onlineHttp(method, url, jsonBody)
    local headers = { ["Content-Type"] = "application/json" }
    method = string.upper(method or "GET")

    local function bodyOf(res)
        if type(res) == "string" and #res > 0 then return res end
        if type(res) == "table" then
            local b = res.Body or res.body or res.Data or res.data
            if type(b) == "string" and #b > 0 then return b end
        end
        return nil
    end

    local tries = {}
    if syn and type(syn.request) == "function" then
        table.insert(tries, function()
            return syn.request({ Url = url, Method = method, Headers = headers, Body = jsonBody })
        end)
    end
    if type(request) == "function" then
        table.insert(tries, function()
            return request({ Url = url, Method = method, Headers = headers, Body = jsonBody })
        end)
    end
    if http and type(http.request) == "function" then
        table.insert(tries, function()
            return http.request({ Url = url, Method = method, Headers = headers, Body = jsonBody })
        end)
    end
    if type(http_request) == "function" then
        table.insert(tries, function()
            return http_request({ Url = url, Method = method, Headers = headers, Body = jsonBody })
        end)
    end
    table.insert(tries, function()
        if method == "GET" then
            return HttpService:GetAsync(url)
        end
        return HttpService:PostAsync(url, jsonBody or "{}", Enum.HttpContentType.ApplicationJson)
    end)
    if method == "GET" and type(game.HttpGet) == "function" then
        table.insert(tries, function() return game:HttpGet(url) end)
    end

    for _, fn in ipairs(tries) do
        local ok, res = pcall(fn)
        if ok then
            local body = bodyOf(res)
            if body then
                local ok2, decoded = pcall(function() return HttpService:JSONDecode(body) end)
                if ok2 and type(decoded) == "table" then
                    return decoded
                end
            end
        end
    end
    return nil
end

