-- Загрузка картинки по URL для ImageLabel (executor: HttpGet + getcustomasset)
local wallpaperCache = {} -- url -> asset id
local function httpGetBinary(url)
    local body = nil
    local ok, res = pcall(function()
        if syn and syn.request then
            local r = syn.request({ Url = url, Method = "GET" })
            return r and (r.Body or r.body)
        end
        if type(request) == "function" then
            local r = request({ Url = url, Method = "GET" })
            return r and (r.Body or r.body)
        end
        if type(http_request) == "function" then
            local r = http_request({ Url = url, Method = "GET" })
            return r and (r.Body or r.body)
        end
        return game:HttpGet(url)
    end)
    if ok and type(res) == "string" and #res > 100 then
        return res
    end
    return nil
end

local function resolveImageForGui(url)
    url = tostring(url or ""):gsub("^%s+", ""):gsub("%s+$", "")
    if url == "" then return "" end
    -- уже asset
    if string.find(url, "rbxasset", 1, true) or string.find(url, "rbxthumb", 1, true) then
        return url
    end
    if wallpaperCache[url] then
        return wallpaperCache[url]
    end
    -- http(s) → скачать в файл → getcustomasset
    if string.sub(url, 1, 4) == "http" then
        if not (writefile and getcustomasset) then
            warn("[PixelClient] Wallpaper: нужен writefile + getcustomasset")
            return ""
        end
        local ext = ".png"
        local lower = string.lower(url)
        if string.find(lower, ".jpg", 1, true) or string.find(lower, ".jpeg", 1, true) then
            ext = ".jpg"
        elseif string.find(lower, ".webp", 1, true) then
            ext = ".webp"
        end
        local fileName = "pixel_wallpaper" .. ext
        local data = httpGetBinary(url)
        if not data then
            warn("[PixelClient] Wallpaper: не скачалось " .. url)
            return ""
        end
        local wok = pcall(function() writefile(fileName, data) end)
        if not wok then
            warn("[PixelClient] Wallpaper: writefile fail")
            return ""
        end
        local aok, asset = pcall(function() return getcustomasset(fileName) end)
        if aok and type(asset) == "string" and asset ~= "" then
            wallpaperCache[url] = asset
            return asset
        end
        warn("[PixelClient] Wallpaper: getcustomasset fail")
        return ""
    end
    return url
end

