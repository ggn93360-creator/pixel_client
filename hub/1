	addItem("Wings", {attach = "Torso", base = function() return CFrame.new() end, color = rgb(255, 255, 255), color2 = rgb(170, 200, 255),
		defaults = {style = "Angel", speed = 3, amount = 14, open = 24, flex = 14, react = true},
		build = function(root, model, s, env)
			local S = env.S
			local d = WingStyles[S.style] or WingStyles.Angel
			local z = env.part.Size.Z / 2 + 0.1
			env.st.wings = {}
			for _, side in ipairs({1, -1}) do
				local sh = pt(model, S, Vector3.new(0.2, 0.2, 0.2), WHITE, nil, 1)
				local flip = side == -1 and CFrame.Angles(0, math.pi, 0) or CFrame.new()
				local shW = weld(root, sh, CFrame.new(side * 0.45, 0.35, z) * flip)
				local W = {shW = shW, trans = CFrame.new(side * 0.45, 0.35, z), flip = flip, bones = {}}
				env.st.wings[side] = W
				local prev, prevLen = sh, 0
				for bi, b in ipairs(d.bones) do
					local len = b[1] * s
					local bp = pt(model, S, Vector3.new(len, b[2] * s, b[2] * s), S.color:Lerp(S.color2, (bi - 1) * 0.2), "cyl")
					local bw = weld(prev, bp, CFrame.new(prevLen / 2, 0, 0) * CFrame.Angles(0, 0, math.rad(b[3])) * CFrame.new(len / 2, 0, 0))
					W.bones[bi] = {w = bw, prevHalf = prevLen / 2, len = len, rest = b[3], k = b[4], ph = b[5]}
					-- сустав: шарик на конце кости (гладкий стык)
					weld(bp, pt(model, S, Vector3.new(b[2] * s * 1.2, b[2] * s * 1.2, b[2] * s * 1.2), S.color:Lerp(S.color2, (bi - 1) * 0.2), "ball"), CFrame.new(len / 2, 0, 0))
					for _, f in ipairs(d.feathers[bi] or {}) do
						local fl = f.len * s
						local thk = (f.thk or (f.shape == "cyl" and f.wid or 0.05)) * s
						local fp = pt(model, S, Vector3.new(fl, f.wid * s, thk), S.color:Lerp(S.color2, math.clamp(f.ct, 0, 1)), f.shape,
							f.alpha and math.max(S.alpha, f.alpha) or S.alpha)
						weld(bp, fp, CFrame.new(-len / 2 + f.t * len + (f.ox or 0) * s, (f.oy or 0) * s, f.z * s)
							* CFrame.Angles(0, 0, math.rad(f.ang)) * CFrame.Angles(math.rad(f.roll or 0), 0, 0) * CFrame.new(fl / 2, 0, 0))
					end
					prev, prevLen = bp, len
