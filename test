--[[
	Pixels Client — кто сейчас играет с таким же скриптом
	API: https://mjuchl2kvk.apps.bot-hosting.cloud/api.php

	Без GUI — только Output.
	Шлёт и показывает устройство (PC / Mobile) + executor + игру.
]]

local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local MarketplaceService = game:GetService("MarketplaceService")

local API_URL = "https://mjuchl2kvk.apps.bot-hosting.cloud/api.php"
local REFRESH_SEC = 10

local function detectExecutor()
	local name = nil
	pcall(function()
		if identifyexecutor then
			name = identifyexecutor()
		elseif getexecutorname then
			name = getexecutorname()
		end
	end)
	if type(name) == "string" and #name > 0 then
		return name
	end
	if syn then return "Synapse" end
	if fluxus then return "Fluxus" end
	if KRNL_LOADED or krnl then return "Krnl" end
	if getgenv and getgenv().Arceus then return "Arceus X" end
	if getgenv and (getgenv().Codex or getgenv().CODEX) then return "Codex" end
	if getgenv and getgenv().Hydrogen then return "Hydrogen" end
	if getgenv and getgenv().Delta then return "Delta" end
	if getgenv and getgenv().Solara then return "Solara" end
	if getgenv and getgenv().Wave then return "Wave" end
	return "Unknown"
end

local function detectDevice()
	local exec = detectExecutor()
	local execLower = string.lower(tostring(exec))
	local mobileKw = {
		"arceus", "codex", "hydrogen", "delta", "trigon", "fluxus android",
		"krnl ios", "ios", "android", "mobile", "evon", "codex mobile"
	}
	local isMobileExec = false
	for _, kw in ipairs(mobileKw) do
		if string.find(execLower, kw, 1, true) then
			isMobileExec = true
			break
		end
	end
	local touch, keyboard, gyro = false, false, false
	pcall(function() touch = UserInputService.TouchEnabled end)
	pcall(function() keyboard = UserInputService.KeyboardEnabled end)
	pcall(function() gyro = UserInputService.GyroscopeEnabled end)
	local small = false
	pcall(function()
		local cam = workspace.CurrentCamera
		if cam and cam.ViewportSize.X > 0 and cam.ViewportSize.X < 900 then
			small = true
		end
	end)
	local isMobile = isMobileExec or (touch and (not keyboard or gyro or small))
	return isMobile and "Mobile" or "PC", exec
end

local DEVICE, EXECUTOR = detectDevice()

local cachedGameName = nil
local function getCurrentGameName()
	if cachedGameName then return cachedGameName end
	local placeId = game.PlaceId
	local name = nil
	local ok, info = pcall(function()
		return MarketplaceService:GetProductInfo(placeId)
	end)
	if ok and type(info) == "table" and info.Name then
		name = tostring(info.Name)
	end
	if not name or name == "" then
		name = "Place " .. tostring(placeId)
	end
	if #name > 48 then
		name = string.sub(name, 1, 45) .. "..."
	end
	cachedGameName = name
	return cachedGameName
end

local httpBackend = nil

local function tryDecode(raw)
	if type(raw) ~= "string" or raw == "" then return nil end
	local ok, data = pcall(function()
		return HttpService:JSONDecode(raw)
	end)
	return ok and data or nil
end

local function detectBackend()
	if syn and type(syn.request) == "function" then httpBackend = "syn" return end
	if http and type(http.request) == "function" then httpBackend = "http" return end
	if type(request) == "function" then httpBackend = "request" return end
	if fluxus and type(fluxus.request) == "function" then httpBackend = "fluxus" return end
	local ok = pcall(function()
		HttpService:GetAsync(API_URL .. "?action=list")
	end)
	if ok then httpBackend = "httpservice" return end
	if type(game.HttpGet) == "function" then
		local ok2 = pcall(function() return game:HttpGet(API_URL .. "?action=list") end)
		if ok2 then httpBackend = "httpget" return end
	end
	httpBackend = nil
end

local function rawRequest(method, url, body)
	method = string.upper(method or "GET")
	local headers = { ["Content-Type"] = "application/json" }
	if httpBackend == "syn" then
		local res = syn.request({ Url = url, Method = method, Headers = headers, Body = body })
		return res and res.Body
	elseif httpBackend == "http" then
		local res = http.request({ Url = url, Method = method, Headers = headers, Body = body })
		return res and res.Body
	elseif httpBackend == "request" then
		local res = request({ Url = url, Method = method, Headers = headers, Body = body })
		return res and res.Body
	elseif httpBackend == "fluxus" then
		local res = fluxus.request({ Url = url, Method = method, Headers = headers, Body = body })
		return res and res.Body
	elseif httpBackend == "httpservice" then
		if method == "GET" then return HttpService:GetAsync(url) end
		return HttpService:PostAsync(url, body or "{}", Enum.HttpContentType.ApplicationJson)
	elseif httpBackend == "httpget" then
		if method == "GET" then return game:HttpGet(url) end
		if type(game.HttpPost) == "function" then
			return game:HttpPost(url, body or "{}", "application/json")
		end
	end
	return nil
end

local function request(method, action, body)
	local url = API_URL .. "?action=" .. action
	local payload = nil
	if body then
		local ok, encoded = pcall(function() return HttpService:JSONEncode(body) end)
		payload = ok and encoded or nil
	end
	local ok, result = pcall(function() return rawRequest(method, url, payload) end)
	if not ok or not result then
		warn("[PixelsOnline] HTTP error:", result)
		return nil
	end
	return tryDecode(result)
end

local function fetchList() return request("GET", "list") end
local function fetchStats() return request("GET", "stats") end

local function sendHeartbeat(userid, username, displayname, features)
	return request("POST", "heartbeat", {
		userid = tostring(userid),
		username = username,
		displayname = displayname or username,
		game = getCurrentGameName(),
		device = DEVICE,
		executor = EXECUTOR,
		features = features or { DEVICE, EXECUTOR, "pixels_online" },
	})
end

local function ago(ts)
	if not ts or ts == 0 then return "?" end
	if ts > 10000000000 then ts = math.floor(ts / 1000) end
	local diff = math.max(0, os.time() - ts)
	if diff < 60 then return diff .. " с назад"
	elseif diff < 3600 then return math.floor(diff / 60) .. " мин назад"
	elseif diff < 86400 then return math.floor(diff / 3600) .. " ч назад"
	else return math.floor(diff / 86400) .. " дн назад" end
end

local function deviceOf(u)
	if type(u.device) == "string" and u.device ~= "" then return u.device end
	if type(u.features) == "table" then
		for _, f in ipairs(u.features) do
			local s = string.lower(tostring(f))
			if s == "pc" then return "PC" end
			if s == "mobile" or s == "phone" or s == "android" or s == "ios" then return "Mobile" end
		end
	end
	return "?"
end

local function execOf(u)
	if type(u.executor) == "string" and u.executor ~= "" then return u.executor end
	if type(u.features) == "table" then
		for _, f in ipairs(u.features) do
			local s = tostring(f)
			local sl = string.lower(s)
			if sl ~= "pc" and sl ~= "mobile" and sl ~= "phone" and sl ~= "android" and sl ~= "ios"
				and sl ~= "pixels_online" and sl ~= "pixelclient" then
				return s
			end
		end
	end
	return "—"
end

local function printPlayers(data, stats)
	local users = (data and data.users) or {}
	local count = (data and data.count) or #users
	print("============================================================")
	print("  PIXELS — кто онлайн   |  ты: " .. DEVICE .. " / " .. EXECUTOR)
	print("============================================================")
	if stats and stats.stats then
		local s = stats.stats
		print(string.format("  Всего: %s  |  Онлайн: %s  |  Hits: %s",
			tostring(s.total or "?"), tostring(s.onlineNow or s.online or count), tostring(s.totalHits or "?")))
	else
		print("  Онлайн сейчас: " .. tostring(count))
	end
	print("------------------------------------------------------------")
	if #users == 0 then
		print("  Никого нет в сети.")
		print("------------------------------------------------------------")
		return
	end
	print(string.format("  %-3s %-16s %-10s %-8s %-12s %-18s %s", "#", "Ник", "UserId", "Device", "Executor", "Игра", "Был"))
	print("------------------------------------------------------------")
	for i, u in ipairs(users) do
		local name = u.displayname or u.username or "?"
		if #name > 15 then name = string.sub(name, 1, 14) .. "…" end
		local uid = tostring(u.userid or "")
		if #uid > 10 then uid = string.sub(uid, 1, 9) .. "…" end
		local dev = deviceOf(u)
		local ex = execOf(u)
		if #ex > 11 then ex = string.sub(ex, 1, 10) .. "…" end
		local gameName = tostring(u.game or "—")
		if #gameName > 17 then gameName = string.sub(gameName, 1, 16) .. "…" end
		local last = ago(tonumber(u.lastSeen) or 0)
		local mark = (u.online ~= false) and "●" or "○"
		print(string.format("  %s %-2d %-16s %-10s %-8s %-12s %-18s %s", mark, i, name, uid, dev, ex, gameName, last))
	end
	print("------------------------------------------------------------")
	print("  Всего: " .. tostring(count))
end

local function heartbeatSelf()
	local lp = Players.LocalPlayer
	if not lp then return end
	sendHeartbeat(tostring(lp.UserId), lp.Name, lp.DisplayName, { DEVICE, EXECUTOR, "pixels_online" })
end

local function tick()
	heartbeatSelf()
	local data = fetchList()
	if not data then return end
	printPlayers(data, fetchStats())
end

task.spawn(function()
	detectBackend()
	if not httpBackend then
		warn("[PixelsOnline] Нет рабочего HTTP (syn/request/HttpService).")
		return
	end
	print("[PixelsOnline] backend:", httpBackend, "| device:", DEVICE, "| exec:", EXECUTOR)
	while true do
		local ok, err = pcall(tick)
		if not ok then warn("[PixelsOnline]", err) end
		task.wait(REFRESH_SEC)
	end
end)

print("[PixelsOnline] запущен. GUI нет. Device=" .. DEVICE)
