        WatermarkText.Text = string.format("Pixel Client | %s | FPS: %d | Time: %s", gameName, currentFps, realTime)
        Watermark.Size = UDim2.new(0, WatermarkText.TextBounds.X + 24, 0, 26)
    end

    SkillHUDFrame.Visible = false
    KillstreakHUDFrame.Visible = false
    KsValueLabel.Text = tostring(Settings.Killstreak)
    MusicHUDFrame.Visible = Settings.MusicHUD

    if backgroundSound.IsPlaying or backgroundSound.TimePosition > 0 then
        local pos, len = backgroundSound.TimePosition, backgroundSound.TimeLength
        if len > 0 then ProgressBarFill.Size = UDim2.new(math.clamp(pos / len, 0, 1), 0, 1, 0)
        else ProgressBarFill.Size = UDim2.new(0, 0, 1, 0) end
    else
        ProgressBarFill.Size = UDim2.new(0, 0, 1, 0)
    end

    local localChar = LocalPlayer.Character
    if not localChar then return end
    local rootLocal = localChar:FindFirstChild("HumanoidRootPart")
    local humLocal = localChar:FindFirstChildOfClass("Humanoid")
    if not rootLocal then return end

    -- Backtrack: пишем историю позиций всех
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            pcall(btRecordPlayer, plr)
        end
    end
    -- Fake Lag на себе
    pcall(updateBacktrackVisuals)
    pcall(fakeLagTick, rootLocal)

    -- корень для fly/speed/strafe/farm (клон при десинке)
    local moveRoot, isDesyncMove = getMoveRoot()
    if not moveRoot then moveRoot = rootLocal end

    -- ========== ANTI-RAGDOLL ==========
    if Settings.AntiRagdoll and humLocal and localChar and not FlingActive then
        pcall(function()
            humLocal.PlatformStand = false
            humLocal.Sit = false
            local st = humLocal:GetState()
            if st == Enum.HumanoidStateType.Physics
                or st == Enum.HumanoidStateType.Ragdoll
                or st == Enum.HumanoidStateType.FallingDown
                or st == Enum.HumanoidStateType.PlatformStanding then
                humLocal:ChangeState(Enum.HumanoidStateType.GettingUp)
            end
            for _, m in ipairs(localChar:GetDescendants()) do
                if m:IsA("Motor6D") and m.Enabled == false then
                    m.Enabled = true
                end
            end
            for _, c in ipairs(localChar:GetDescendants()) do
                if c:IsA("BallSocketConstraint") then
                    c:Destroy()
                end
            end
        end)
    end

    -- ========== HARD ANTI-FLING ==========
    if false and Settings.AntiFling and rootLocal and not Settings.FlingEnabled and not FlingActive then -- old AF off; KILASIK Stepped used
        local lin = rootLocal.AssemblyLinearVelocity
        local ang = rootLocal.AssemblyAngularVelocity
        local pos = rootLocal.Position

        if lin.Magnitude < 80 and ang.Magnitude < 40 and pos.Y > -20 and pos.Y < 400 then
            if tick() - antiFlingLastSafe > 0.25 then
                antiFlingSafeCF = rootLocal.CFrame
                antiFlingLastSafe = tick()
            end
        end

        for _, inst in ipairs(rootLocal:GetChildren()) do
            if inst:IsA("BodyVelocity") or inst:IsA("BodyAngularVelocity") or inst:IsA("BodyForce")
                or inst:IsA("BodyThrust") or inst:IsA("VectorForce") or inst:IsA("AngularVelocity")
                or inst:IsA("LinearVelocity") or inst:IsA("Torque") then
                if inst.Name ~= "PixelClientBV" then
                    pcall(function() inst:Destroy() end)
                end
            end
        end

        local flung = lin.Magnitude > 90 or ang.Magnitude > 40 or math.abs(lin.Y) > 120
        local voided = pos.Y < -30 or pos.Y > 450

        if flung or voided then
            rootLocal.AssemblyLinearVelocity = Vector3.zero
            rootLocal.AssemblyAngularVelocity = Vector3.zero
            pcall(function()
                rootLocal.Velocity = Vector3.zero
                rootLocal.AssemblyAngularVelocity = Vector3.zero
            end)
            for _, part in ipairs(localChar:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.AssemblyLinearVelocity = Vector3.zero
                    part.AssemblyAngularVelocity = Vector3.zero
                end
            end
            if humLocal then
                pcall(function()
                    humLocal.PlatformStand = false
                    humLocal.Sit = false
                    humLocal:ChangeState(Enum.HumanoidStateType.GettingUp)
                end)
            end
            if antiFlingSafeCF then
                local dist = (pos - antiFlingSafeCF.Position).Magnitude
                if dist > 25 or voided then
                    rootLocal.CFrame = antiFlingSafeCF
                    rootLocal.AssemblyLinearVelocity = Vector3.zero
                    rootLocal.AssemblyAngularVelocity = Vector3.zero
                end
            elseif voided then
                rootLocal.CFrame = CFrame.new(pos.X, math.clamp(pos.Y, 5, 80), pos.Z)
            end
        end

        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character then
                local er = player.Character:FindFirstChild("HumanoidRootPart")
                if er then
                    local d = (er.Position - pos).Magnitude
                    local ev = er.AssemblyLinearVelocity.Magnitude
                    local ea = er.AssemblyAngularVelocity.Magnitude
                    if d < 18 and (ev > 100 or ea > 40) then
                        for _, part in ipairs(player.Character:GetDescendants()) do
                            if part:IsA("BasePart") then
                                part.CanCollide = false
                            end
                        end
                        rootLocal.AssemblyLinearVelocity = Vector3.zero
                        rootLocal.AssemblyAngularVelocity = Vector3.zero
                    end
                end
            end
        end
    end

    -- Message HUD = side toasts (PushMessage → ShowSideToast), старый список скрыт
    MessageHUDFrame.Visible = false
    for i = #messageLog, 1, -1 do
        if tick() > messageLog[i].expires then
            table.remove(messageLog, i)
        end
    end

    -- Mobile fly pad visibility
    FlyPad.Visible = Settings.FlyEnabled
    if DesyncPad then
        DesyncPad.Visible = Settings.Desync and UserInputService.TouchEnabled and not Settings.FlyEnabled
    end

    if Settings.CheaterDetector then
        local now = tick()
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character then
                local char = player.Character
                local root = char:FindFirstChild("HumanoidRootPart")
                local humanoid = char:FindFirstChildOfClass("Humanoid")

                if root and humanoid and humanoid.Health > 0 then
                    local linVel = root.AssemblyLinearVelocity
                    local angVel = root.AssemblyAngularVelocity
                    local horizSpeed = Vector3.new(linVel.X, 0, linVel.Z).Magnitude
                    local pos = root.Position

                    local track = detectorTrack[player]
                    if not track then
                        track = { lastPos = pos, lastTime = now, samples = {}, speedHits = 0, flyHits = 0 }
                        detectorTrack[player] = track
                    end

                    local dt = math.max(now - track.lastTime, 0.001)
                    local moved = (pos - track.lastPos).Magnitude
                    local instSpeed = moved / dt
                    track.lastPos = pos
                    track.lastTime = now

                    table.insert(track.samples, { p = pos, t = now })
                    while #track.samples > 16 do table.remove(track.samples, 1) end

                    -- жёсткие пороги — меньше ложных
                    local isSpinningFast = angVel.Magnitude > 90
                    local isMovingTooFast = linVel.Magnitude > 220 or instSpeed > 250
                    local isSpazzingVertical = math.abs(linVel.Y) > 180
                    local isTeleport = moved > 120 and dt < 0.15

                    -- soft speed: нужно несколько кадров подряд + высокий порог
                    local speedTh = math.max(Settings.SpeedDetectThreshold or 50, 50)
                    if horizSpeed > speedTh and humanoid.FloorMaterial ~= Enum.Material.Air then
                        track.speedHits = (track.speedHits or 0) + 1
                    else
                        track.speedHits = 0
                    end
                    local isSoftSpeed = track.speedHits >= 12 -- ~0.2с на 60фпс

                    local isFlying = false
                    if humanoid.FloorMaterial == Enum.Material.Air
                        and (pos.Y - (rootLocal and rootLocal.Position.Y or 0) > 20)
                        and horizSpeed > 45
                        and math.abs(linVel.Y) < 60 then
                        track.flyHits = (track.flyHits or 0) + 1
                    else
                        track.flyHits = 0
                    end
                    isFlying = track.flyHits >= 15

                    -- орбита: только явная
                    local isOrbit = false
                    local orbitTargetName = nil
                    if #track.samples >= 12 and horizSpeed > 35 then
                        for _, other in ipairs(Players:GetPlayers()) do
                            if other ~= player and other.Character then
                                local oroot = other.Character:FindFirstChild("HumanoidRootPart")
                                if oroot then
                                    local angles, radii = {}, {}
                                    for _, s in ipairs(track.samples) do
                                        local off = s.p - oroot.Position
                                        local flat = Vector3.new(off.X, 0, off.Z)
                                        if flat.Magnitude > 5 and flat.Magnitude < 22 then
                                            table.insert(angles, math.atan2(flat.Z, flat.X))
                                            table.insert(radii, flat.Magnitude)
                                        end
                                    end
                                    if #angles >= 10 then
                                        local sumDiff = 0
                                        for i = 2, #angles do
                                            local d = angles[i] - angles[i - 1]
                                            while d > math.pi do d = d - 2 * math.pi end
                                            while d < -math.pi do d = d + 2 * math.pi end
                                            sumDiff = sumDiff + math.abs(d)
                                        end
                                        if sumDiff > 4.5 then
                                            local avgR, var = 0, 0
                                            for _, r in ipairs(radii) do avgR = avgR + r end
                                            avgR = avgR / #radii
                                            for _, r in ipairs(radii) do var = var + (r - avgR) ^ 2 end
                                            var = var / #radii
                                            if var < 25 then
                                                isOrbit = true
                                                orbitTargetName = other.Name
                                                break
                                            end
                                        end
                                    end
                                end
                            end
                            if isOrbit then break end
                        end
                    end

                    local reason = nil
                    if isOrbit then
                        reason = "Orbit" .. (orbitTargetName and (" → " .. orbitTargetName) or "")
                    elseif isFlying then
                        reason = string.format("Fly (%.0f)", horizSpeed)
                    elseif isSpinningFast then
                        reason = "Spin/Fling"
                    elseif isSpazzingVertical then
                        reason = "Vert Spazz"
                    elseif isMovingTooFast then
                        reason = string.format("Vel %.0f", math.max(linVel.Magnitude, instSpeed))
                    elseif isTeleport then
                        reason = "Teleport"
                    elseif isSoftSpeed then
                        reason = string.format("Speed %.0f", horizSpeed)
                    end

                    if reason then
                        -- один флаг на игрока, не на каждую причину; кулдаун 18с
                        local flagKey = player.Name
                        if not flaggedCheaters[flagKey] or (now - (flaggedCheaters[flagKey] or 0)) > 18 then
                            flaggedCheaters[flagKey] = now
                            PushMessage("🚨 Детект", player.Name .. " — " .. reason, 3)
                        end

                        if isSpinningFast or isMovingTooFast or isSpazzingVertical then
                            root.AssemblyLinearVelocity = Vector3.zero
                            root.AssemblyAngularVelocity = Vector3.zero
                            local distance = (rootLocal.Position - root.Position).Magnitude
                            if distance < 12 then
                                for _, part in ipairs(char:GetDescendants()) do
                                    if part:IsA("BasePart") then
                                        part.CanCollide = false
                                    end
                                end
                            end
                        end
                    end

                    track.lastPos = pos
                    track.lastTime = now
                end
            end
        end
    end

    local closestTarget = nil
    local aimRange = Settings.Range or 12
    if Settings.AutoAim then
        aimRange = math.max(aimRange, 18) -- аим чуть дальше базового range
    end
    local shortestDist = aimRange

    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local isFriend = Settings.IgnoreFriends and IsFriend(player) or false
            if not isFriend then
                local tRoot = player.Character:FindFirstChild("HumanoidRootPart")
                local tHum = player.Character:FindFirstChildOfClass("Humanoid")
                if tRoot and tHum and tHum.Health > 0 then
                    local heightDiff = math.abs(rootLocal.Position.Y - tRoot.Position.Y)
                    local dist = (Vector3.new(rootLocal.Position.X, 0, rootLocal.Position.Z) - Vector3.new(tRoot.Position.X, 0, tRoot.Position.Z)).Magnitude

                    if dist <= (aimRange * 1.8) and heightDiff <= (20 + 4) then
                        recentCombat[player] = tick()
                    end

                    local maxH = 20
                    if Settings.AutoAim then maxH = math.max(maxH, 10) end
                    if heightDiff <= maxH then
                        if dist <= shortestDist then
                            shortestDist = dist
                            closestTarget = player.Character
                        end
                    end
                end
            end
        end
    end

    currentTarget = closestTarget
    if currentTarget then
        local tp = Players:GetPlayerFromCharacter(currentTarget)
        if tp then recentCombat[tp] = tick() end
    end

    -- ===== AUTO FARM / CHAIN FARM / TROLL =====
    local farmChar = nil
    if Settings.ChainFarm or Settings.AutoFarm or Settings.AutoFarmTarget or Settings.AutoFarmLowHP or Settings.AutoFarmTroll then
        farmChar = getFarmTargetCharacter(moveRoot.Position)
        if not farmChar and currentTarget and Settings.AutoFarm and not Settings.ChainFarm and not Settings.AutoFarmLowHP and not Settings.AutoFarmTarget then
            farmChar = currentTarget
        end
    end

    local farmOrStrafe = false

    if (Settings.ChainFarm or Settings.AutoFarm or Settings.AutoFarmTarget or Settings.AutoFarmLowHP or Settings.AutoFarmTroll) and farmChar and not FlingActive then
        farmOrStrafe = true
        local tRoot = farmChar:FindFirstChild("HumanoidRootPart")
        local tHum = farmChar:FindFirstChildOfClass("Humanoid")
        local tHead = farmChar:FindFirstChild("Head")
        if tRoot and tHum and tHum.Health > 0 then
            moveRoot.AssemblyLinearVelocity = Vector3.zero
            moveRoot.AssemblyAngularVelocity = Vector3.zero
            local now = tick()
            local radius = Settings.FarmRadius or 18
            local meleeDist = Settings.FarmHitDistance or 4.5
            local lookPos = tRoot.Position

            if Settings.AutoFarmTroll and not Settings.ChainFarm then
                if not Settings.JerkOff then
                    Settings.JerkOff = true
                    if UI_Toggles["JerkOff"] then pcall(UI_Toggles["JerkOff"]) end
                end
                local angle = tick() * (Settings.StrafeSpeed * 0.85)
                local offset = Vector3.new(math.cos(angle), 0.8, math.sin(angle)) * radius
                moveRoot.CFrame = CFrame.new(tRoot.Position + offset, lookPos)
            else
                -- Полёт ЗА целью, чуть сзади от плеча
                local look = tRoot.CFrame.LookVector
                local right = tRoot.CFrame.RightVector
                local flatLook = Vector3.new(look.X, 0, look.Z)
                if flatLook.Magnitude > 0.05 then flatLook = flatLook.Unit else flatLook = Vector3.new(0, 0, -1) end
                local flatRight = Vector3.new(right.X, 0, right.Z)
                if flatRight.Magnitude > 0.05 then flatRight = flatRight.Unit else flatRight = Vector3.new(1, 0, 0) end

                local backDist = math.clamp(meleeDist + 0.8, 3.5, 10)
                local shoulderOut = 1.35
                local flyHeight = 1.15
                local bob = math.sin(tick() * 2.2) * 0.15

                local desired = tRoot.Position
                    - flatLook * backDist
                    + flatRight * (shoulderOut + bob)
                    + Vector3.new(0, flyHeight, 0)

                local dist = (Vector3.new(tRoot.Position.X, 0, tRoot.Position.Z)
                    - Vector3.new(moveRoot.Position.X, 0, moveRoot.Position.Z)).Magnitude
                local toTarget = desired - moveRoot.Position
                lookPos = tRoot.Position + Vector3.new(0, 1.0, 0)

                -- Только плавный полёт (без телепорта)
                local flySpeed
                if dist > 35 then
                    flySpeed = 95
                elseif dist > 18 then
                    flySpeed = 72
                elseif dist > 8 then
                    flySpeed = 55
                else
                    flySpeed = 38
                end

                if toTarget.Magnitude > 0.15 then
                    local step = math.min(toTarget.Magnitude, flySpeed * math.clamp(dt, 0.001, 0.05))
                    local nextPos = moveRoot.Position + toTarget.Unit * step
                    -- чуть приподнимаем в полёте, если ниже слота
                    if nextPos.Y < desired.Y - 0.2 then
                        nextPos = Vector3.new(nextPos.X, nextPos.Y + math.min(desired.Y - nextPos.Y, flySpeed * 0.35 * dt), nextPos.Z)
                    end
                    moveRoot.CFrame = CFrame.new(nextPos, lookPos)
                    -- velocity в сторону полёта (ощущение fly, не snap)
                    local vel = toTarget.Unit * math.min(flySpeed, toTarget.Magnitude * 8)
                    moveRoot.AssemblyLinearVelocity = Vector3.new(vel.X, vel.Y * 0.45, vel.Z)
                else
                    moveRoot.CFrame = CFrame.new(desired, lookPos)
                    moveRoot.AssemblyLinearVelocity = Vector3.zero
                end
                moveRoot.AssemblyAngularVelocity = Vector3.zero

                local slotDist = (Vector3.new(desired.X, 0, desired.Z)
                    - Vector3.new(moveRoot.Position.X, 0, moveRoot.Position.Z)).Magnitude
                if slotDist <= 4.5 and dist <= (backDist + 6) then
                    if now - farmLastHit >= (Settings.FarmCooldown or 0.12) then
                        farmLastHit = now
                        farmDoM1(farmChar)
                    end
                    tryFarmSkills(true)
                end
            end

            -- spectate only if FarmKeepCamera off
            if cam and not isDesyncMove and not Settings.FarmKeepCamera then
                if tHead then cam.CameraSubject = tHead
                elseif tHum then cam.CameraSubject = tHum end
            end
        elseif Settings.ChainFarm then
            -- цель умерла → следующая
            rebuildChainList(moveRoot.Position)
        end
    elseif Settings.TargetStrafe and currentTarget and not FlingActive then
        farmOrStrafe = true
        local tRoot = currentTarget:FindFirstChild("HumanoidRootPart")
        local tHum = currentTarget:FindFirstChildOfClass("Humanoid")
        local tHead = currentTarget:FindFirstChild("Head")

        if tRoot then
            moveRoot.AssemblyLinearVelocity = Vector3.zero
            local angle = tick() * Settings.StrafeSpeed
            local offset = Vector3.new(math.cos(angle), 0, math.sin(angle)) * Settings.StrafeRadius
            local targetPos = tRoot.Position + offset
            moveRoot.CFrame = CFrame.new(Vector3.new(targetPos.X, tRoot.Position.Y, targetPos.Z), tRoot.Position)
        end

        if cam and not isDesyncMove and not Settings.FarmKeepCamera then
            if tHead then cam.CameraSubject = tHead
            elseif tHum then cam.CameraSubject = tHum end
        end
    else
        if cam and humLocal and not FlingActive and not isDesyncMove then
            if cam.CameraSubject ~= humLocal then
                cam.CameraSubject = humLocal
            end
        end

        if not farmOrStrafe and not Settings.FlyEnabled then
            local activeSpeed = 0
            if Settings.SprintEnabled and isSprinting then
                activeSpeed = Settings.SprintSpeedValue
            elseif Settings.SpeedEnabled then
                activeSpeed = Settings.SpeedValue
            end
            if activeSpeed > 0 then
                local boost = tonumber(Settings.SpeedBoost) or 1
                local spd = activeSpeed * boost
                -- WalkSpeed не трогаем (обход детекта по WalkSpeed) — только velocity
                if humLocal then
                    pcall(function()
                        if humLocal.WalkSpeed > 20 then
                            humLocal.WalkSpeed = 16
                        end
                    end)
                end
                local md = humLocal and humLocal.MoveDirection or Vector3.zero
                local dir = Vector3.zero
                if isDesyncMove then
                    local look = CFrame.Angles(0, DesyncState.camAngX, 0).LookVector
                    local right = CFrame.Angles(0, DesyncState.camAngX, 0).RightVector
                    if DesyncState.keys.W or UserInputService:IsKeyDown(Enum.KeyCode.W) then dir += look end
                    if DesyncState.keys.S or UserInputService:IsKeyDown(Enum.KeyCode.S) then dir -= look end
                    if DesyncState.keys.A or UserInputService:IsKeyDown(Enum.KeyCode.A) then dir -= right end
                    if DesyncState.keys.D or UserInputService:IsKeyDown(Enum.KeyCode.D) then dir += right end
                else
                    local cam0 = Workspace.CurrentCamera
                    if cam0 then
                        local look = Vector3.new(cam0.CFrame.LookVector.X, 0, cam0.CFrame.LookVector.Z)
                        local right = Vector3.new(cam0.CFrame.RightVector.X, 0, cam0.CFrame.RightVector.Z)
                        if look.Magnitude > 0.05 then look = look.Unit end
                        if right.Magnitude > 0.05 then right = right.Unit end
                        if UserInputService:IsKeyDown(Enum.KeyCode.W) then dir += look end
                        if UserInputService:IsKeyDown(Enum.KeyCode.S) then dir -= look end
                        if UserInputService:IsKeyDown(Enum.KeyCode.A) then dir -= right end
                        if UserInputService:IsKeyDown(Enum.KeyCode.D) then dir += right end
                    end
                    if dir.Magnitude < 0.05 and md.Magnitude > 0 then
                        dir = Vector3.new(md.X, 0, md.Z)
                    end
                end
                if dir.Magnitude > 0.05 then
                    dir = Vector3.new(dir.X, 0, dir.Z)
                    if dir.Magnitude > 0.05 then
                        dir = dir.Unit
                        local vy = moveRoot.AssemblyLinearVelocity.Y
                        -- velocity bypass: движение через AssemblyLinearVelocity, не WalkSpeed/CFrame spam
                        moveRoot.AssemblyLinearVelocity = Vector3.new(dir.X * spd, vy, dir.Z * spd)
                    end
                end
            end
        end

        if Settings.FlyEnabled and cam then
            local moveVec = Vector3.zero
            local look, right
            if isDesyncMove then
                local rot = CFrame.Angles(0, DesyncState.camAngX, 0) * CFrame.Angles(DesyncState.camAngY, 0, 0)
                look = rot.LookVector
                right = rot.RightVector
            else
                look = cam.CFrame.LookVector
                right = cam.CFrame.RightVector
            end
            if UserInputService:IsKeyDown(Enum.KeyCode.W) or DesyncState.keys.W then moveVec += look end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) or DesyncState.keys.S then moveVec -= look end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) or DesyncState.keys.A then moveVec -= right end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) or DesyncState.keys.D then moveVec += right end
            if UserInputService:IsKeyDown(Enum.KeyCode.Space) or DesyncState.keys.Space then moveVec += Vector3.new(0, 1, 0) end
            if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then moveVec -= Vector3.new(0, 1, 0) end
            if flyKeysHeld.Forward then moveVec += look end
            if flyKeysHeld.Back then moveVec -= look end
            if flyKeysHeld.Left then moveVec -= right end
            if flyKeysHeld.Right then moveVec += right end
            if flyKeysHeld.Up then moveVec += Vector3.new(0, 1, 0) end
            if flyKeysHeld.Down then moveVec -= Vector3.new(0, 1, 0) end

            local fspd = tonumber(Settings.FlySpeed) or 50
            if moveVec.Magnitude > 0.05 then
                local u = moveVec.Unit
                -- fly через velocity (обход)
                moveRoot.AssemblyLinearVelocity = u * fspd
            else
                moveRoot.AssemblyLinearVelocity = Vector3.zero
            end
            if not isDesyncMove then
                local horizontalLook = Vector3.new(cam.CFrame.LookVector.X, 0, cam.CFrame.LookVector.Z)
                if horizontalLook.Magnitude > 0 then
                    moveRoot.CFrame = CFrame.lookAt(moveRoot.Position, moveRoot.Position + horizontalLook)
                end
            end
        end
    end

    RangePart.Size = Vector3.new(0.2, Settings.Range * 2, Settings.Range * 2)
    RangePart.Position = rootLocal.Position - Vector3.new(0, 2.8, 0)
    RangePart.Transparency = Settings.AutoAim and 0.6 or 1

    if Settings.Fullbright then
        Lighting.Brightness = 2
        Lighting.ClockTime = 12
        Lighting.GlobalShadows = false
    end

    HUDFrame.Visible = Settings.TargetHUD and (currentTarget ~= nil)
    if HUDFrame.Visible and currentTarget then
        local targetPlayer = Players:GetPlayerFromCharacter(currentTarget)
        local targetHum = currentTarget:FindFirstChildOfClass("Humanoid")
        local tRoot = currentTarget:FindFirstChild("HumanoidRootPart")

        if targetPlayer then
            HUDName.Text = targetPlayer.DisplayName
            
            if not avatarCache[targetPlayer.UserId] then
                task.spawn(function()
                    local content, isLoaded = Players:GetUserThumbnailAsync(
                        targetPlayer.UserId, 
                        Enum.ThumbnailType.HeadShot, 
                        Enum.ThumbnailSize.Size100x100
                    )
                    if isLoaded then
                        avatarCache[targetPlayer.UserId] = content
                        if currentTarget and Players:GetPlayerFromCharacter(currentTarget) == targetPlayer then
                            AvatarImage.Image = content
                        end
                    end
                end)
            else
                AvatarImage.Image = avatarCache[targetPlayer.UserId]
            end
        else
            HUDName.Text = currentTarget.Name
            AvatarImage.Image = (localAsset ~= "" and localAsset) or ""
        end

        if targetHum then
            local hpPercent = math.clamp(targetHum.Health / targetHum.MaxHealth, 0, 1)
            HealthFill.Size = UDim2.new(hpPercent, 0, 1, 0)
        end

        if tRoot and rootLocal then
            local dist = math.floor((rootLocal.Position - tRoot.Position).Magnitude)
            HUDDist.Text = "Dist: " .. dist .. " studs"
        end
    end

    if currentTarget and Settings.AutoAim and not Settings.TargetStrafe then
        local tRoot = currentTarget:FindFirstChild("HumanoidRootPart")
        if tRoot then 
            FaceTarget(tRoot) 
        end
    else
        if humLocal and not humLocal.AutoRotate then
            humLocal.AutoRotate = true
        end
    end

    for player, esp in pairs(ESP_Cache) do
        local char = player.Character
        local isPixelUser = pixelClientUsers[player] or (char and char:GetAttribute("PixelsClientUser") == true)
        local rainbowColor = Color3.fromHSV((tick() % 3) / 3, 0.8, 1)

        if Settings.TargetESP and char and cam then
            local root = char:FindFirstChild("HumanoidRootPart")
            local hum = char:FindFirstChildOfClass("Humanoid")

            if root and hum and hum.Health > 0 then
                local dist = math.floor((rootLocal.Position - root.Position).Magnitude)
                local st = playerStatus[player]
                local tags = ""
                if isPixelUser then tags = tags .. "[PC] " end
                if st then
                    if st.ultUntil and tick() < st.ultUntil then tags = tags .. "[ULT] " end
                    if st.counterUntil and tick() < st.counterUntil then tags = tags .. "[COUNTER] " end
                    if st.charName == "Saitama" then
                        tags = tags .. "[SAITAMA] "
                    elseif st.charName then
                        tags = tags .. "[" .. string.upper(st.charName) .. "] "
                    end
                end
                local label = tags .. player.DisplayName .. " [" .. dist .. "m]"
                local nameCol = Color3.fromRGB(255, 255, 255)
                if st and st.ultUntil and tick() < st.ultUntil then
                    nameCol = Color3.fromRGB(255, 60, 60)
                elseif st and st.counterUntil and tick() < st.counterUntil then
                    nameCol = Color3.fromRGB(255, 200, 50)
                elseif isPixelUser then
                    nameCol = rainbowColor
                elseif char == currentTarget then
                    nameCol = Color3.fromRGB(255, 90, 100)
                end
                local hpPercent = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
                local boxCol = isPixelUser and rainbowColor or ((char == currentTarget) and Color3.fromRGB(255, 90, 100) or COLOR_TITLE)

                if esp.Mobile then
                    -- MOBILE ESP: Billboard + Highlight
                    AttachMobileESP(player, char)
                    if esp.NameLabel then
                        esp.NameLabel.Text = label
                        esp.NameLabel.TextColor3 = nameCol
                    end
                    if esp.HpFill then
                        esp.HpFill.Size = UDim2.new(hpPercent, 0, 1, 0)
                        esp.HpFill.BackgroundColor3 = COLOR_ACCENT
                    end
                    if esp.Highlight then
                        esp.Highlight.Enabled = true
                        esp.Highlight.FillColor = boxCol
                        esp.Highlight.OutlineColor = boxCol
                    end
                    if esp.Gui then
                        esp.Gui.Enabled = true
                    end
                else
                    local boxPos, boxSize = GetStaticESPBox(root, cam)
                    if boxPos and boxSize and esp.Box then
                        esp.BoxOutline.Size = boxSize
                        esp.BoxOutline.Position = boxPos
                        esp.BoxOutline.Visible = true
                        esp.Box.Size = boxSize
                        esp.Box.Position = boxPos
                        esp.Box.Color = boxCol
                        esp.Box.Visible = true
                        esp.Name.Text = label
                        esp.Name.Position = Vector2.new(boxPos.X + boxSize.X / 2, boxPos.Y - 18)
                        esp.Name.Color = nameCol
                        esp.Name.Visible = true
                        esp.HealthBg.Size = Vector2.new(3, boxSize.Y)
                        esp.HealthBg.Position = Vector2.new(boxPos.X - 6, boxPos.Y)
                        esp.HealthBg.Visible = true
                        local barHeight = boxSize.Y * hpPercent
                        esp.HealthBar.Size = Vector2.new(3, barHeight)
                        esp.HealthBar.Position = Vector2.new(boxPos.X - 6, boxPos.Y + (boxSize.Y - barHeight))
                        esp.HealthBar.Color = COLOR_ACCENT
                        esp.HealthBar.Visible = true
                    elseif esp.Box then
                        esp.BoxOutline.Visible = false
                        esp.Box.Visible = false
                        esp.Name.Visible = false
                        esp.HealthBg.Visible = false
                        esp.HealthBar.Visible = false
                    end
                end
            else
                if esp.Mobile then
                    if esp.Gui then esp.Gui.Enabled = false end
                    if esp.Highlight then esp.Highlight.Enabled = false end
                elseif esp.Box then
                    esp.BoxOutline.Visible = false
                    esp.Box.Visible = false
                    esp.Name.Visible = false
                    esp.HealthBg.Visible = false
                    esp.HealthBar.Visible = false
                end
            end
        else
            if esp.Mobile then
                if esp.Gui then esp.Gui.Enabled = false end
                if esp.Highlight then esp.Highlight.Enabled = false end
            elseif esp.Box then
                esp.BoxOutline.Visible = false
                esp.Box.Visible = false
                esp.Name.Visible = false
                esp.HealthBg.Visible = false
                esp.HealthBar.Visible = false
            end
        end
    end
end))
end
StartCombatLoop()
end -- SetupHudsAndFling
SetupHudsAndFling()
