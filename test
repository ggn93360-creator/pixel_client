local function tryFarmSkills(inMelee)
    if not Settings.FarmUseSkills or not inMelee then return end
    if isMouseOverPixelGui and isMouseOverPixelGui() then return end
    local now = tick()
    local order = {
        {k = "1", code = Enum.KeyCode.One},
        {k = "2", code = Enum.KeyCode.Two},
        {k = "3", code = Enum.KeyCode.Three},
        {k = "4", code = Enum.KeyCode.Four},
    }
    for _, s in ipairs(order) do
        local interval = FARM_SKILL_INTERVAL[s.k] or 4
        if now - (farmSkillCD[s.k] or 0) >= interval then
            farmSkillCD[s.k] = now
            -- одна попытка: кнопка → клавиша (без спама x3)
            local btn = combatBtnCache.skills[s.k]
