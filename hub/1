			local boost = smooth(env, "boost", air, dt, 5)
			local a = S.anim and 1 or 0
			env.st.ph = (env.st.ph or 0) + dt * S.speed * (1 + boost * 0.8) -- непрерывная фаза: без рывков при смене скорости
			local ph = env.st.ph
