		Size = UDim2.fromScale(1, 1), GroupTransparency = 1, ZIndex = 1}, lw)
	corner(card, 16)
	local bf = new("Frame", {BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 5}, lw)
	corner(bf, 16)
