			TextColor3 = Theme.SubText, TextXAlignment = Enum.TextXAlignment.Left,
			TextWrapped = true, Size = UDim2.new(1, 0, 0, 22), LayoutOrder = nextOrder()}, parent, "Bold")
		new("UIPadding", {PaddingLeft = UDim.new(0, 4), PaddingTop = UDim.new(0, 6)}, l)
		return {Set = function(t) l.Text = raw and t or string.upper(t) end}
