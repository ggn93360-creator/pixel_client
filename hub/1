	local function projPrev(p) -- нормализованные 0..1 координаты внутри ViewportFrame
		local o = cam.CFrame:PointToObjectSpace(p)
		if o.Z > -0.1 then return nil end
		local t = math.tan(math.rad(cam.FieldOfView) / 2)
		local asp = stage.AbsoluteSize.X / math.max(stage.AbsoluteSize.Y, 1)
		return Vector2.new((o.X / (-o.Z * t * asp) + 1) / 2, (1 - o.Y / (-o.Z * t)) / 2)
	end

	local function rebuild()
		if model then model:Destroy() end
		orig, chamsOn = {}, false
		local ch = getChar()
		local m
		if ch then
			local ok, c = pcall(function() ch.Archivable = true; return ch:Clone() end)
			if ok and c then
				m = c
				for _, d in ipairs(m:GetDescendants()) do
					if d:IsA("LuaSourceContainer") or d:IsA("Sound") or d:IsA("Highlight") or d:IsA("BillboardGui")
						or d:IsA("ParticleEmitter") or d:IsA("Trail") or d:IsA("PointLight") or d:IsA("ForceField") then
						d:Destroy()
					end
				end
				local h = m:FindFirstChildOfClass("Humanoid")
				if h then h:Destroy() end
			end
		end
		if not m then -- запасной вариант: манекен
			m = Instance.new("Model")
			local function blk(n, size, pos)
				local p = Instance.new("Part")
				p.Name = n; p.Size = size; p.Position = pos; p.Color = rgb(160, 160, 180); p.Parent = m
			end
			blk("Head", Vector3.new(1.2, 1.2, 1.2), Vector3.new(0, 2.6, 0))
			blk("Torso", Vector3.new(2, 2, 1), Vector3.new(0, 1, 0))
			blk("Left Arm", Vector3.new(1, 2, 1), Vector3.new(-1.5, 1, 0))
			blk("Right Arm", Vector3.new(1, 2, 1), Vector3.new(1.5, 1, 0))
			blk("Left Leg", Vector3.new(1, 2, 1), Vector3.new(-0.5, -1, 0))
			blk("Right Leg", Vector3.new(1, 2, 1), Vector3.new(0.5, -1, 0))
			m.PrimaryPart = m:FindFirstChild("Torso")
		elseif m:FindFirstChild("HumanoidRootPart") then
			m.PrimaryPart = m.HumanoidRootPart
		end
		for _, d in ipairs(m:GetDescendants()) do
			if d:IsA("BasePart") then
				d.Anchored = true; d.CanCollide = false
				orig[d] = {d.Color, d.Material, d.Transparency}
			end
		end
		m.Parent = wm
		m:PivotTo(CFrame.new(0, 0, 0) * CFrame.Angles(0, math.pi, 0))
		local cf, size = m:GetBoundingBox()
		local dist = (size.Y / 2) / math.tan(math.rad(cam.FieldOfView) / 2) * 1.5 + 2
		cam.CFrame = CFrame.new(Vector3.new(0, cf.Position.Y, dist), Vector3.new(0, cf.Position.Y, 0))
		model = m
		lastRebuild = os.clock()
	end

	local function refresh()
		if not model or not model.Parent then return end
		local vw, vh = stage.AbsoluteSize.X, stage.AbsoluteSize.Y
		if vw < 10 or vh < 10 then return end
		local t = os.clock()
		model:PivotTo(CFrame.new(0, 0, 0) * CFrame.Angles(0, math.pi + math.sin(t * 0.7) * 0.5, 0))

		-- chams на клоне (Highlight во ViewportFrame не рисуется)
		if ESP.chams then
			chamsOn = true
			local pulse = ESP.chamsPulse and (math.sin(t * 3) + 1) / 2 * 0.3 or 0
			for part, o in pairs(orig) do
				if o[3] < 1 and part.Parent then
					part.Color = ESP.chamsFill
					part.Material = Enum.Material.Neon
					part.Transparency = math.clamp(ESP.chamsAlpha / 100 + pulse, 0.05, 0.95)
				end
			end
		elseif chamsOn then
			chamsOn = false
			for part, o in pairs(orig) do
				if part.Parent then part.Color, part.Material, part.Transparency = o[1], o[2], o[3] end
			end
		end

		-- экранный бокс по bounding box модели
		local cf, size = model:GetBoundingBox()
		local minx, miny, maxx, maxy = 1e9, 1e9, -1e9, -1e9
		for sx = -1, 1, 2 do
			for sy = -1, 1, 2 do
				for sz = -1, 1, 2 do
					local s = projPrev((cf * CFrame.new(sx * size.X / 2, sy * size.Y / 2, sz * size.Z / 2)).Position)
					if s then
						minx = math.min(minx, s.X); maxx = math.max(maxx, s.X)
						miny = math.min(miny, s.Y); maxy = math.max(maxy, s.Y)
					end
				end
			end
		end
		if maxx < minx then widget.hide() return end
		local headPart = model:FindFirstChild("Head")
		local hs = headPart and projPrev(headPart.Position)
		local hum, ch = getHum(), getChar()
		local tool = ch and ch:FindFirstChildOfClass("Tool")
		local o = ESP.trOrigin == "Bottom" and Vector2.new(0.5, 1) or (ESP.trOrigin == "Center" and Vector2.new(0.5, 0.5) or Vector2.new(0.88, 0.14))
		local info = {
			x = minx, y = miny, w = maxx - minx, h = maxy - miny, name = LP.DisplayName .. " [PIXEL]", dist = "23m",
			item = tool and ("[" .. tool.Name .. "]") or "[Fists]", hp = hum and hum.Health / math.max(hum.MaxHealth, 1) or 1,
			vis = not ESP.wall, online = true, ox = o.X, oy = o.Y, hx = hs and hs.X, hy = hs and hs.Y,
		}
		if ESP.style == "3D Box" then info.c3d = boxCorners(model, projPrev)
		elseif ESP.style == "Skeleton" then info.bones = boneLines(model, projPrev) end
		widget.update(info, vw, vh)
		tag.Text = ESP.wall and "за стеной" or "в зоне видимости"
		tag.TextColor3 = ESP.wall and ESP.colWall or ESP.colVis
	end

	table.insert(previews, {refresh = refresh, rebuild = rebuild})
	overlay.MouseButton1Click:Connect(function()
		if wallTog then wallTog.Set(not wallTog.Get()) end
	end)

	local acc = 0
	connect(RunService.Heartbeat, function(dt)
		acc += dt
		if acc < 1 / 24 then return end
		acc = 0
		if not (sideShown and Win.IsVisible()) then return end
		local ch = getChar()
		local s = ch and #ch:GetChildren() or 0
		if s ~= sig and os.clock() - lastRebuild > 0.7 then -- поменялась косметика/предмет -> обновляем клон
			sig = s
			rebuild()
		end
		refresh()
	end)
	connect(LP.CharacterAdded, function()
		task.wait(1.5)
		if sideShown then rebuild() end
	end)
	esp:OnShow(function(on)
		sideShown = on
		Win:SetSideVisible(on)
		if on then rebuild(); esU() end
	end)
	Win:OnUnload(function() if model then model:Destroy() end end)

