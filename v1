local CoreGui = game:GetService("CoreGui")
local Players = game:GetService("Players")
local MarketplaceService = game:GetService("MarketplaceService")

local LocalPlayer = Players.LocalPlayer

-- Поддерживаемая игра (только TSB)
local SupportedGames = {
    {
        Name = "The Strongest Battlegrounds (TSB)",
        PlaceId = 10449761463,
        Description = "Основной режим: боевой клиент, ESP, прицеливание, музыка.",
        LoadstringCode = 'loadstring(game:HttpGet("https://raw.githubusercontent.com/ggn93360-creator/pixel_client/main/hub/1"))()'
    }
}

local currentPlaceId = game.PlaceId
local currentGameInfo = "Неизвестная игра"
pcall(function()
    local info = MarketplaceService:GetProductInfo(currentPlaceId)
    if info and info.Name then currentGameInfo = info.Name end
end)

local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "PixelClientHub"
ScreenGui.ResetOnSpawn = false
ScreenGui.DisplayOrder = 999999
ScreenGui.Parent = CoreGui

local Window = Instance.new("Frame", ScreenGui)
Window.Size = UDim2.new(0, 520, 0, 280)
Window.Position = UDim2.new(0.5, -260, 0.5, -140)
Window.BackgroundColor3 = Color3.fromRGB(30, 25, 48)
Window.BorderSizePixel = 0
Instance.new("UICorner", Window).CornerRadius = UDim.new(0, 14)

-- Шапка
local TopBar = Instance.new("Frame", Window)
TopBar.Size = UDim2.new(1, 0, 0, 45)
TopBar.BackgroundTransparency = 1

local Title = Instance.new("TextLabel", TopBar)
Title.Size = UDim2.new(1, -60, 1, 0)
Title.Position = UDim2.new(0, 15, 0, 0)
Title.BackgroundTransparency = 1
Title.Text = "⚡ Pixel Client | Hub"
Title.TextColor3 = Color3.fromRGB(225, 110, 255)
Title.Font = Enum.Font.GothamBold
Title.TextSize = 18
Title.TextXAlignment = Enum.TextXAlignment.Left

-- Кнопка закрытия (крестик)
local CloseBtn = Instance.new("TextButton", TopBar)
CloseBtn.Size = UDim2.new(0, 28, 0, 28)
CloseBtn.Position = UDim2.new(1, -38, 0.5, -14)
CloseBtn.BackgroundColor3 = Color3.fromRGB(180, 50, 60)
CloseBtn.Text = "X"
CloseBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
CloseBtn.Font = Enum.Font.GothamBold
CloseBtn.TextSize = 14
Instance.new("UICorner", CloseBtn).CornerRadius = UDim.new(0, 8)

CloseBtn.MouseButton1Click:Connect(function()
    ScreenGui:Destroy()
end)

-- Статус текущей игры
local StatusCard = Instance.new("Frame", Window)
StatusCard.Size = UDim2.new(1, -30, 0, 50)
StatusCard.Position = UDim2.new(0, 15, 0, 55)
StatusCard.BackgroundColor3 = Color3.fromRGB(42, 35, 66)
Instance.new("UICorner", StatusCard).CornerRadius = UDim.new(0, 10)

local StatusText = Instance.new("TextLabel", StatusCard)
StatusText.Size = UDim2.new(1, -20, 1, 0)
StatusText.Position = UDim2.new(0, 10, 0, 0)
StatusText.BackgroundTransparency = 1
StatusText.Text = string.format("Текущая игра: %s (ID: %d)", currentGameInfo, currentPlaceId)
StatusText.TextColor3 = Color3.fromRGB(220, 215, 235)
StatusText.Font = Enum.Font.GothamMedium
StatusText.TextSize = 13
StatusText.TextWrapped = true
StatusText.TextXAlignment = Enum.TextXAlignment.Left

-- Список игр (одна карточка TSB)
local ScrollingList = Instance.new("ScrollingFrame", Window)
ScrollingList.Size = UDim2.new(1, -30, 1, -120)
ScrollingList.Position = UDim2.new(0, 15, 0, 115)
ScrollingList.BackgroundTransparency = 1
ScrollingList.CanvasSize = UDim2.new(0, 0, 0, 0)
ScrollingList.AutomaticCanvasSize = Enum.AutomaticSize.Y
ScrollingList.ScrollBarThickness = 4

local UIList = Instance.new("UIListLayout", ScrollingList)
UIList.SortOrder = Enum.SortOrder.LayoutOrder
UIList.Padding = UDim.new(0, 8)

for _, gameData in ipairs(SupportedGames) do
    local Item = Instance.new("Frame", ScrollingList)
    Item.Size = UDim2.new(1, -6, 0, 70)
    Item.BackgroundColor3 = Color3.fromRGB(42, 35, 66)
    Instance.new("UICorner", Item).CornerRadius = UDim.new(0, 10)

    local GameTitle = Instance.new("TextLabel", Item)
    GameTitle.Size = UDim2.new(1, -120, 0, 22)
    GameTitle.Position = UDim2.new(0, 12, 0, 8)
    GameTitle.BackgroundTransparency = 1
    GameTitle.Text = gameData.Name
    GameTitle.TextColor3 = Color3.fromRGB(225, 110, 255)
    GameTitle.Font = Enum.Font.GothamBold
    GameTitle.TextSize = 14
    GameTitle.TextXAlignment = Enum.TextXAlignment.Left

    local Desc = Instance.new("TextLabel", Item)
    Desc.Size = UDim2.new(1, -120, 0, 30)
    Desc.Position = UDim2.new(0, 12, 0, 30)
    Desc.BackgroundTransparency = 1
    Desc.Text = gameData.Description
    Desc.TextColor3 = Color3.fromRGB(150, 145, 170)
    Desc.Font = Enum.Font.Gotham
    Desc.TextSize = 11
    Desc.TextWrapped = true
    Desc.TextXAlignment = Enum.TextXAlignment.Left

    local LaunchBtn = Instance.new("TextButton", Item)
    LaunchBtn.Size = UDim2.new(0, 95, 0, 32)
    LaunchBtn.Position = UDim2.new(1, -105, 0.5, -16)
    Instance.new("UICorner", LaunchBtn).CornerRadius = UDim.new(0, 8)

    if gameData.PlaceId == currentPlaceId then
        LaunchBtn.Text = "Запустить"
        LaunchBtn.BackgroundColor3 = Color3.fromRGB(80, 180, 90)
    else
        LaunchBtn.Text = "Не в игре"
        LaunchBtn.BackgroundColor3 = Color3.fromRGB(100, 100, 100)
    end
    LaunchBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    LaunchBtn.Font = Enum.Font.GothamBold
    LaunchBtn.TextSize = 13

    LaunchBtn.MouseButton1Click:Connect(function()
        if gameData.PlaceId == currentPlaceId then
            ScreenGui:Destroy()
            print("[Pixel Hub] Запуск скрипта TSB...")
            loadstring(game:HttpGet("https://raw.githubusercontent.com/ggn93360-creator/pixel_client/main/hub/1"))()
        end
    end)
end
