local chainKillList = {} -- ordered player names
local chainCurrentName = nil

local function rebuildChainList(fromPos)
    chainKillList = {}
    local list = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local hum = p.Character:FindFirstChildOfClass("Humanoid")
            local root = p.Character:FindFirstChild("HumanoidRootPart")
            if hum and root and hum.Health > 0 then
                if not (Settings.IgnoreFriends and IsFriend(p)) then
                    local d = fromPos and (root.Position - fromPos).Magnitude or 0
                    table.insert(list, {name = p.Name, dist = d, char = p.Character})
                end
            end
        end
    end
    table.sort(list, function(a, b) return a.dist < b.dist end)
    for _, e in ipairs(list) do
        table.insert(chainKillList, e.name)
    end
end

local function getChainFarmCharacter(fromPos)
    if #chainKillList == 0 then
        rebuildChainList(fromPos)
    end
    -- ищем первую живую из списка
    for _, name in ipairs(chainKillList) do
        local p = Players:FindFirstChild(name)
        if p and p.Character then
            local hum = p.Character:FindFirstChildOfClass("Humanoid")
            local root = p.Character:FindFirstChild("HumanoidRootPart")
            if hum and root and hum.Health > 0 then
                chainCurrentName = name
                Settings.FarmTargetName = name
                return p.Character
            end
        end
    end
    -- все мертвы / ушли — пересобрать
    rebuildChainList(fromPos)
    for _, name in ipairs(chainKillList) do
        local p = Players:FindFirstChild(name)
        if p and p.Character then
            local hum = p.Character:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 then
                chainCurrentName = name
                Settings.FarmTargetName = name
                return p.Character
            end
        end
    end
    chainCurrentName = nil
    return nil
end

local function isLowHPCharacter(char)
    if not char then return false end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return false end
    local maxH = hum.MaxHealth
    if maxH <= 0 then return false end
    local pct = (hum.Health / maxH) * 100
    return pct <= (Settings.FarmLowHPPercent or 35)
end

local function getNearestFarmable(fromPos, lowOnly)
    fromPos = fromPos or Vector3.zero
    local best, bestDist = nil, math.huge
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            if not (Settings.IgnoreFriends and IsFriend(p)) then
                local hum = p.Character:FindFirstChildOfClass("Humanoid")
                local root = p.Character:FindFirstChild("HumanoidRootPart")
                if hum and root and hum.Health > 0 then
                    if (not lowOnly) or isLowHPCharacter(p.Character) then
                        local d = (root.Position - fromPos).Magnitude
                        if d < bestDist then
                            bestDist = d
                            best = p.Character
                        end
                    end
                end
            end
        end
    end
    return best
end

local function getNamedFarmTarget()
    local name = Settings.FarmTargetName
    if name == "" then name = Settings.TrollingTarget end
    if name == "" then return nil end
    local p = Players:FindFirstChild(name)
    if p and p.Character then
        local hum = p.Character:FindFirstChildOfClass("Humanoid")
        if hum and hum.Health > 0 then
            return p.Character
        end
    end
    local w = Workspace:FindFirstChild(name)
    return w
end

local function getFarmTargetCharacter(fromPos)
    -- Chain Farm: по очереди 1 → 2 → 3
    if Settings.ChainFarm then
        return getChainFarmCharacter(fromPos)
    end

    -- Target Farm — только выбранная цель (из Trolling)
    if Settings.AutoFarmTarget then
        return getNamedFarmTarget()
    end

    -- Auto Farm Low HP — только цели с малым HP
    if Settings.AutoFarmLowHP then
        local low = getNearestFarmable(fromPos, true)
        if low then return low end
        -- если выбран конкретный target и он low — тоже ок
        local name = Settings.FarmTargetName
        if name == "" then name = Settings.TrollingTarget end
        if name ~= "" then
            local p = Players:FindFirstChild(name)
            if p and p.Character and isLowHPCharacter(p.Character) then
                return p.Character
            end
        end
        return nil
    end

    -- Auto Farm All — ближайший любой / выбранный target
    if Settings.AutoFarm then
        local name = Settings.FarmTargetName
        if name == "" then name = Settings.TrollingTarget end
        if name ~= "" then
            local p = Players:FindFirstChild(name)
            if p and p.Character then
                local hum = p.Character:FindFirstChildOfClass("Humanoid")
                if hum and hum.Health > 0 then
                    return p.Character
                end
            end
            local w = Workspace:FindFirstChild(name)
            if w then return w end
        end
        return getNearestFarmable(fromPos, false)
    end

    -- Troll farm: выбранный target
    if Settings.AutoFarmTroll then
        local name = Settings.FarmTargetName
        if name == "" then name = Settings.TrollingTarget end
        if name == "" then return nil end
        local p = Players:FindFirstChild(name)
        if p and p.Character then
            local hum = p.Character:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 then return p.Character end
        end
        return Workspace:FindFirstChild(name)
    end

    return nil
end

