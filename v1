local function createMinecraftToggle(parent, text, settingKey, callback)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -10, 0, 30)
    btn.BackgroundColor3 = COLOR_BTN
    btn.Text = ""
    btn.AutoButtonColor = false
    btn.Parent = parent
    applyPixelBorder(btn, Color3.fromRGB(0, 0, 0), 2)

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, -60, 1, 0)
    label.Position = UDim2.new(0, 8, 0, 0)
    label.BackgroundTransparency = 1
    label.Text = text
    label.TextColor3 = COLOR_TEXT
    label.Font = MC_FONT
    label.TextSize = 14
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = btn

    local statusBox = Instance.new("TextLabel")
    statusBox.Size = UDim2.new(0, 45, 0, 20)
    statusBox.Position = UDim2.new(1, -50, 0.5, -10)
    statusBox.BackgroundColor3 = Settings[settingKey] and Color3.fromRGB(60, 180, 60) or Color3.fromRGB(180, 60, 60)
    statusBox.Text = Settings[settingKey] and "ON" or "OFF"
    statusBox.TextColor3 = Color3.fromRGB(255, 255, 255)
    statusBox.Font = MC_FONT
    statusBox.TextSize = 14
    statusBox.Parent = btn
    applyPixelBorder(statusBox, Color3.fromRGB(0, 0, 0), 1)

    UnloadSystem:TrackConnection(btn.MouseButton1Click:Connect(function()
        Settings[settingKey] = not Settings[settingKey]
        local active = Settings[settingKey]
        statusBox.BackgroundColor3 = active and Color3.fromRGB(60, 180, 60) or Color3.fromRGB(180, 60, 60)
        statusBox.Text = active and "ON" or "OFF"
        SaveConfig()
        if callback then callback() end
    end))

    return btn
end

