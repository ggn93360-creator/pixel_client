-- ======================= ОБУЧЕНИЕ (первый запуск) и СБРОС =======================
local function runTutorial()
	local phone = Fit.phone
	local keyText = phone and "тап по watermark" or TOGGLE_KEY.Name
	local steps = {
		{"Добро пожаловать в Pixel Client", "Это короткое обучение займёт минуту. Его можно пропустить, а потом открыть снова: Misc -> Settings -> Показать обучение."},
		{"Меню", "Открыть / закрыть меню: " .. keyText .. ". Окно двигается за логотип или верхнюю панель." ..
			(phone and "" or " Клавишу меню можно сменить: GUI -> Управление.")},
		{"Категории и вкладки", "Слева категории. Нажми на категорию - под ней раскроются вкладки, а справа появятся функции выбранной вкладки."},
		{"Функции", "Нажатие - включить функцию. " .. (phone and "Двойное нажатие" or "ПКМ или двойной клик") ..
			" - её настройки (шестерёнка)." .. (phone and "" or " Средняя кнопка мыши - назначить клавишу.")},
		{"Косметика и шейдеры", "Visuals -> Cosmetics: гардероб, можно носить сразу много вещей. Visuals -> Shaders: шейдеры, небо со скайбоксами и настройки мира."},
		{"HUD", "Visuals -> HUD: Watermark, Keybinds, " .. (phone and "" or "Now Playing, ") .. "ArrayList, Target HUD. Каждый можно перетаскивать, менять размер, ширину и высоту, а также объединять в общий стек или разделять."},
		{"Конфиги и сброс", "Misc -> Configs: сохранение и загрузка настроек. Misc -> Settings -> Сбросить всё вернёт всё по умолчанию, сохранённые конфиги останутся."},
	}
	local idx = 1

	local overlay = new("Frame", {BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1),
		Active = true, ZIndex = 60}, gui)
	local holder = new("Frame", {BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(460, 270)}, overlay)
	local sc = new("UIScale", {Scale = Fit.gui * 0.9}, holder)
	local sh = makeShadow(holder, 30, 8)
	local card = new("CanvasGroup", {BackgroundColor3 = Theme.Background, BackgroundTransparency = 0.06, Size = UDim2.fromScale(1, 1),
		GroupTransparency = 1, ZIndex = 1}, holder)
	corner(card, 16)
	local bf = new("Frame", {BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 5}, holder)
	corner(bf, 16)
	local bs = new("UIStroke", {Color = WHITE, Thickness = 1.2, Transparency = 1}, bf)
	accent(bs, true)

	local logo = new("TextLabel", {BackgroundTransparency = 1, Font = Enum.Font.Arcade, TextSize = 22, Text = "PIXEL", TextColor3 = WHITE,
		TextXAlignment = Enum.TextXAlignment.Left, Position = UDim2.fromOffset(24, 16), Size = UDim2.fromOffset(120, 26)}, card)
	accent(logo, true)
	local counter = txt("TextLabel", {BackgroundTransparency = 1, TextSize = 11, TextColor3 = Theme.SubText, Text = "",
		TextXAlignment = Enum.TextXAlignment.Right, Position = UDim2.new(1, -144, 0, 20), Size = UDim2.fromOffset(120, 18)}, card, "Bold")
	local title = txt("TextLabel", {BackgroundTransparency = 1, TextSize = 20, TextColor3 = Theme.Text, Text = "",
		TextXAlignment = Enum.TextXAlignment.Left, Position = UDim2.fromOffset(24, 62), Size = UDim2.new(1, -48, 0, 28)}, card, "Bold")
	local body = txt("TextLabel", {BackgroundTransparency = 1, TextSize = 14, TextColor3 = Theme.SubText, Text = "", TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top,
		Position = UDim2.fromOffset(24, 100), Size = UDim2.new(1, -48, 0, 100)}, card, "Regular")
	local barBg = new("Frame", {BackgroundColor3 = Theme.ElementHi, Position = UDim2.new(0, 24, 1, -64), Size = UDim2.new(1, -48, 0, 4)}, card)
	corner(barBg, 2)
	local fill = new("Frame", {BackgroundColor3 = WHITE, Size = UDim2.fromScale(0, 1)}, barBg)
	corner(fill, 2)
	accent(fill, true)

	local function btn(text, x, w, primary)
		local b = txt("TextButton", {BackgroundColor3 = primary and Theme.AccentA or Theme.ElementHi, BackgroundTransparency = primary and 0.15 or 0.35,
			Text = text, TextColor3 = WHITE, TextSize = 13, AutoButtonColor = false, Size = UDim2.fromOffset(w, 32),
			Position = UDim2.new(x >= 0 and 0 or 1, x, 1, -48)}, card, "Bold")
		corner(b, 8)
		return b
	end
	local skipB = btn("Пропустить", 24, 110, false)
	local backB = btn("Назад", -218, 90, false)
	local nextB = btn("Далее", -118, 94, true)

	local function finish()
		Pixel.State.data.tutorialDone = true
		Pixel.State.save()
		tween(card, {GroupTransparency = 1}, 0.25)
		tween(bs, {Transparency = 1}, 0.25)
		tween(overlay, {BackgroundTransparency = 1}, 0.3)
		tween(sc, {Scale = Fit.gui * 0.94}, 0.3)
		sh:Set(0, 0.25)
		task.delay(0.35, function() overlay:Destroy() end)
	end
	local function show()
		local st = steps[idx]
		title.Text = st[1]
		body.Text = st[2]
		counter.Text = idx .. " / " .. #steps
		nextB.Text = idx == #steps and "Готово" or "Далее"
		backB.Visible = idx > 1
		tween(fill, {Size = UDim2.fromScale(idx / #steps, 1)}, 0.3, Enum.EasingStyle.Quart)
		body.TextTransparency = 1
		title.TextTransparency = 1
		tween(body, {TextTransparency = 0}, 0.25)
		tween(title, {TextTransparency = 0}, 0.25)
	end
	nextB.MouseButton1Click:Connect(function()
		if idx >= #steps then finish() else idx += 1; show() end
	end)
	backB.MouseButton1Click:Connect(function() if idx > 1 then idx -= 1; show() end end)
	skipB.MouseButton1Click:Connect(finish)

	tween(overlay, {BackgroundTransparency = 0.5}, 0.35)
	tween(card, {GroupTransparency = 0}, 0.35)
	tween(bs, {Transparency = 0.35}, 0.35)
	tween(sc, {Scale = Fit.gui}, 0.4, Enum.EasingStyle.Back)
	sh:Set(0.8, 0.35)
	show()
end

-- полный сброс: настройки, бинды, HUD (позиции/размеры), обои, счётчик заходов и обучение.
-- Сохранённые конфиги (файлы в PixelClient/configs) НЕ трогаются.
local function resetAll()
	if Pixel.DefaultsJson then Pixel.Config.ApplyJson(Pixel.DefaultsJson) end
	for _, it in ipairs(Pixel.HudItems) do
		it.pos = nil; it.scale = 1; it.w = 0; it.h = 0; it.apply()
	end
	Win:SetWallpaper("")
	Pixel.State.reset()
	Pixel:Notify("Сброс", "Всё сброшено, сохранённые конфиги остались. Обучение покажется при следующем запуске", 4.5)
end

-- ======================= MISC =======================
local misc = Win:AddCategory("Misc", "dots")
do
	local cfgTab = misc:AddTab("Configs")
	local cfgName = "default"
	cfgTab:AddLabel(hasFS and "Хранилище: файлы (PixelClient/configs)" or "Хранилище: только память (нет файловых функций)")
	local cfgDD
	cfgTab:AddTextbox("Имя конфига", "default", function(t)
		t = (t:gsub("[^%w_%-%s]", ""):gsub("^%s+", ""):gsub("%s+$", ""))
		if t ~= "" then cfgName = t end
	end, "default")
	cfgDD = cfgTab:AddDropdown("Список", Pixel.Config.List(), nil, function(n) cfgName = n end, true)
	cfgTab:AddButton("Сохранить", function()
		if Pixel.Config.Save(cfgName) then
			cfgDD.Refresh(Pixel.Config.List())
			Pixel:Notify("Configs", "Сохранён: " .. cfgName, 2.5)
		else
			Pixel:Notify("Configs", "Не удалось сохранить", 3)
		end
	end)
	cfgTab:AddButton("Загрузить", function()
		Pixel:Notify("Configs", Pixel.Config.Load(cfgName) and ("Загружен: " .. cfgName) or ("Конфиг не найден: " .. cfgName), 2.5)
	end)
	cfgTab:AddButton("Удалить", function()
		Pixel.Config.Delete(cfgName)
		cfgDD.Refresh(Pixel.Config.List())
		Pixel:Notify("Configs", "Удалён: " .. cfgName, 2.5)
	end)
	cfgTab:AddButton("Обновить список", function() cfgDD.Refresh(Pixel.Config.List()) end)
	cfgTab:AddLabel("Обмен")
	cfgTab:AddButton("Скопировать конфиг (JSON)", function()
		local ok = pcall(function() setclipboard(Pixel.Config.Encode()) end)
		Pixel:Notify("Configs", ok and "Скопировано в буфер" or "Нет setclipboard", 2.5)
	end)
	cfgTab:AddTextbox("Импорт JSON", "вставь JSON и нажми Enter", function(t)
		if t == "" then return end
		Pixel:Notify("Configs", Pixel.Config.ApplyJson(t) and "Импортировано" or "Неверный JSON", 2.5)
	end)

	local settings = misc:AddTab("Settings")
	settings:AddButton("Тестовое уведомление", function() Pixel:Notify("Pixel Client", "Всё работает отлично!", 3) end)
	settings:AddButton("Сбросить все keybinds", function()
		for _, o in pairs(Binds.map) do o.SetKey(nil) end
		Pixel:Notify("Keybind", "Все клавиши сброшены", 2)
	end)
	settings:AddButton("Показать обучение", function() runTutorial() end)
	local resetArmed = false
	settings:AddButton("Сбросить всё (кроме сохранённых конфигов)", function()
		if not resetArmed then
			resetArmed = true
			Pixel:Notify("Сброс", "Нажми ещё раз в течение 4 секунд для подтверждения", 4)
			task.delay(4, function() resetArmed = false end)
			return
		end
		resetArmed = false
		resetAll()
	end)
	settings:AddButton("Unload", function() Win:Destroy() end)

	local about = misc:AddTab("About")
	about:AddLabel("Pixel Client v9")
	about:AddLabel("Клавиша меню: GUI -> Управление. Телефон: тап по watermark")
	about:AddLabel("СКМ по функции - назначить клавишу")
end

