local function getProtectTarget()
    local name = Settings.FarmTargetName ~= "" and Settings.FarmTargetName or Settings.TrollingTarget
    if not name or name == "" then
        name = next(SelectedFlingTargets)
    end
    local function fromPlayer(plr)
        if not plr or plr == LocalPlayer then return nil end
        local char = plr.Character
        if not char then return nil end
        local root = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not root or not hum or hum.Health <= 0 then return nil end
        return plr, char, root, hum
    end
    if name and name ~= "" then
        local plr = Players:FindFirstChild(name)
        if not plr then
            for _, p in ipairs(Players:GetPlayers()) do
                if p.Name == name or p.DisplayName == name then plr = p break end
            end
        end
        local a, b, c, d = fromPlayer(plr)
        if a then return a, b, c, d end
    end
    -- fallback: currentTarget из combat loop
    if currentTarget and currentTarget.Parent then
        local plr = Players:GetPlayerFromCharacter(currentTarget)
        local a, b, c, d = fromPlayer(plr)
        if a then return a, b, c, d end
    end
    -- fallback: ближайший игрок
    local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if myRoot then
        local best, bestD = nil, 40
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character then
                local r = p.Character:FindFirstChild("HumanoidRootPart")
                local h = p.Character:FindFirstChildOfClass("Humanoid")
                if r and h and h.Health > 0 then
                    local d = (r.Position - myRoot.Position).Magnitude
                    if d < bestD then bestD = d best = p end
                end
            end
        end
        if best then return fromPlayer(best) end
    end
    return nil
end

local function isPlayerBlocking(char, hum)
    if not char or not hum then return false end
    -- animation tracks
    local ok, tracks = pcall(function()
        return hum:GetPlayingAnimationTracks()
    end)
    if ok and tracks then
        for _, tr in ipairs(tracks) do
            local n = string.lower(tostring(tr.Name) .. tostring(tr.Animation and tr.Animation.AnimationId or ""))
            if n:find("block", 1, true) or n:find("guard", 1, true) or n:find("defend", 1, true)
                or n:find("parry", 1, true) or n:find("shield", 1, true) then
                return true
            end
        end
    end
    -- attributes / bool values common in TSB-like games
    for _, v in ipairs(char:GetDescendants()) do
        if v:IsA("BoolValue") or v:IsA("BoolAttribute") then
        end
        local nm = string.lower(v.Name)
        if (nm == "blocking" or nm == "isblocking" or nm == "guard") and (v:IsA("BoolValue") and v.Value) then
            return true
        end
    end
    pcall(function()
        if char:GetAttribute("Blocking") == true or char:GetAttribute("IsBlocking") == true then
            return true
        end
    end)
    if char:GetAttribute("Blocking") == true or char:GetAttribute("IsBlocking") == true then
        return true
    end
    return false
end

