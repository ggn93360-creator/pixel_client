-- Jerk Off (без инструмента в инвентаре)
local jerkPlaying = false
local jerkConns = {}
local jerkTracks = {}

local function forceJerkAnim(id, startTime, endTime, trackId, speed)
    local character = LocalPlayer.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    if not humanoid then return end
    if jerkTracks[trackId] then
        pcall(function() jerkTracks[trackId]:Stop() end)
        jerkTracks[trackId] = nil
    end
    local anim = Instance.new("Animation")
    anim.AnimationId = "rbxassetid://" .. id
    local track = humanoid:LoadAnimation(anim)
    track.Priority = Enum.AnimationPriority.Action4
    track.Looped = false
    jerkTracks[trackId] = track
    jerkConns[trackId] = RunService.RenderStepped:Connect(function()
        if not jerkPlaying or not Settings.JerkOff then
            pcall(function() track:Stop() end)
            return
        end
        if not track.IsPlaying or track.TimePosition >= endTime then
            track:Play()
            track.TimePosition = startTime
            track:AdjustSpeed(speed)
        end
    end)
    track:Play()
    track.TimePosition = startTime
    track:AdjustSpeed(speed)
end

local function startJerk()
    if jerkPlaying then return end
    jerkPlaying = true
    forceJerkAnim("72042024", 0.3, 0.8, 1, 3.5)
    forceJerkAnim("168268306", 0.8, 1.1, 2, 4.0)
end

local function stopJerk()
    jerkPlaying = false
    for _, conn in pairs(jerkConns) do
        pcall(function() conn:Disconnect() end)
    end
    jerkConns = {}
    for _, track in pairs(jerkTracks) do
        pcall(function() track:Stop() end)
    end
    jerkTracks = {}
end

local oldJerkToggle = nil
task.defer(function()
    oldJerkToggle = UI_Toggles["JerkOff"]
    UI_Toggles["JerkOff"] = function()
        if oldJerkToggle then oldJerkToggle() end
        if Settings.JerkOff then
            startJerk()
            PushMessage("Jerk Off", "Включено", 2)
        else
            stopJerk()
            PushMessage("Jerk Off", "Выключено", 2)
        end
    end
end)

