-- Флаги M1 с AnimationPlayed (TSB часто не пишет "punch" в имени)
local targetM1Flags = {} -- [player] = tick()
local targetM1Hooked = {} -- [char] = true

local function hookTargetM1(plr, char, hum)
    if not char or targetM1Hooked[char] then return end
    targetM1Hooked[char] = true
    local function onTrack(track)
        if not track then return end
        local n = string.lower(tostring(track.Name) .. tostring(track.Animation and track.Animation.AnimationId or ""))
        local skip = n:find("walk", 1, true) or n:find("run", 1, true) or n:find("jump", 1, true)
            or n:find("fall", 1, true) or n:find("idle", 1, true) or n:find("block", 1, true)
            or n:find("guard", 1, true) or n:find("swim", 1, true) or n:find("climb", 1, true)
            or n:find("sit", 1, true) or n:find("emote", 1, true)
        local hit = n:find("m1", 1, true) or n:find("punch", 1, true) or n:find("swing", 1, true)
            or n:find("attack", 1, true) or n:find("combat", 1, true) or n:find("hit", 1, true)
            or n:find("slash", 1, true) or n:find("jab", 1, true) or n:find("light", 1, true)
            or n:find("heavy", 1, true) or n:find("combo", 1, true) or n:find("strike", 1, true)
            or n:find("normal", 1, true) or n:find("skill", 1, true) or n:find("ability", 1, true)
        local prio = 0
        pcall(function() prio = track.Priority and track.Priority.Value or 0 end)
        -- Action+ = часто удар в TSB
        if (hit or (prio >= Enum.AnimationPriority.Action.Value and not skip)) and not skip then
            if plr then targetM1Flags[plr] = tick() end
        end
    end
    pcall(function()
        local animator = hum and hum:FindFirstChildOfClass("Animator")
        if animator then
            UnloadSystem:TrackConnection(animator.AnimationPlayed:Connect(onTrack))
        end
        UnloadSystem:TrackConnection(hum.AnimationPlayed:Connect(onTrack))
    end)
    -- tool activated
    pcall(function()
        char.ChildAdded:Connect(function(ch)
            if ch:IsA("Tool") then
                pcall(function()
                    ch.Activated:Connect(function()
                        if plr then targetM1Flags[plr] = tick() end
                    end)
                end)
            end
        end)
        local tool = char:FindFirstChildOfClass("Tool")
        if tool then
            tool.Activated:Connect(function()
                if plr then targetM1Flags[plr] = tick() end
            end)
        end
    end)
end

local function isPlayerM1(char, hum, plr)
    if not char or not hum then return false end
    if plr then hookTargetM1(plr, char, hum) end

    -- главный сигнал: SetupStatusTracking → m1Until
    if plr and playerStatus[plr] and playerStatus[plr].m1Until and tick() < playerStatus[plr].m1Until then
        return true
    end

    -- свежий флаг с AnimationPlayed / Tool
    if plr and targetM1Flags[plr] and (tick() - targetM1Flags[plr]) < 0.35 then
        return true
    end

    local function checkTracks(tracks)
        if not tracks then return false end
        for _, tr in ipairs(tracks) do
            if tr.IsPlaying then
                local n = string.lower(tostring(tr.Name) .. tostring(tr.Animation and tr.Animation.AnimationId or ""))
                local skip = n:find("walk", 1, true) or n:find("run", 1, true) or n:find("jump", 1, true)
                    or n:find("fall", 1, true) or n:find("idle", 1, true) or n:find("block", 1, true)
                    or n:find("guard", 1, true) or n:find("swim", 1, true) or n:find("climb", 1, true)
                local hit = n:find("m1", 1, true) or n:find("punch", 1, true) or n:find("swing", 1, true)
                    or n:find("attack", 1, true) or n:find("combat", 1, true) or n:find("hit", 1, true)
                    or n:find("slash", 1, true) or n:find("jab", 1, true) or n:find("combo", 1, true)
                    or n:find("strike", 1, true) or n:find("normal", 1, true) or n:find("light", 1, true)
                local prio = 0
                pcall(function() prio = tr.Priority and tr.Priority.Value or 0 end)
                if not skip and (hit or prio >= Enum.AnimationPriority.Action.Value) then
                    return true
                end
            end
        end
        return false
    end

    local ok, tracks = pcall(function() return hum:GetPlayingAnimationTracks() end)
    if ok and checkTracks(tracks) then return true end
    local animator = hum:FindFirstChildOfClass("Animator")
    if animator then
        local ok2, tracks2 = pcall(function() return animator:GetPlayingAnimationTracks() end)
        if ok2 and checkTracks(tracks2) then return true end
    end

    -- рука резко вперёд (Motor6D Transform) — запасной детект TSB
    local torso = char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso")
    if torso then
        for _, name in ipairs({"Right Shoulder", "RightShoulder", "Left Shoulder", "LeftShoulder"}) do
            local m = torso:FindFirstChild(name)
            if m and m:IsA("Motor6D") then
                local ok3, tf = pcall(function() return m.Transform end)
                if ok3 and typeof(tf) == "CFrame" then
                    local _, _, _, r00, r01, r02, r10, r11, r12, r20, r21, r22 = tf:GetComponents()
                    -- большой pitch вперёд
                    if math.abs(r12) > 0.55 or math.abs(r02) > 0.55 then
                        return true
                    end
                end
            end
        end
    end
    return false
end

