-- Anti-Fling (KILASIK) — код не изменён, только условие включения
UnloadSystem:TrackConnection(RunService.Stepped:Connect(function()
    if not UnloadSystem.Active or not Settings.AntiFling then return end
    if Settings.FlingEnabled or FlingActive then return end

    local myChar = LocalPlayer.Character
    if not myChar then return end
    local myRoot = myChar:FindFirstChild("HumanoidRootPart")
    if not myRoot then return end
    -- Protect local player from velocity changes (Anti-Fling core)
    if myRoot.AssemblyLinearVelocity.Magnitude > 300 or myRoot.AssemblyAngularVelocity.Magnitude > 300 then
        myRoot.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        myRoot.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
    end
    -- Scan other players for cheating behavior (Fling, Spinbot, Teleport spazzing)
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local char = player.Character
            local root = char:FindFirstChild("HumanoidRootPart")
            local humanoid = char:FindFirstChildOfClass("Humanoid")
            
            if root and humanoid and humanoid.Health > 0 then
                local linVel = root.AssemblyLinearVelocity
                local angVel = root.AssemblyAngularVelocity
                
                -- Condition 1: High speed / Fling state (spinning fast or flying around)
                local isSpinningFast = angVel.Magnitude > 50
                local isMovingTooFast = linVel.Magnitude > 200
                local isSpazzingVertical = math.abs(linVel.Y) > 150 -- тепается вверх-вниз / дергается
                if (isSpinningFast or isMovingTooFast or isSpazzingVertical) then
                    -- Neutralize their physics relative to you so they can't fling you
                    root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                    root.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                    
                    -- Disable collision locally if they get too close while flinging
                    local distance = (myRoot.Position - root.Position).Magnitude
                    if distance < 10 then
                        for _, part in ipairs(char:GetDescendants()) do
                            if part:IsA("BasePart") then
                                part.CanCollide = false
                            end
                        end
                    end
                end
            end
        end
    end
end))
