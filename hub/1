	-- запуск скрытого Python-companion (PC). Если нельзя запустить сам - остаётся ручной запуск.
	local function companionAlive() return httpJson("GET", "http://127.0.0.1:" .. NP.port .. "/now", nil) ~= nil end
	local function runShell(cmd)
		local fns = {}
		if os and os.execute then table.insert(fns, os.execute) end
		if io and io.popen then table.insert(fns, io.popen) end
		local ok, ge = pcall(function() return getgenv and getgenv() end)
		if ok and ge then
			for _, n in ipairs({"execute", "run_command", "runcmd", "shell"}) do
				if type(ge[n]) == "function" then table.insert(fns, ge[n]) end
			end
		end
		for _, f in ipairs(fns) do
			if pcall(f, cmd) then return true end
		end
		return false
	end
	local function manualCommand()
		return 'powershell -w hidden -c "$p=$env:TEMP+\'\\PixelNowPlaying.pyw\'; iwr -useb \'' .. RAW_PY ..
			'\' -OutFile $p; Start-Process pythonw -ArgumentList $p,' .. NP.port .. ' -WindowStyle Hidden"'
	end
	function Pixel.LaunchCompanion()
		if Fit.phone then return "phone" end -- на телефоне ничего не трогаем
		if companionAlive() then return "running" end
		local okdl = pcall(function() ensureDir(); writefile("PixelClient/PixelNowPlaying.pyw", game:HttpGet(RAW_PY)) end)
		if not okdl then return "download" end
		for _, rel in ipairs({"workspace\\PixelClient\\PixelNowPlaying.pyw", "PixelClient\\PixelNowPlaying.pyw"}) do
			runShell(string.format('cmd /c start "" /B pythonw "%s" %d', rel, NP.port))
			for _ = 1, 4 do
				task.wait(0.6)
				if companionAlive() then return "running" end
			end
		end
		return "manual"
	end

