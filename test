UnloadSystem:TrackConnection(RunService.Stepped:Connect(function()
    if not DesyncState.active or not DesyncState.clone then return end
    local clone = DesyncState.clone
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    if not clone:FindFirstChild("HumanoidRootPart") then return end

    local realRoot = char.HumanoidRootPart
    local cloneRoot = clone.HumanoidRootPart
    local charHum = char:FindFirstChildOfClass("Humanoid")
    local cloneHum = clone:FindFirstChildOfClass("Humanoid")

    for _, part in pairs(char:GetDescendants()) do
        if part:IsA("BasePart") then part.CanCollide = false end
    end

    -- real body deep under clone (server still tracks real HRP, local hidden)
    realRoot.CFrame = cloneRoot.CFrame * CFrame.new(0, -25, 0)
    realRoot.AssemblyLinearVelocity = Vector3.zero
    realRoot.AssemblyAngularVelocity = Vector3.zero
    for _, p in pairs(char:GetDescendants()) do
        if p:IsA("BasePart") then
            p.LocalTransparencyModifier = 1
            p.CanCollide = false
        end
    end

    if DesyncState.floor then
        DesyncState.floor.CFrame = cloneRoot.CFrame * CFrame.new(0, -3.2, 0)
    end

    if cloneHum and charHum then
        local rotCF = CFrame.Angles(0, DesyncState.camAngX, 0)
        local flatLook = Vector3.new(rotCF.LookVector.X, 0, rotCF.LookVector.Z)
        local flatRight = Vector3.new(rotCF.RightVector.X, 0, rotCF.RightVector.Z)
        if flatLook.Magnitude > 0 then flatLook = flatLook.Unit end
        if flatRight.Magnitude > 0 then flatRight = flatRight.Unit end

        local autoMove = Settings.ChainFarm or Settings.AutoFarm or Settings.AutoFarmTarget or Settings.AutoFarmLowHP or Settings.AutoFarmTroll or Settings.TargetStrafe
        if not autoMove then
            local moveDir = Vector3.zero
            if DesyncState.keys.W or UserInputService:IsKeyDown(Enum.KeyCode.W) then moveDir += flatLook end
            if DesyncState.keys.S or UserInputService:IsKeyDown(Enum.KeyCode.S) then moveDir -= flatLook end
            if DesyncState.keys.A or UserInputService:IsKeyDown(Enum.KeyCode.A) then moveDir -= flatRight end
            if DesyncState.keys.D or UserInputService:IsKeyDown(Enum.KeyCode.D) then moveDir += flatRight end
            if UserInputService.TouchEnabled then
                local md = charHum.MoveDirection
                if md and md.Magnitude > 0.05 and moveDir.Magnitude < 0.05 then
                    moveDir = Vector3.new(md.X, 0, md.Z)
                end
            end

            local spd = 18
            if Settings.SprintEnabled and isSprinting then spd = Settings.SprintSpeedValue
            elseif Settings.SpeedEnabled then spd = Settings.SpeedValue end
            if Settings.FlyEnabled then
                local cam = Workspace.CurrentCamera
                local look = cam and cam.CFrame.LookVector or flatLook
                local right = cam and cam.CFrame.RightVector or flatRight
                moveDir = Vector3.zero
                if DesyncState.keys.W or UserInputService:IsKeyDown(Enum.KeyCode.W) then moveDir += look end
                if DesyncState.keys.S or UserInputService:IsKeyDown(Enum.KeyCode.S) then moveDir -= look end
                if DesyncState.keys.A or UserInputService:IsKeyDown(Enum.KeyCode.A) then moveDir -= right end
                if DesyncState.keys.D or UserInputService:IsKeyDown(Enum.KeyCode.D) then moveDir += right end
                if DesyncState.keys.Space or UserInputService:IsKeyDown(Enum.KeyCode.Space) then moveDir += Vector3.new(0, 1, 0) end
                if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then moveDir -= Vector3.new(0, 1, 0) end
                spd = Settings.FlySpeed or 50
            end

            -- CFrame move clone (надёжнее чем Humanoid:Move на клоне)
            if moveDir.Magnitude > 0.05 then
                local step = moveDir.Unit * (spd * 0.05)
                local np = cloneRoot.Position + step
                if not Settings.FlyEnabled then
                    -- keep height roughly
                    np = Vector3.new(np.X, cloneRoot.Position.Y, np.Z)
                    local face = Vector3.new(moveDir.X, 0, moveDir.Z)
                    if face.Magnitude > 0.05 then
                        cloneRoot.CFrame = CFrame.lookAt(np, np + face)
                    else
                        cloneRoot.CFrame = CFrame.new(np) * CFrame.Angles(0, DesyncState.camAngX, 0)
                    end
                else
                    cloneRoot.CFrame = CFrame.new(np) * CFrame.Angles(0, DesyncState.camAngX, 0)
                end
            else
                cloneRoot.CFrame = CFrame.new(cloneRoot.Position) * CFrame.Angles(0, DesyncState.camAngX, 0)
            end
            if (DesyncState.keys.Space or UserInputService:IsKeyDown(Enum.KeyCode.Space)) and not Settings.FlyEnabled then
                cloneRoot.CFrame = cloneRoot.CFrame + Vector3.new(0, 1.8, 0)
            end
            cloneRoot.AssemblyLinearVelocity = Vector3.zero
            cloneRoot.AssemblyAngularVelocity = Vector3.zero
        end
    end
end))

