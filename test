local function standDoM1Counter(tRoot, targetChar)
    if standM1Busy then return end
    if tick() - lastStandM1 < 0.28 then return end
    standM1Busy = true
    lastStandM1 = tick()
    standSkillFrontUntil = tick() + 0.45

    task.spawn(function()
        local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if myRoot and tRoot and tRoot.Parent then
            -- мгновенный телек вперёд (магнит)
            local look = tRoot.CFrame.LookVector
            local right = tRoot.CFrame.RightVector
            local desired = tRoot.Position + look * 2.3 + right * 0.85 + Vector3.new(0, 0.4, 0)
            local lookFwd = tRoot.Position + look * 12 + Vector3.new(0, 1, 0)
            myRoot.CFrame = CFrame.lookAt(desired, lookFwd)
            myRoot.AssemblyLinearVelocity = Vector3.zero
            myRoot.AssemblyAngularVelocity = Vector3.zero
