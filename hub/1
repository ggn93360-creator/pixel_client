}
local previews = {}
local function esU() for _, p in ipairs(previews) do pcall(p.refresh) end end

do
	-- ---------- общий виджет: рисует ОДНОГО игрока (реальный ESP и превью используют один код) ----------
	local EDGES = {{1, 2}, {3, 4}, {5, 6}, {7, 8}, {1, 3}, {2, 4}, {5, 7}, {6, 8}, {1, 5}, {2, 6}, {3, 7}, {4, 8}}
	local R15_BONES = {{"Head", "UpperTorso"}, {"UpperTorso", "LowerTorso"}, {"UpperTorso", "LeftUpperArm"},
		{"LeftUpperArm", "LeftLowerArm"}, {"LeftLowerArm", "LeftHand"}, {"UpperTorso", "RightUpperArm"},
		{"RightUpperArm", "RightLowerArm"}, {"RightLowerArm", "RightHand"}, {"LowerTorso", "LeftUpperLeg"},
		{"LeftUpperLeg", "LeftLowerLeg"}, {"LeftLowerLeg", "LeftFoot"}, {"LowerTorso", "RightUpperLeg"},
		{"RightUpperLeg", "RightLowerLeg"}, {"RightLowerLeg", "RightFoot"}}
	local R6_BONES = {{"Head", "Torso"}, {"Torso", "Left Arm"}, {"Torso", "Right Arm"}, {"Torso", "Left Leg"}, {"Torso", "Right Leg"}}

	-- 8 углов 3D-бокса по реальному bounding box модели. P(world) -> Vector2 | nil
	local function boxCorners(model, P)
		local cf, size = model:GetBoundingBox()
		local pts = {}
		for i = 0, 7 do
			local sx = (i % 2 == 0) and -1 or 1
			local sy = (math.floor(i / 2) % 2 == 0) and -1 or 1
			local sz = (i >= 4) and 1 or -1
			local p = P((cf * CFrame.new(sx * size.X / 2, sy * size.Y / 2, sz * size.Z / 2)).Position)
			if not p then return nil end
			pts[i + 1] = p
		end
		return pts
	end
	local function boneLines(model, P)
		local set = model:FindFirstChild("UpperTorso") and R15_BONES or R6_BONES
		local out = {}
		for _, b in ipairs(set) do
			local p1, p2 = model:FindFirstChild(b[1]), model:FindFirstChild(b[2])
			if p1 and p2 then
				local a, c = P(p1.Position), P(p2.Position)
				if a and c then out[#out + 1] = {a, c} end
			end
		end
		return out
	end

	local function makeWidget(parent, scaleMode)
		local W, objs = {}, {}
		local function add(o) table.insert(objs, o); return o end
		local curVW, curVH = 1, 1
		local function U(x, y, ox, oy)
			if scaleMode then return UDim2.new(x, ox or 0, y, oy or 0) end
			return UDim2.fromOffset(x + (ox or 0), y + (oy or 0))
		end
		local function SZ(w, h, ow, oh)
			if scaleMode then return UDim2.new(w, ow or 0, h, oh or 0) end
			return UDim2.fromOffset(w + (ow or 0), h + (oh or 0))
		end

		local box = add(new("Frame", {BackgroundColor3 = WHITE, Visible = false, ZIndex = 2}, parent))
		local stroke = new("UIStroke", {Color = WHITE, Thickness = 1}, box)
		local bars = {}
		for cx = 0, 1 do
			for cy = 0, 1 do
				local function mk(w, h)
					return new("Frame", {BackgroundColor3 = WHITE, AnchorPoint = Vector2.new(cx, cy),
						Position = UDim2.fromScale(cx, cy), Size = UDim2.fromOffset(w, h), Visible = false}, box)
				end
				table.insert(bars, {mk(14, 1), mk(1, 14)})
			end
		end
		local function lbl(size, color, anchor)
			return add(new("TextLabel", {BackgroundTransparency = 1, Font = Enum.Font.GothamBold, TextSize = size,
				TextColor3 = color, TextStrokeTransparency = 0.45, Size = UDim2.fromOffset(220, 14), AnchorPoint = anchor,
				Visible = false, ZIndex = 3}, parent))
		end
		local nameL = lbl(12, WHITE, Vector2.new(0.5, 1))
		local distL = lbl(11, rgb(200, 200, 215), Vector2.new(0.5, 0))
		local itemL = lbl(11, rgb(255, 220, 120), Vector2.new(0.5, 0))
		local hpBg = add(new("Frame", {BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0.35,
			Visible = false, ZIndex = 3}, parent))
		local hpFill = new("Frame", {AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1),
			Size = UDim2.fromScale(1, 1)}, hpBg)
		local tracer = add(new("Frame", {AnchorPoint = Vector2.new(0.5, 0.5), Visible = false, ZIndex = 1}, parent))
		local dot = add(new("Frame", {AnchorPoint = Vector2.new(0.5, 0.5), Visible = false, ZIndex = 4}, parent))
		corner(dot, 50)
		local lines = {}
		for i = 1, 14 do
			lines[i] = add(new("Frame", {AnchorPoint = Vector2.new(0.5, 0.5), Visible = false, ZIndex = 2}, parent))
		end

		local function setLine(f, a, b, th, col, trans)
			local sx, sy = scaleMode and curVW or 1, scaleMode and curVH or 1
			local dx, dy = (b.X - a.X) * sx, (b.Y - a.Y) * sy
			local len = math.sqrt(dx * dx + dy * dy)
			f.Size = scaleMode and UDim2.new(len / curVW, 0, 0, th) or UDim2.fromOffset(len, th)
			f.Position = U((a.X + b.X) / 2, (a.Y + b.Y) / 2)
			f.Rotation = math.deg(math.atan2(dy, dx))
			f.BackgroundColor3 = col
			f.BackgroundTransparency = trans or 0
			f.Visible = true
		end

		function W.hide() for _, o in ipairs(objs) do o.Visible = false end end
		function W.destroy() for _, o in ipairs(objs) do o:Destroy() end end

		-- i: x,y,w,h, name, dist, item, hp(0..1), vis, online, ox,oy (начало трейсера), hx,hy (голова), c3d (8 точек), bones
		function W.update(i, vw, vh)
			curVW, curVH = vw or 1, vh or 1
			local col = (i.vis or not ESP.visCheck) and ESP.colVis or ESP.colWall
			local st = ESP.style
			local is2D = st == "Box" or st == "Corner" or st == "Filled"
			box.Visible = is2D
			if is2D then
				local isCorner = st == "Corner"
				box.Position = U(i.x, i.y)
				box.Size = SZ(i.w, i.h)
				stroke.Enabled = not isCorner
				stroke.Color = col
				stroke.Thickness = ESP.thick
				box.BackgroundColor3 = col
				box.BackgroundTransparency = isCorner and 1 or (1 - ESP.fill / 100 * (st == "Filled" and 0.85 or 0.45))
				for _, b in ipairs(bars) do
					for k = 1, 2 do b[k].Visible = isCorner; b[k].BackgroundColor3 = col end
					b[1].Size = UDim2.fromOffset(14, ESP.thick)
					b[2].Size = UDim2.fromOffset(ESP.thick, 14)
				end
			end
			-- линии: 3D Box / Skeleton
			local n = 0
			if st == "3D Box" and i.c3d then
				for _, e in ipairs(EDGES) do n += 1; setLine(lines[n], i.c3d[e[1]], i.c3d[e[2]], ESP.thick, col) end
			elseif st == "Skeleton" and i.bones then
				for _, bl in ipairs(i.bones) do
					n += 1
					if lines[n] then setLine(lines[n], bl[1], bl[2], ESP.thick, col) end
				end
			end
			for k = n + 1, #lines do lines[k].Visible = false end

			local cx = i.x + i.w / 2
			nameL.Visible = ESP.name
			if ESP.name then
				nameL.Text = i.name
				nameL.Position = U(cx, i.y, 0, -3)
				nameL.TextColor3 = i.online and rgb(120, 255, 160) or WHITE
			end
			local yo = 2
			distL.Visible = ESP.dist
			if ESP.dist then distL.Text = i.dist; distL.Position = U(cx, i.y + i.h, 0, yo); yo += 13 end
			itemL.Visible = ESP.item
			if ESP.item then itemL.Text = i.item; itemL.Position = U(cx, i.y + i.h, 0, yo) end
			hpBg.Visible = ESP.health
			if ESP.health then
				hpBg.Position = U(i.x, i.y, -7, 0)
				hpBg.Size = SZ(0, i.h, 3, 0)
				hpFill.Size = UDim2.fromScale(1, math.clamp(i.hp, 0, 1))
				hpFill.BackgroundColor3 = Color3.fromHSV(math.clamp(i.hp, 0, 1) * 0.33, 0.8, 1)
			end
			tracer.Visible = ESP.tracers
			if ESP.tracers then
				setLine(tracer, Vector2.new(i.ox, i.oy), Vector2.new(cx, i.y + i.h), ESP.trThick, ESP.trColor, ESP.trAlpha / 100)
			end
			dot.Visible = ESP.headDot and i.hx ~= nil
			if dot.Visible then
				dot.Position = U(i.hx, i.hy)
				dot.Size = UDim2.fromOffset(ESP.dotSize * 2, ESP.dotSize * 2)
				dot.BackgroundColor3 = ESP.dotColor
			end
		end
		return W
	end

	-- ---------- РЕАЛЬНЫЙ ESP (GUI-боксы, не Highlight) ----------
	local espGui = new("ScreenGui", {Name = "PixelESP", ResetOnSpawn = false, IgnoreGuiInset = true,
		DisplayOrder = 900, ZIndexBehavior = Enum.ZIndexBehavior.Sibling}, getParent())
	local espLayer = new("Frame", {BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1)}, espGui)
	local espObjs = {}
	local espRay = RaycastParams.new()
	espRay.FilterType = Enum.RaycastFilterType.Exclude
	local curCam

	local function projReal(p)
		local v = curCam:WorldToViewportPoint(p)
		if v.Z <= 0 then return nil end
		return Vector2.new(v.X, v.Y)
	end

	local function detectClass(char)
		for _, o in ipairs(char:GetChildren()) do
			if o:IsA("Tool") or o:IsA("Model") then
				local n = string.lower(o.Name)
				if n:find("saitama") or n:find("caped") then return "Saitama" end
				if n:find("garou") then return "Garou" end
				if n:find("genos") then return "Genos" end
				if n:find("sonic") then return "Sonic" end
				if n:find("metal") then return "Metal Bat" end
				if n:find("atomic") then return "Atomic" end
				if n:find("tatsumaki") or n:find("tornado") then return "Tatsumaki" end
			end
		end
		local a = char:GetAttribute("Character") or char:GetAttribute("Char")
		return a and tostring(a) or nil
	end

	local function espGet(plr)
		local d = espObjs[plr]
		if d then return d end
		d = {W = makeWidget(espLayer, false), hl = Instance.new("Highlight"), vis = true, visT = 0}
		d.hl.Enabled = false
		espObjs[plr] = d
		return d
	end
	connect(Players.PlayerRemoving, function(plr)
		local d = espObjs[plr]
		if d then d.W.destroy(); d.hl:Destroy(); espObjs[plr] = nil end
	end)

	connect(RunService.RenderStepped, function()
		local cam = workspace.CurrentCamera
		if not ESP.enabled or not cam then
			for _, d in pairs(espObjs) do d.W.hide(); d.hl.Enabled = false end
			return
		end
		curCam = cam
		local myChar, myRoot = getChar(), getRoot()
		local vp = cam.ViewportSize
		local now = os.clock()
		for _, plr in ipairs(Players:GetPlayers()) do
			if plr ~= LP then
				local d = espGet(plr)
				local ch = plr.Character
				local root = ch and ch:FindFirstChild("HumanoidRootPart")
				local hum = ch and ch:FindFirstChildOfClass("Humanoid")
				local head = ch and ch:FindFirstChild("Head")
				local shown = false
				if root and hum and head and hum.Health > 0 and not (ESP.team and plr.Team ~= nil and plr.Team == LP.Team) then
					local dist = myRoot and (root.Position - myRoot.Position).Magnitude or 0
					if dist <= ESP.maxDist then
						local top = cam:WorldToViewportPoint(head.Position + Vector3.new(0, head.Size.Y / 2 + 0.15, 0))
						local feetOff = hum.RigType == Enum.HumanoidRigType.R15 and (hum.HipHeight + root.Size.Y / 2) or 3
						local bot = cam:WorldToViewportPoint(root.Position - Vector3.new(0, feetOff, 0))
						if top.Z > 0 and bot.Z > 0 and bot.Y - top.Y > 3 then
							if now - d.visT > 0.15 then -- проверка "за стеной", не каждый кадр
								d.visT = now
								espRay.FilterDescendantsInstances = {myChar, ch}
								local o = cam.CFrame.Position
								d.vis = workspace:Raycast(o, root.Position - o, espRay) == nil
							end
							local h = bot.Y - top.Y
							local w = h * 0.55
							local isPixel = Pixel.PixelUsers[plr.UserId] ~= nil
							local nm = plr.DisplayName .. (isPixel and " [PIXEL]" or "")
							if ESP.cls then
								local c = detectClass(ch)
								if c then nm = nm .. " · " .. c end
							end
							local tool = ch:FindFirstChildOfClass("Tool")
							local origin
							if ESP.trOrigin == "Bottom" then origin = Vector2.new(vp.X / 2, vp.Y)
							elseif ESP.trOrigin == "Center" then origin = vp / 2
							else origin = UIS:GetMouseLocation() end
							local info = {
								x = (top.X + bot.X) / 2 - w / 2, y = top.Y, w = w, h = h, name = nm,
								dist = math.floor(dist) .. "m", item = tool and ("[" .. tool.Name .. "]") or "[-]",
								hp = hum.Health / math.max(hum.MaxHealth, 1), vis = d.vis, online = isPixel,
								ox = origin.X, oy = origin.Y, hx = top.X, hy = top.Y + h * 0.04,
							}
							if ESP.style == "3D Box" then info.c3d = boxCorners(ch, projReal)
							elseif ESP.style == "Skeleton" then info.bones = boneLines(ch, projReal) end
							d.W.update(info, vp.X, vp.Y)
							shown = true
						end
					end
				end
				if not shown then d.W.hide() end
				local hl = d.hl
				if ESP.chams and shown then
					if hl.Parent ~= ch then hl.Parent = ch; hl.Adornee = ch end
					hl.Enabled = true
					hl.FillColor = ESP.chamsFill
					hl.OutlineColor = ESP.chamsOutline
					local pulse = ESP.chamsPulse and (math.sin(now * 3) + 1) / 2 * 0.3 or 0
					hl.FillTransparency = math.clamp(ESP.chamsAlpha / 100 + pulse, 0, 1)
					hl.OutlineTransparency = 0
					hl.DepthMode = ESP.through and Enum.HighlightDepthMode.AlwaysOnTop or Enum.HighlightDepthMode.Occluded
				else
					hl.Enabled = false
				end
			end
		end
	end)
	Win:OnUnload(function()
		for _, d in pairs(espObjs) do pcall(function() d.hl:Destroy() end) end
		espGui:Destroy()
	end)

	-- ---------- ПРЕВЬЮ НА ТЕБЕ (боковая панель справа от меню) ----------
	local esp = visuals:AddTab("ESP")
	local side = Win.Side
	local sideShown = false

	txt("TextLabel", {BackgroundTransparency = 1, TextSize = 15, Text = "ESP Preview", TextColor3 = Theme.Text,
		TextXAlignment = Enum.TextXAlignment.Left, Position = UDim2.fromOffset(16, 12), Size = UDim2.new(1, -32, 0, 20)}, side, "Bold")
	txt("TextLabel", {BackgroundTransparency = 1, TextSize = 11, Text = "Это ты. Клик по сцене: видим / за стеной", TextColor3 = Theme.SubText,
		TextXAlignment = Enum.TextXAlignment.Left, Position = UDim2.fromOffset(16, 32), Size = UDim2.new(1, -32, 0, 14)}, side, "Regular")

	local stage = new("ViewportFrame", {BackgroundColor3 = rgb(12, 12, 20), BackgroundTransparency = 0.2,
		Size = UDim2.new(1, -24, 1, -68), Position = UDim2.fromOffset(12, 56), ClipsDescendants = true,
		Ambient = rgb(150, 150, 170), LightColor = rgb(255, 246, 236), LightDirection = Vector3.new(-0.4, -1, -0.6)}, side)
	corner(stage, 10)
	local wm = new("WorldModel", {}, stage)
	local cam = new("Camera", {FieldOfView = 38}, stage)
	stage.CurrentCamera = cam
	local overlay = new("TextButton", {Text = "", AutoButtonColor = false, BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1), ZIndex = 5}, stage)
	local widget = makeWidget(overlay, true)
	local tag = txt("TextLabel", {BackgroundTransparency = 1, TextSize = 10, Text = "", TextColor3 = Theme.SubText, ZIndex = 8,
