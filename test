        hint.Size = UDim2.new(1, 0, 0, 18)
        hint.BackgroundTransparency = 1
        hint.Text = "Бинд: ЛКМ на клавишу справа · ПКМ сброс"
        hint.TextColor3 = COLOR_TEXT_MUTED
        hint.Font = MAIN_FONT
        hint.TextSize = 11
        hint.TextXAlignment = Enum.TextXAlignment.Left
    end

    local open = false
    local function setOpen(state)
        open = state
        arrowBtn.Text = open and "▼" or "▶"
        body.Visible = open
        local h = open and (bodyLayout.AbsoluteContentSize.Y + 10) or 0
        TweenService:Create(body, TweenInfo.new(0.2, Enum.EasingStyle.Quad), {
            Size = UDim2.new(1, -4, 0, h)
        }):Play()
        TweenService:Create(wrap, TweenInfo.new(0.2, Enum.EasingStyle.Quad), {
            Size = UDim2.new(1, -6, 0, 34 + (open and h + 2 or 0))
        }):Play()
        if not open then
            task.delay(0.22, function()
                if not open then body.Visible = false end
            end)
        end
    end

    UnloadSystem:TrackConnection(arrowBtn.MouseButton1Click:Connect(function()
        setOpen(not open)
    end))
    UnloadSystem:TrackConnection(bodyLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        if open then
            local h = bodyLayout.AbsoluteContentSize.Y + 10
            body.Size = UDim2.new(1, -4, 0, h)
            wrap.Size = UDim2.new(1, -6, 0, 34 + h + 2)
        end
    end))

    local function updateVisual()
        local active = Settings[settingKey]
        local ti = TweenInfo.new(0.22, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
        if active then
            TweenService:Create(switch, TweenInfo.new(0.18), { BackgroundColor3 = COLOR_ACCENT }):Play()
            TweenService:Create(knob, ti, {
                Position = UDim2.new(1, -17, 0.5, -7)
            }):Play()
            statusText.Text = "ON"
            statusText.TextColor3 = COLOR_TITLE
        else
            TweenService:Create(switch, TweenInfo.new(0.18), { BackgroundColor3 = Color3.fromRGB(230, 190, 205) }):Play()
            TweenService:Create(knob, ti, {
                Position = UDim2.new(0, 3, 0.5, -7)
            }):Play()
            statusText.Text = "OFF"
            statusText.TextColor3 = COLOR_TEXT_MUTED
        end
        -- лёгкий pulse строки
        local wrapScale = wrap:FindFirstChild("RowScale")
        if not wrapScale then
            wrapScale = Instance.new("UIScale")
            wrapScale.Name = "RowScale"
            wrapScale.Parent = wrap
        end
        wrapScale.Scale = 0.98
        TweenService:Create(wrapScale, TweenInfo.new(0.2, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
        local bindKey = Settings.Binds[settingKey]
        bindBtn.Text = bindKey and bindKey.Name or "-"
    end

    UI_Toggles[settingKey] = updateVisual
    updateVisual()

    UnloadSystem:TrackConnection(switch.MouseButton1Click:Connect(function()
        toggleSetting(settingKey)
        SaveConfig()
        if callback then callback() end
    end))

    local function startBinding()
        -- Телефон: добавить/убрать кнопку на QuickBar
        if PLATFORM.IsMobile or UserInputService.TouchEnabled then
            if type(Settings.MobileBinds) ~= "table" then Settings.MobileBinds = {} end
            local list = Settings.MobileBinds
            local found = nil
            for i, k in ipairs(list) do
                if k == settingKey then found = i break end
            end
            if found then
                table.remove(list, found)
            else
                table.insert(list, settingKey)
            end
            refreshBindBtn()
            pcall(function() if _G.PixelRebuildQuickBar then _G.PixelRebuildQuickBar() end end)
            pcall(function() if SaveConfig then SaveConfig() end end)
            return
        end
        -- ПК: назначить клавишу
        currentlyBindingFeature = settingKey
        bindBtn.Text = "..."
        bindBtn.TextColor3 = COLOR_TITLE
        task.spawn(function()
            while currentlyBindingFeature == settingKey do task.wait(0.05) end
            updateVisual()
            refreshBindBtn()
            pcall(function() if SaveConfig then SaveConfig() end end)
        end)
    end

    UnloadSystem:TrackConnection(bindBtn.MouseButton1Click:Connect(startBinding))
    UnloadSystem:TrackConnection(bindBtn.MouseButton2Click:Connect(function()
        if PLATFORM.IsMobile or UserInputService.TouchEnabled then
            -- ПКМ не нужен на телефоне
            return
        end
        if Settings.Binds then Settings.Binds[settingKey] = nil end
        updateVisual()
        refreshBindBtn()
        pcall(function() if SaveConfig then SaveConfig() end end)
    end))

    return wrap
end

