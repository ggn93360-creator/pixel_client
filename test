        brim.CanCollide = false
        brim.Massless = true
        brim.Material = Enum.Material.SmoothPlastic
        brim.Color = Color3.fromRGB(45, 32, 22)
        brim.Size = Vector3.new(2.4, 0.12, 2.4)
