        pcall(function() if esp.Highlight then esp.Highlight:Destroy() end end)
    else
        for k, obj in pairs(esp) do
            if k ~= "Mobile" then
                pcall(function() obj:Remove() end)
            end
        end
    end
    ESP_Cache[player] = nil
end

-- Статичный бокс ESP (не зависит от размера модели / хитбокса)
local function GetStaticESPBox(root, cam)
    if not root or not cam then return nil end
    local pos, onScreen = cam:WorldToViewportPoint(root.Position)
    if not onScreen or pos.Z <= 0 then return nil end
    local dist = math.max(pos.Z, 1)
    -- фиксированные пропорции человека, масштаб только от дистанции (кламп)
    local scale = math.clamp(55 / dist, 0.25, 1.8)
    local w = 36 * scale
    local h = 64 * scale
    local boxPos = Vector2.new(pos.X - w * 0.5, pos.Y - h * 0.55)
    return boxPos, Vector2.new(w, h)
end

local function Get2DBoundingBox(char, cam)
    local cf, size = char:GetBoundingBox()
    local half = size * 0.5
    local corners = {
        cf * Vector3.new(-half.X,  half.Y, -half.Z),
        cf * Vector3.new( half.X,  half.Y, -half.Z),
        cf * Vector3.new(-half.X, -half.Y, -half.Z),
        cf * Vector3.new( half.X, -half.Y, -half.Z),
        cf * Vector3.new(-half.X,  half.Y,  half.Z),
        cf * Vector3.new( half.X,  half.Y,  half.Z),
        cf * Vector3.new(-half.X, -half.Y,  half.Z),
        cf * Vector3.new( half.X, -half.Y,  half.Z),
    }

    local minX, minY = math.huge, math.huge
    local maxX, maxY = -math.huge, -math.huge
    local anyVisible = false

    for i = 1, 8 do
        local pos, onScreen = cam:WorldToViewportPoint(corners[i])
        if onScreen then anyVisible = true end
        if pos.X < minX then minX = pos.X end
        if pos.Y < minY then minY = pos.Y end
        if pos.X > maxX then maxX = pos.X end
        if pos.Y > maxY then maxY = pos.Y end
    end

    if not anyVisible or minX == math.huge then return nil end
    return Vector2.new(minX, minY), Vector2.new(maxX - minX, maxY - minY)
end

