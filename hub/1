	local Items, ByName = {}, {}
	local function addItem(name, def)
		local S = {color = def.color or rgb(255, 150, 215), color2 = def.color2 or WHITE, material = def.material or "Neon",
			scale = 1, ox = 0, oy = 0, oz = 0, rot = 0, anim = true, alpha = 0,
			hue = 0, sat = 1, val = 1, rainbow = false, rbSpeed = 0.25}
		for k, v in pairs(def.defaults or {}) do S[k] = v end
		local it = {name = name, def = def, S = S, on = false}
		Items[#Items + 1] = it
		ByName[name] = it
		return it
	end
	local function findAttach(char, name)
		if name == "Head" then return char:FindFirstChild("Head") end
		if name == "Torso" then return char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso") end
		if name == "LArm" then return char:FindFirstChild("LeftLowerArm") or char:FindFirstChild("Left Arm") end
		if name == "RArm" then return char:FindFirstChild("RightLowerArm") or char:FindFirstChild("Right Arm") end
		return char:FindFirstChild("HumanoidRootPart")
	end
	local function destroyItem(it)
		if it.env then
			if it.def.cleanup then pcall(it.def.cleanup, it.env) end
			pcall(function() it.env.model:Destroy() end)
		end
		it.env = nil
	end
	local function buildItem(it)
		destroyItem(it)
		if not it.on then return end
		local char = getChar()
		if not char then return end
		local def, S = it.def, it.S
		local part = findAttach(char, def.attach or "Head")
		if not part then return end
		local model = Instance.new("Model")
		model.Name = "PixelItem"
		local rootP = mkPart(Vector3.new(0.2, 0.2, 0.2), WHITE, Enum.Material.SmoothPlastic, 1, model)
		local base = (def.base and def.base(part, S) or CFrame.new()) * CFrame.new(S.ox, S.oy, S.oz) * CFrame.Angles(0, math.rad(S.rot), 0)
		local w = weld(part, rootP, base)
		local env = {S = S, model = model, root = rootP, weld = w, base = base, part = part, char = char, st = {}, parts = {}}
		curEnv = env
		local ok, err = pcall(def.build, rootP, model, S.scale, env)
		curEnv = nil
		if not ok then warn("[Pixel] " .. it.name .. ": " .. tostring(err)) end
		model.Parent = char
		it.env = env
	end
	local function queueItem(it)
		if it.q then return end
		it.q = true
		task.delay(0.12, function() it.q = false; if it.on then buildItem(it) end end)
	end

