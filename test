-- ===== SHADOW FEINT (R6 anim) =====
local shadowFeintTrack = nil
local shadowFeintConn = nil
-- R6-friendly combat / feint style animations (пробуем по очереди)
local SHADOW_FEINT_ANIMS = {
    "rbxassetid://7546562001", -- combat pose-ish
    "rbxassetid://522635514",  -- classic tool slash
    "rbxassetid://180435571",  -- r6 idle fallback
}

local function stopShadowFeint()
    if shadowFeintConn then
        pcall(function() shadowFeintConn:Disconnect() end)
        shadowFeintConn = nil
    end
    if shadowFeintTrack then
        pcall(function() shadowFeintTrack:Stop(0.15) end)
        shadowFeintTrack = nil
    end
    -- вернуть прозрачность
    local char = LocalPlayer.Character
    if char then
        for _, p in ipairs(char:GetDescendants()) do
            if p:IsA("BasePart") and p.Name ~= "HumanoidRootPart" then
                if p:GetAttribute("SF_OrigTrans") ~= nil then
                    p.LocalTransparencyModifier = 0
                    p:SetAttribute("SF_OrigTrans", nil)
                end
            end
        end
    end
end

local function startShadowFeint()
    stopShadowFeint()
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    if hum.RigType ~= Enum.HumanoidRigType.R6 then
        if PushMessage then PushMessage("Shadow Feint", "Нужен R6 аватар", 2) end
        Settings.ShadowFeint = false
        if UI_Toggles["ShadowFeint"] then UI_Toggles["ShadowFeint"]() end
        return
    end

    local animator = hum:FindFirstChildOfClass("Animator")
    if not animator then
        animator = Instance.new("Animator")
        animator.Parent = hum
    end

    for _, id in ipairs(SHADOW_FEINT_ANIMS) do
        local ok, track = pcall(function()
            local anim = Instance.new("Animation")
            anim.AnimationId = id
            local t = animator:LoadAnimation(anim)
            t.Priority = Enum.AnimationPriority.Action4
            t.Looped = true
            t:Play(0.1, 1, 1.15)
            return t
        end)
        if ok and track then
            shadowFeintTrack = track
            break
        end
    end

    -- shadow pulse (лёгкий фантом)
    shadowFeintConn = RunService.Heartbeat:Connect(function()
        if not Settings.ShadowFeint then
            stopShadowFeint()
            return
        end
        local c = LocalPlayer.Character
        if not c then return end
        local pulse = 0.15 + math.abs(math.sin(tick() * 4)) * 0.25
        for _, p in ipairs(c:GetDescendants()) do
            if p:IsA("BasePart") and p.Name ~= "HumanoidRootPart" then
                p.LocalTransparencyModifier = pulse
            end
        end
        if shadowFeintTrack and not shadowFeintTrack.IsPlaying then
            pcall(function() shadowFeintTrack:Play(0.1, 1, 1.15) end)
        end
    end)
    UnloadSystem:TrackConnection(shadowFeintConn)
end

