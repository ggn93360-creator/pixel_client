local function FaceTarget(targetRoot)
    local char = LocalPlayer.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end

    local currentPos = root.Position
    local targetPos = targetRoot.Position
    local lookDirection = Vector3.new(targetPos.X, currentPos.Y, targetPos.Z)
    root.CFrame = CFrame.lookAt(currentPos, lookDirection)
end

local function IsValidAnimation(track)
    if not track then return false end
    local priority = track.Priority
    if priority == Enum.AnimationPriority.Core or
       priority == Enum.AnimationPriority.Idle or
       priority == Enum.AnimationPriority.Movement then
        return false
    end

    local name = string.lower(tostring(track.Name))
    local animObj = track.Animation
    local animName = animObj and string.lower(tostring(animObj.Name)) or ""

    local blockedKeywords = {
        "walk", "run", "sprint", "jog", "move", "moving", "dash", "dodge", "step", "roll",
        "slide", "evade", "flashstep", "backstep", "sidestep", "teleport", "vanish", "leap",
        "guard", "block", "parry", "defend", "shield", "deflect", "idle", "sit", "climb"
    }

    for _, keyword in ipairs(blockedKeywords) do
        if name:find(keyword) or animName:find(keyword) then return false end
    end
    return true
end

local function MonitorPlayer(player)
    if player == LocalPlayer then return end
    local function setup(char)
        local hum = char:WaitForChild("Humanoid", 5)
        local animator = hum and hum:WaitForChild("Animator", 5)
        if not animator then return end
        
        UnloadSystem:TrackConnection(animator.AnimationPlayed:Connect(function(track)
            if Settings.IgnoreFriends and IsFriend(player) then return end
            if not Settings.AutoF or currentTarget ~= char then return end

            if IsValidAnimation(track) then
                task.spawn(function()
                    if Settings.ReactionDelay > 0 then task.wait(Settings.ReactionDelay) end
                    if not Settings.AutoF or currentTarget ~= char then return end

                    if not isBlocking then
                        isBlocking = true
                        currentBlockTrack = track
                        pcall(function() VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.F, false, game) end)
                        
                        task.delay(Settings.BlockDuration, function()
                            if isBlocking and currentBlockTrack == track then
                                isBlocking = false
                                currentBlockTrack = nil
                                pcall(function() VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.F, false, game) end)
                            end
                        end)
                    end
                end)
            end
        end))
    end
    UnloadSystem:TrackConnection(player.CharacterAdded:Connect(setup))
    if player.Character then setup(player.Character) end
end

for _, p in pairs(Players:GetPlayers()) do MonitorPlayer(p) end
