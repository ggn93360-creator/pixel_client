	local function spawnWave(char, mult)
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if not hrp or not hum then return end
		rayParams.FilterDescendantsInstances = {char, fxFolder}
		local res = workspace:Raycast(hrp.Position, Vector3.new(0, -12, 0), rayParams)
		local pos = res and (res.Position + Vector3.new(0, 0.1, 0)) or (hrp.Position - Vector3.new(0, hum.HipHeight + hrp.Size.Y / 2, 0))
		local colA, colB = JW.colA, JW.colB
		if JW.rainbow then
			local h = (os.clock() * 0.25) % 1
			colA, colB = Color3.fromHSV(h, 0.6, 1), Color3.fromHSV((h + 0.14) % 1, 0.75, 1)
		end
		local R, life, style = JW.size * mult, JW.life, JW.style
		local model = new("Model", {Name = "Wave"}, fxFolder)
		local function ap(size, color, shape, mesh)
			local p = new("Part", {Anchored = true, CanCollide = false, CanQuery = false, CanTouch = false, CastShadow = false,
				Material = Enum.Material.Neon, Color = color, Size = size, Transparency = 1}, model)
			if shape then p.Shape = shape end
			if mesh then new("SpecialMesh", {MeshType = Enum.MeshType.Sphere}, p) end
			return p
		end
		local segs, N = {}, (style == "Spikes") and 24 or 44
		local dome
		if style == "Dome" then
			dome = ap(Vector3.new(1, 1, 1), colA, nil, true)
			segs[1] = ap(Vector3.new(0.3, 0.3, 0.3), colB)
			segs[1].Size = Vector3.new(0.3, 0.3, 0.3)
		else
			for i = 1, N do segs[i] = ap(Vector3.new(0.3, 0.3, 0.3), colA) end
		end
		task.spawn(function()
			local t0 = os.clock()
			while model.Parent do
				local a = (os.clock() - t0) / life
				if a >= 1 then break end
				local e = 1 - (1 - a) ^ 3 -- быстрый старт, плавное затухание
				local r = R * e
				local fade = a ^ 2
				local col = colA:Lerp(colB, a)
				if style == "Dome" then
					dome.Size = Vector3.new(r * 2, r * 2 * JW.height * 0.6, r * 2)
					dome.CFrame = CFrame.new(pos)
					dome.Transparency = 0.35 + 0.65 * fade
					dome.Color = col
					segs[1].Size = Vector3.new(0.25 * JW.thick, 0.25 * JW.thick, math.max(r * 2 * math.pi / 16, 0.3))
					for _, s2 in ipairs({segs[1]}) do s2.Transparency = 1 end
				else
					local h = math.sin(a * math.pi) * JW.height * 1.4 + 0.15
					for i, p in ipairs(segs) do
						local th = (i - 1) / N * math.pi * 2
						local c, s2 = math.cos(th), math.sin(th)
						if style == "Spikes" then
							local hs = math.max(h * 1.6 * (1 - a * 0.5), 0.2)
							p.Size = Vector3.new(0.3 * JW.thick, hs, 0.3 * JW.thick)
							p.CFrame = CFrame.new(pos + Vector3.new(c * r, hs / 2, s2 * r))
						else
							local segLen = 2 * math.pi * math.max(r, 0.1) / N * 1.15
							p.Size = Vector3.new(0.35 * JW.thick * (1 - a * 0.5), h * 0.6 + 0.25, segLen)
							p.CFrame = CFrame.new(pos + Vector3.new(c * r, h * 0.3, s2 * r)) * CFrame.Angles(0, -th, 0)
						end
						p.Transparency = fade
						p.Color = col
					end
				end
