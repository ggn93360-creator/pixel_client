	local ringGrad = new("UIGradient", {Color = ColorSequence.new(AimV.color, AimV.color2)}, ringStroke)

	local aimRay = RaycastParams.new()
	aimRay.FilterType = Enum.RaycastFilterType.Exclude

	local function hideRing()
		discP.Transparency = 1; domeP.Transparency = 1; ringGui.Enabled = false
	end
	local function updateRing(root, t)
		if not (Cbt.aim and AimV.show and root) then hideRing() return end
		local r = math.max(2, Cbt.range)
		local pos = Vector3.new(root.Position.X, root.Position.Y - 2.9, root.Position.Z)
		if AimV.ground then
			aimRay.FilterDescendantsInstances = {getChar(), aimFolder}
			local res = workspace:Raycast(root.Position, Vector3.new(0, -12, 0), aimRay)
			if res then pos = res.Position + Vector3.new(0, 0.05, 0) end
		end
		local a = math.clamp(AimV.alpha + (AimV.pulse and 0.2 * math.sin(t * 3) or 0), 0, 1)
		local mat = Enum.Material[AimV.material] or Enum.Material.Neon
		local st = AimV.style
		discP.Transparency = (st == "Disc") and a or 1
		domeP.Transparency = (st == "Dome") and a or 1
		ringGui.Enabled = st == "Ring"
		if st == "Disc" then
			discP.Size = Vector3.new(AimV.thick, r * 2, r * 2)
			discP.CFrame = CFrame.new(pos + Vector3.new(0, AimV.thick / 2, 0)) * CFrame.Angles(0, 0, math.rad(90))
			discP.Material = mat; discP.Color = AimV.color
		elseif st == "Dome" then
			domeP.Size = Vector3.new(r * 2, r * math.clamp(AimV.thick * 3, 0.2, 2), r * 2)
			domeP.CFrame = CFrame.new(pos)
			domeP.Material = mat; domeP.Color = AimV.color
		else
			ringP.Size = Vector3.new(r * 2, 0.05, r * 2)
			ringP.CFrame = CFrame.new(pos)
			ringStroke.Thickness = math.clamp(AimV.thick * 60, 2, 60)
			ringStroke.Transparency = a
			ringGrad.Color = ColorSequence.new(AimV.color, AimV.color2)
			ringGrad.Rotation = (t * 40) % 360
		end
	end

	local function pickTarget(root)
		local cur = Cbt.target
		if Cbt.sticky and cur and cur.Parent then
			local h = cur.Parent:FindFirstChildOfClass("Humanoid")
			if h and h.Health > 0 and (cur.Position - root.Position).Magnitude <= Cbt.range * 1.15 then return cur end
		end
		local best, bd = nil, Cbt.range
		for _, plr in ipairs(Players:GetPlayers()) do
			local ch = plr ~= LP and plr.Character
			local r = ch and ch:FindFirstChild("HumanoidRootPart")
			local h = ch and ch:FindFirstChildOfClass("Humanoid")
			if r and h and h.Health > 0 then
				local d = (r.Position - root.Position).Magnitude
				if d < bd then best, bd = r, d end
			end
		end
		Cbt.target = best
		return best
	end

	local flyBV, flyBG, wasFly = nil, nil, false
	local function stopFly()
		if flyBV then flyBV:Destroy(); flyBV = nil end
		if flyBG then flyBG:Destroy(); flyBG = nil end
		if wasFly then
			wasFly = false
			local h = getHum()
			if h then h.PlatformStand = false end
		end
	end

	connect(RunService.Heartbeat, function()
		local hum, root = getHum(), getRoot()
		updateRing(root, os.clock())
		if Mov.speed and root and hum and not Mov.fly then
			local move = hum.MoveDirection
			if move.Magnitude > 0.05 then
				local dir = Vector3.new(move.X, 0, move.Z)
				if dir.Magnitude > 0.05 then
					dir = dir.Unit
					root.AssemblyLinearVelocity = Vector3.new(dir.X * Mov.speedVal, root.AssemblyLinearVelocity.Y, dir.Z * Mov.speedVal)
				end
			end
		end
		if Cbt.antifling and root and root.AssemblyLinearVelocity.Magnitude > 280 then
			root.AssemblyLinearVelocity = Vector3.zero
			root.AssemblyAngularVelocity = Vector3.zero
		end
		if Mov.fly and root and hum then
			wasFly = true
			if not flyBV then
				flyBV = new("BodyVelocity", {MaxForce = Vector3.new(9e9, 9e9, 9e9)}, root)
				flyBG = new("BodyGyro", {MaxTorque = Vector3.new(9e9, 9e9, 9e9), P = 3000}, root)
			end
			local cam = workspace.CurrentCamera
			local dir = Vector3.zero
			if UIS:IsKeyDown(Enum.KeyCode.W) then dir += cam.CFrame.LookVector end
			if UIS:IsKeyDown(Enum.KeyCode.S) then dir -= cam.CFrame.LookVector end
			if UIS:IsKeyDown(Enum.KeyCode.A) then dir -= cam.CFrame.RightVector end
			if UIS:IsKeyDown(Enum.KeyCode.D) then dir += cam.CFrame.RightVector end
			if UIS:IsKeyDown(Enum.KeyCode.Space) then dir += Vector3.yAxis end
			if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then dir -= Vector3.yAxis end
			if dir.Magnitude == 0 and hum.MoveDirection.Magnitude > 0.05 then dir = hum.MoveDirection end
			if dir.Magnitude > 0 then dir = dir.Unit * Mov.flyVal end
			flyBV.Velocity = dir
			flyBG.CFrame = cam.CFrame
			hum.PlatformStand = true
		else
			stopFly()
		end
	end)

	-- aim: доворот HRP к цели (работает и в Shift Lock)
	connect(RunService.RenderStepped, function()
		local hum, root = getHum(), getRoot()
		if not hum or not root then return end
		if Cbt.aim and not Mov.fly then
			local best = pickTarget(root)
			if best then
				hum.AutoRotate = false
				local flat = Vector3.new(best.Position.X, root.Position.Y, best.Position.Z)
				if (flat - root.Position).Magnitude > 0.05 then
					root.CFrame = root.CFrame:Lerp(CFrame.new(root.Position, flat), Cbt.smooth)
				end
			else
				hum.AutoRotate = true
			end
		elseif not hum.AutoRotate and not Mov.fly then
			hum.AutoRotate = true
		end
	end)

	connect(UIS.JumpRequest, function()
		if not Mov.jump then return end
		local hum = getHum()
		if hum then hum:ChangeState(Enum.HumanoidStateType.Jumping) end
	end)

	Win:OnUnload(function()
		stopFly()
		aimFolder:Destroy()
		local h = getHum()
		if h then h.PlatformStand = false; h.AutoRotate = true end
	end)
end

-- ======================= VISUALS: ESP =======================
local ESP = {
	enabled = false, style = "Box", colVis = rgb(80, 255, 140), colWall = rgb(255, 80, 120), visCheck = true,
	thick = 1, fill = 12, name = true, health = true, dist = true, item = false, cls = false, maxDist = 500, team = true,
	tracers = false, trOrigin = "Bottom", trColor = rgb(255, 80, 160), trThick = 1, trAlpha = 20,
	chams = false, chamsFill = rgb(150, 90, 255), chamsOutline = WHITE, chamsAlpha = 60, through = true, chamsPulse = false,
