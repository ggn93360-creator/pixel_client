	-- Суставы плечо-локоть-кисть; перья, кости пальцев и перепонка висят на костях и складываются вместе с ними.
	local function fan(n, t0, t1, a0, a1, l0, l1, w, z, c0, c1, shape, alpha, roll, thk)
		local out = {}
		for i = 0, n - 1 do
			local f = n > 1 and i / (n - 1) or 0
			out[#out + 1] = {t = t0 + (t1 - t0) * f, ang = a0 + (a1 - a0) * f, len = l0 + (l1 - l0) * f, wid = w, z = z,
				ct = c0 + (c1 - c0) * f, shape = shape or "sphere", alpha = alpha, roll = roll, thk = thk}
		end
		return out
	end
	local function cat(...)
		local out = {}
		for _, l in ipairs({...}) do for _, v in ipairs(l) do out[#out + 1] = v end end
		return out
	end

	-- Dragon: рука + 4 пальца из двух сегментов + перепонка между пальцами
	local function dragonSpec()
		local fingers = {{38, 4.6}, {8, 5.4}, {-22, 5.0}, {-52, 3.8}}
		local out3 = {}
		for i, fg in ipairs(fingers) do
			local a, L = fg[1], fg[2]
			local ar = math.rad(a)
			out3[#out3 + 1] = {t = 1, ang = a, len = L * 0.6, wid = 0.13, z = 0.03, ct = i / 4, shape = "cyl"}
			out3[#out3 + 1] = {t = 1, ox = L * 0.6 * math.cos(ar), oy = L * 0.6 * math.sin(ar), ang = a - 10, len = L * 0.42, wid = 0.08, z = 0.03, ct = i / 4, shape = "cyl"}
		end
		for i = 1, #fingers - 1 do
			local a1, a2 = fingers[i][1], fingers[i + 1][1]
			local Lm = (fingers[i][2] + fingers[i + 1][2]) / 2 * 0.82
			local wm = 2 * Lm * 0.5 * math.sin(math.rad(math.abs(a1 - a2) / 2)) + 0.5
			out3[#out3 + 1] = {t = 1, ang = (a1 + a2) / 2, len = Lm, wid = wm, z = -0.02, ct = 0.4 + i * 0.15, shape = "sphere", alpha = 0.3}
		end
		return {
			[1] = {{t = 0.5, ang = -75, len = 1.8, wid = 1.3, z = -0.02, ct = 0.1, shape = "sphere", alpha = 0.3}},
			[2] = {{t = 0.5, ang = -82, len = 2.9, wid = 2.3, z = -0.02, ct = 0.2, shape = "sphere", alpha = 0.3}},
			[3] = out3,
		}
	end
	-- Crystal: острые призмы (повёрнуты на 45° вокруг своей оси) веером по предплечью и кисти
	local function crystalSpec()
		local function sh(n, t0, t1, a0, a1, l0, l1, w, z, c0, c1) return fan(n, t0, t1, a0, a1, l0, l1, w, z, c0, c1, "block", nil, 45, w * 0.9) end
		return {
			[2] = cat(sh(6, 0.1, 0.95, -78, -68, 3.0, 3.8, 0.42, 0, 0.1, 0.5), sh(5, 0.15, 0.9, -90, -80, 2.0, 2.6, 0.34, -0.07, 0.2, 0.6)),
			[3] = cat(sh(6, 0.1, 1, -66, -26, 3.8, 2.8, 0.42, 0, 0.5, 1), sh(5, 0.15, 0.95, -82, -44, 2.6, 1.9, 0.34, -0.07, 0.6, 1),
				{{t = 1, ang = -8, len = 3.6, wid = 0.7, thk = 0.6, z = 0, ct = 1, shape = "block", roll = 45}}),
		}
	end
	-- Butterfly: 4 перекрывающихся лепестка + прожилки + пятна
	local function butterflySpec()
		local out = {
			{t = 0.6, ang = 30, len = 3.9, wid = 2.7, z = 0, ct = 0, shape = "sphere", alpha = 0.2},
			{t = 0.2, ang = 55, len = 2.7, wid = 2.1, z = -0.03, ct = 0.2, shape = "sphere", alpha = 0.2},
			{t = 0.6, ang = -28, len = 3.2, wid = 2.1, z = 0.03, ct = 1, shape = "sphere", alpha = 0.2},
			{t = 0.2, ang = -50, len = 2.2, wid = 1.5, z = 0, ct = 0.8, shape = "sphere", alpha = 0.2},
		}
		for _, a in ipairs({38, 28, 18, 8}) do out[#out + 1] = {t = 0.6, ang = a, len = 3.5, wid = 0.05, z = 0.05, ct = 1, shape = "cyl", alpha = 0.1} end
		for _, a in ipairs({-18, -28, -38}) do out[#out + 1] = {t = 0.6, ang = a, len = 2.9, wid = 0.05, z = 0.06, ct = 1, shape = "cyl", alpha = 0.1} end
		for _, sp in ipairs({{30, 2.2, 0.5}, {30, 1.2, 0.32}, {-28, 1.9, 0.4}}) do
			local r = math.rad(sp[1])
			out[#out + 1] = {t = 0.6, ox = sp[2] * math.cos(r), oy = sp[2] * math.sin(r), ang = sp[1], len = sp[3], wid = sp[3], thk = 0.05, z = 0.07, ct = 1, shape = "sphere", alpha = 0.05}
