local function StartCombatLoop()
local function FaceTarget(targetRoot)
    if not targetRoot then return end
    local char = LocalPlayer.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not root then return end

    local mode = math.clamp(tonumber(Settings.AimMode) or 3, 1, 3)
    -- 1 = только тело, 2 = только камера, 3 = тело + камера
    local useBody = (mode == 1 or mode == 3)
    local useCam = (mode == 2 or mode == 3)
    local smooth = tonumber(Settings.AimSmooth) or 0.45
    smooth = math.clamp(smooth, 0.1, 1)

    local currentPos = root.Position
    local targetPos = targetRoot.Position
    local head = targetRoot.Parent and targetRoot.Parent:FindFirstChild("Head")
    local aimAt = head and head.Position or (targetPos + Vector3.new(0, 1.5, 0))

    if useBody then
        if hum then hum.AutoRotate = false end
        local flat = Vector3.new(targetPos.X, currentPos.Y, targetPos.Z)
        if (flat - currentPos).Magnitude > 0.05 then
            local goal = CFrame.lookAt(currentPos, flat)
            root.CFrame = root.CFrame:Lerp(goal, math.clamp(smooth + 0.25, 0.2, 1))
        end
    else
        -- камера-only: тело само крутится
        if hum and not hum.AutoRotate then
            hum.AutoRotate = true
        end
    end

    if useCam and not Settings.TargetStrafe and not Settings.Desync then
        local cam = Workspace.CurrentCamera
        if cam then
            local camPos = cam.CFrame.Position
            local newCF = CFrame.lookAt(camPos, aimAt)
            cam.CFrame = cam.CFrame:Lerp(newCF, smooth)
        end
    end
end

local fpsCounter = 0
local lastFpsUpdate = time()
local currentFps = 60
local trackedHumanoids = {}
local recentCombat = {} -- [player] = lastTimeSeenInRange
local lastKillCheck = {} -- [player] = lastHealth to detect death without Died event

-- TSB-friendly kill detection: health drop + Died + CharacterRemoving
local function RegisterKillOnPlayer(player)
    if not player or player == LocalPlayer then return end
    if recentCombat[player] and (tick() - recentCombat[player]) < 4 then
        recentCombat[player] = nil
        lastKillCheck[player] = nil
        local pos = Vector3.zero
        pcall(function()
            local r = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
            if r then pos = r.Position end
        end)
        KillstreakManager:AddKill(pos)
    end
end

local function SetupKillTracking(player)
    if player == LocalPlayer then return end

    local function onChar(char)
        local hum = char:WaitForChild("Humanoid", 5)
        if not hum then return end

        UnloadSystem:TrackConnection(hum.Died:Connect(function()
            RegisterKillOnPlayer(player)
        end))

        UnloadSystem:TrackConnection(hum.HealthChanged:Connect(function(hp)
            local prev = lastKillCheck[player]
            lastKillCheck[player] = hp
            if prev and prev > 0 and hp <= 0 then
                RegisterKillOnPlayer(player)
            end
        end))
    end

    UnloadSystem:TrackConnection(player.CharacterAdded:Connect(onChar))
    if player.Character then onChar(player.Character) end

    UnloadSystem:TrackConnection(player.CharacterRemoving:Connect(function()
        -- если умер и персонаж удалился быстро (типично для TSB)
        local lastHp = lastKillCheck[player]
        if lastHp and lastHp <= 15 then
            RegisterKillOnPlayer(player)
        end
        lastKillCheck[player] = nil
    end))
end

for _, p in pairs(Players:GetPlayers()) do SetupKillTracking(p) end
UnloadSystem:TrackConnection(Players.PlayerAdded:Connect(SetupKillTracking))
UnloadSystem:TrackConnection(Players.PlayerRemoving:Connect(function(p)
    recentCombat[p] = nil
    lastKillCheck[p] = nil
end))

UnloadSystem:TrackConnection(RunService.RenderStepped:Connect(function(dt)
    KillstreakManager:CheckTimeout()
    Settings.Killstreak = KillstreakManager.CurrentStreak

    local cam = Workspace.CurrentCamera
    if cam then
