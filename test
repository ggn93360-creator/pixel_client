    UnloadSystem:TrackInstance(p)
    TweenService:Create(p, TweenInfo.new(0.8), {Transparency = 1}):Play()
    task.delay(0.85, function() pcall(function() p:Destroy() end) end)
end))

-- ===== SHADERS (Lighting effects) =====
local shaderFX = {}
local function clearShaders()
    for name, inst in pairs(shaderFX) do
        pcall(function() inst:Destroy() end)
        shaderFX[name] = nil
    end
end

local function applyShaders()
    -- Bloom
    if Settings.ShaderBloom then
        if not shaderFX.Bloom then
            local b = Instance.new("BloomEffect")
            b.Name = "PC_Bloom"
            b.Parent = Lighting
            shaderFX.Bloom = b
            UnloadSystem:TrackInstance(b)
        end
        shaderFX.Bloom.Size = Settings.ShaderBloomSize or 24
        shaderFX.Bloom.Intensity = Settings.ShaderBloomIntensity or 0.9
        shaderFX.Bloom.Threshold = 0.85
    elseif shaderFX.Bloom then
        shaderFX.Bloom:Destroy()
        shaderFX.Bloom = nil
    end

    -- ColorCorrection
    if Settings.ShaderCC then
        if not shaderFX.CC then
            local c = Instance.new("ColorCorrectionEffect")
            c.Name = "PC_CC"
            c.Parent = Lighting
            shaderFX.CC = c
            UnloadSystem:TrackInstance(c)
        end
        shaderFX.CC.Brightness = Settings.ShaderBrightness or 0
        shaderFX.CC.Contrast = Settings.ShaderContrast or 0
        shaderFX.CC.Saturation = Settings.ShaderSaturation or 0
        shaderFX.CC.TintColor = Color3.new(
            Settings.ShaderTintR or 1,
            Settings.ShaderTintG or 1,
            Settings.ShaderTintB or 1
        )
    elseif shaderFX.CC then
        shaderFX.CC:Destroy()
        shaderFX.CC = nil
    end

    -- DepthOfField
    if Settings.ShaderDoF then
        if not shaderFX.DoF then
            local d = Instance.new("DepthOfFieldEffect")
            d.Name = "PC_DoF"
            d.Parent = Lighting
            shaderFX.DoF = d
            UnloadSystem:TrackInstance(d)
        end
        shaderFX.DoF.FarIntensity = 0.35
        shaderFX.DoF.FocusDistance = 20
        shaderFX.DoF.InFocusRadius = Settings.ShaderDoFFar or 80
        shaderFX.DoF.NearIntensity = 0.1
    elseif shaderFX.DoF then
        shaderFX.DoF:Destroy()
        shaderFX.DoF = nil
    end

    -- SunRays
    if Settings.ShaderSunRays then
        if not shaderFX.Sun then
            local s = Instance.new("SunRaysEffect")
            s.Name = "PC_SunRays"
            s.Parent = Lighting
            shaderFX.Sun = s
            UnloadSystem:TrackInstance(s)
        end
        shaderFX.Sun.Intensity = Settings.ShaderSunIntensity or 0.12
        shaderFX.Sun.Spread = 0.6
    elseif shaderFX.Sun then
        shaderFX.Sun:Destroy()
        shaderFX.Sun = nil
    end

    -- Atmosphere tint
    if Settings.ShaderAtmosphere then
        local at = Lighting:FindFirstChildOfClass("Atmosphere")
        if not at then
            at = Instance.new("Atmosphere")
            at.Parent = Lighting
            UnloadSystem:TrackInstance(at)
        end
        shaderFX.Atmo = at
        at.Density = 0.3
        at.Offset = 0.1
        at.Color = Color3.fromRGB(140, 100, 200)
        at.Decay = Color3.fromRGB(80, 60, 120)
        at.Glare = 0.2
        at.Haze = 1.5
    end

    -- Blur
    if Settings.ShaderBlur then
        if not shaderFX.Blur then
            local b = Instance.new("BlurEffect")
            b.Name = "PC_Blur"
            b.Parent = Lighting
            shaderFX.Blur = b
            UnloadSystem:TrackInstance(b)
        end
        shaderFX.Blur.Size = Settings.ShaderBlurSize or 8
    elseif shaderFX.Blur then
        shaderFX.Blur:Destroy()
        shaderFX.Blur = nil
    end

    -- Clock / time of day
    if Settings.ShaderClock then
        Lighting.ClockTime = Settings.ShaderClockTime or 0
    end

    -- Sky presets
    if Settings.ShaderSky then
        applySkyPreset(Settings.ShaderSkyId or 1)
    end
end

-- Пресеты неба (Sky)
local SKY_PRESETS = {
    {name = "Purple Night", bk = "rbxassetid://6444884337", zenith = Color3.fromRGB(40, 20, 80), dawn = Color3.fromRGB(120, 60, 180)},
    {name = "Blood Moon", bk = "rbxassetid://600830446", zenith = Color3.fromRGB(60, 10, 10), dawn = Color3.fromRGB(200, 40, 40)},
    {name = "Cyber City", bk = "rbxassetid://159454299", zenith = Color3.fromRGB(10, 30, 60), dawn = Color3.fromRGB(0, 200, 255)},
    {name = "Sunset", bk = "rbxassetid://600830988", zenith = Color3.fromRGB(80, 40, 20), dawn = Color3.fromRGB(255, 140, 60)},
    {name = "Space", bk = "rbxassetid://159454286", zenith = Color3.fromRGB(5, 5, 20), dawn = Color3.fromRGB(40, 40, 80)},
    {name = "Aurora", bk = "rbxassetid://149397164", zenith = Color3.fromRGB(20, 60, 40), dawn = Color3.fromRGB(80, 255, 180)},
}

function applySkyPreset(id)
    id = math.clamp(tonumber(id) or 1, 1, #SKY_PRESETS)
    Settings.ShaderSkyId = id
    local preset = SKY_PRESETS[id]
    local sky = Lighting:FindFirstChildOfClass("Sky")
    if not sky then
        sky = Instance.new("Sky")
        sky.Parent = Lighting
        UnloadSystem:TrackInstance(sky)
    end
    shaderFX.Sky = sky
    pcall(function()
        sky.SkyboxBk = preset.bk
        sky.SkyboxDn = preset.bk
        sky.SkyboxFt = preset.bk
        sky.SkyboxLf = preset.bk
        sky.SkyboxRt = preset.bk
        sky.SkyboxUp = preset.bk
        sky.CelestialBodiesShown = true
        sky.StarCount = 3000
    end)
    pcall(function()
        Lighting.Ambient = preset.zenith
        Lighting.OutdoorAmbient = preset.dawn
    end)
end

