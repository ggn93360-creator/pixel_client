local function PlayKillSound(index, isPreview)
    local item = killSoundList[index]
    if item then
        killSoundObject:Stop()
        killSoundObject.SoundId = item.id
        killSoundObject.Volume = killSoundVolume
        killSoundObject.TimePosition = 0
        killSoundObject:Play()
    end
end

local function SaveConfig()
    if not writefile then return end
    pcall(function()
        Settings.MusicVolume = currentVolume
        Settings.MusicLooped = isLooped
        Settings.LastTrackIndex = currentPlayingIndex
        Settings.KillSoundVolume = killSoundVolume
        Settings.LastKillSoundIndex = currentKillSoundIndex
        
        local data = {
            Settings = Settings,
            CustomMusicList = musicList,
            CustomKillSoundList = killSoundList
        }
        writefile(CONFIG_FILE, HttpService:JSONEncode(data))
    end)
end

local function LoadConfig()
    if not readfile or not isfile or not isfile(CONFIG_FILE) then return end
    local success, result = pcall(function()
        return HttpService:JSONDecode(readfile(CONFIG_FILE))
    end)
    if success and type(result) == "table" then
        if result.Settings then
            for k, v in pairs(result.Settings) do
                if Settings[k] ~= nil and k ~= "Killstreak" then Settings[k] = v end
            end
        end
        if result.CustomMusicList then musicList = result.CustomMusicList end
        if result.CustomKillSoundList then killSoundList = result.CustomKillSoundList end
        
        currentVolume = Settings.MusicVolume or 0.5
        killSoundVolume = Settings.KillSoundVolume or 0.8
        isLooped = Settings.MusicLooped or false
        currentPlayingIndex = Settings.LastTrackIndex or 0
        currentKillSoundIndex = Settings.LastKillSoundIndex or 1
        
        backgroundSound.Volume = currentVolume
        backgroundSound.Looped = isLooped
        killSoundObject.Volume = killSoundVolume
    end
end

