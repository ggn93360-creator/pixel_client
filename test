local function isValidBtn(btn)
    return btn and btn.Parent and (btn:IsA("TextButton") or btn:IsA("ImageButton") or btn:IsA("ImageLabel") or btn:IsA("TextLabel"))
end


local function isMouseOverPixelGui()
    local pos = UserInputService:GetMouseLocation()
    local function isPixelAncestor(obj)
        local cur = obj
        for _ = 1, 20 do
            if not cur then break end
            local n = tostring(cur.Name or "")
            if n == "PixelClientGui" or n == "PixelClientToasts" then return true end
            if cur:IsA("ScreenGui") and string.find(string.lower(n), "pixel", 1, true) then
                return true
            end
            cur = cur.Parent
        end
        return false
    end
    local function scanGui(root)
        if not root then return false end
        local ok, list = pcall(function()
            return root:GetGuiObjectsAtPosition(pos.X, pos.Y)
        end)
        if not ok or type(list) ~= "table" then return false end
        for _, o in ipairs(list) do
            if isPixelAncestor(o) then return true end
            -- любая кнопка/тоггл под pixel gui
            if o:IsA("GuiButton") or o:IsA("TextButton") or o:IsA("ImageButton") then
                if isPixelAncestor(o) then return true end
            end
        end
        return false
    end
    if scanGui(LocalPlayer:FindFirstChild("PlayerGui")) then return true end
    local cg = game:GetService("CoreGui")
    if scanGui(cg) then return true end
    local pc = cg:FindFirstChild("PixelClientGui")
    if pc then
        -- hit-test: любой кликабельный элемент Pixel GUI
        for _, fr in ipairs(pc:GetDescendants()) do
            if fr:IsA("GuiObject") and fr.Visible then
                local ap, asz = fr.AbsolutePosition, fr.AbsoluteSize
                if asz.X > 8 and asz.Y > 8 then
                    if pos.X >= ap.X and pos.X <= ap.X + asz.X and pos.Y >= ap.Y and pos.Y <= ap.Y + asz.Y then
                        if fr:IsA("GuiButton") or fr.Active or asz.X > 80 or asz.Y > 80 then
                            return true
                        end
                    end
                end
            end
        end
    end
    return false
end

local function fireGuiButton(btn)
    if not isValidBtn(btn) then return false end
    local ok = false
    -- ТОЛЬКО firesignal/getconnections — БЕЗ SendMouseButtonEvent
    -- (VIM-клик крал фокус и GUI нельзя было нажать во время фарма)
    pcall(function()
        if firesignal then
            pcall(function() firesignal(btn.Activated) end)
            pcall(function() firesignal(btn.MouseButton1Click) end)
            pcall(function() firesignal(btn.MouseButton1Down) end)
            ok = true
        elseif getconnections then
            for _, sigName in ipairs({"Activated", "MouseButton1Click", "MouseButton1Down"}) do
                local sig = btn[sigName]
                if sig then
                    for _, conn in ipairs(getconnections(sig)) do
                        pcall(function()
                            if conn.Fire then conn:Fire()
                            elseif conn.Function then conn.Function()
                            end
                        end)
                        ok = true
                        break
                    end
                end
                if ok then break end
            end
        end
    end)
    return ok
end

local function scanCombatButtons(force)
    local now = tick()
    if not force and (now - combatBtnCache.lastScan) < combatBtnCache.scanEvery then
        -- если кнопка жива — не сканим заново
        if isValidBtn(combatBtnCache.punch) then return end
    end
    combatBtnCache.lastScan = now

    local pg = LocalPlayer:FindFirstChild("PlayerGui")
    if not pg then return end

    local punchHints = {"punch", "attack", "m1", "combat", "hit", "fight", "strike", "slash", "swing"}
    local foundPunch, foundSkills = nil, {}
    local fallbackBest, fallbackScore = nil, -1
    local cam = workspace.CurrentCamera
    local vw = cam and cam.ViewportSize.X or 400
    local vh = cam and cam.ViewportSize.Y or 700

    -- один проход по потомкам
    for _, inst in ipairs(pg:GetDescendants()) do
        if inst:IsA("GuiButton") or inst:IsA("TextButton") or inst:IsA("ImageButton") then
            local vis = true
            pcall(function() vis = inst.Visible end)
            local sz = inst.AbsoluteSize
            if vis and sz.X >= 12 and sz.Y >= 12 then
                local nameL = string.lower(inst.Name)
                local textL = ""
                pcall(function()
                    if inst:IsA("TextButton") then textL = string.lower(inst.Text or "") end
                end)

                if not foundSkills["1"] and (nameL == "1" or textL == "1" or nameL:find("skill1", 1, true) or nameL:find("ability1", 1, true)) then
                    foundSkills["1"] = inst
                elseif not foundSkills["2"] and (nameL == "2" or textL == "2" or nameL:find("skill2", 1, true)) then
                    foundSkills["2"] = inst
                elseif not foundSkills["3"] and (nameL == "3" or textL == "3" or nameL:find("skill3", 1, true)) then
                    foundSkills["3"] = inst
                elseif not foundSkills["4"] and (nameL == "4" or textL == "4" or nameL:find("skill4", 1, true)) then
                    foundSkills["4"] = inst
                end

                if not foundPunch then
                    for _, h in ipairs(punchHints) do
                        if nameL:find(h, 1, true) or textL:find(h, 1, true) then
                            foundPunch = inst
                            break
                        end
                    end
                end

                local p = inst.AbsolutePosition
                if p.X > vw * 0.5 and p.Y > vh * 0.4 and sz.X >= 36 and sz.Y >= 36 then
                    local score = p.X * 0.5 + p.Y + sz.X
                    if score > fallbackScore then
                        fallbackScore = score
                        fallbackBest = inst
                    end
                end
            end
        end
    end

    combatBtnCache.punch = foundPunch or fallbackBest
    combatBtnCache.skills = foundSkills
end

