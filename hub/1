		step = function(env, t, dt)
			local S = env.S
			local hrp = getRoot()
			if not hrp then return end
			dt = dt or 0.016
			local vel = hrp.CFrame:VectorToObjectSpace(hrp.AssemblyLinearVelocity)
			local stream = smooth(env, "stream", math.clamp(-vel.Z / 18, -0.5, 1.4), dt, 5)
			local lift = smooth(env, "lift", math.clamp(vel.Y / 40, -0.5, 0.5), dt, 6)
			local a = S.anim and 1 or 0
			env.st.ph = (env.st.ph or 0) + dt * (3 + math.abs(stream) * 3)
			local n = #env.st.welds
			local h = env.st.segLen / 2
			for k, w in ipairs(env.st.welds) do
				local ang = -((stream * 1.1 + 0.12 - lift * 0.3) / n + math.sin(env.st.ph - k * 0.45) * 0.03 * S.wave * (0.4 + math.abs(stream)) * a)
				if k == 1 then w.C0 = CFrame.Angles(ang, 0, 0) * CFrame.new(0, -h, 0)
				else w.C0 = CFrame.new(0, -h, 0) * CFrame.Angles(ang, 0, 0) * CFrame.new(0, -h, 0) end
			end
		end,
		ui = function(p, S, rb)
			p:AddSlider("Длина", 2, 8, 4.2, function(v) S.len = v; rb() end, 0.1)
			p:AddSlider("Ширина", 1, 4, 2.2, function(v) S.wid = v; rb() end, 0.1)
