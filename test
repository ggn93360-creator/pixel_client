    previewAnimId = nil
end

local function ensurePreviewChar()
    if previewChar and previewChar.Parent then return previewChar end
    destroyPreviewChar()
    local src = LocalPlayer.Character
    if not src then return nil end
    local ok, clone = pcall(function()
        local c = src:Clone()
        for _, d in ipairs(c:GetDescendants()) do
            if d:IsA("Script") or d:IsA("LocalScript") or d:IsA("Sound") then
                d:Destroy()
            end
        end
        -- strip tools
        for _, d in ipairs(c:GetChildren()) do
            if d:IsA("Tool") then d:Destroy() end
        end
        c.Parent = previewWorld
        return c
    end)
    if not ok or not clone then return nil end
    previewChar = clone
    local root = clone:FindFirstChild("HumanoidRootPart") or clone.PrimaryPart
    if root then
        clone:PivotTo(CFrame.new(0, 0, 0))
        previewCamera.CFrame = CFrame.new(Vector3.new(0, 2.2, 6.5), Vector3.new(0, 1.5, 0))
    end
    return previewChar
end

local function playPreviewInMenu(animId, name)
    -- только в ViewportFrame в центре колеса, НЕ на реальном персонаже
    if Settings.AnimPreview == false then return end
    animId = tonumber(animId)
    if not animId or animId <= 0 then return end
    if previewAnimId == animId and previewTrack and previewTrack.IsPlaying then
        return
    end
    local char = ensurePreviewChar()
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    if previewTrack then pcall(function() previewTrack:Stop(0.05) end) previewTrack = nil end
    local animator = hum:FindFirstChildOfClass("Animator")
    if not animator then
        animator = Instance.new("Animator")
        animator.Parent = hum
    end
    local anim = Instance.new("Animation")
    anim.AnimationId = "rbxassetid://" .. tostring(animId)
    local ok, track = pcall(function()
        return animator:LoadAnimation(anim)
    end)
    if not ok or not track then
        ok, track = pcall(function() return hum:LoadAnimation(anim) end)
    end
    if track then
        pcall(function()
            track.Priority = Enum.AnimationPriority.Action4
            track.Looped = true
            track:Play(0.1)
            track:AdjustSpeed(Settings.AnimSpeed or 1)
        end)
        previewTrack = track
        previewAnimId = animId
    end
end

local function stopPreviewInMenu()
    if previewTrack then pcall(function() previewTrack:Stop(0.1) end) previewTrack = nil end
    previewAnimId = nil
    -- не трогаем stopCurrentAnim — анимация на теле только после клика
end

local function wheelPageCount(list)
    return math.max(1, math.ceil(math.max(#list, 1) / WHEEL_PAGE_SIZE))
end

local function layoutWheel()
    local list = getWheelList()
    local pages = wheelPageCount(list)
    if wheelPage >= pages then wheelPage = pages - 1 end
    if wheelPage < 0 then wheelPage = 0 end
    local startIdx = wheelPage * WHEEL_PAGE_SIZE

    -- ВСЕГДА 12 позиций
    local n = 12
    local radius = 170
    local cx0, cy0 = 230, 230

    for i = 1, n do
        local btn = wheelButtons[i]
        if not btn then
            btn = Instance.new("TextButton", wheelRoot)
            btn.Size = UDim2.new(0, 82, 0, 82)
            btn.BackgroundColor3 = COLOR_SIDEBAR
            btn.TextColor3 = COLOR_TEXT
            btn.Font = MAIN_FONT
            btn.TextSize = 10
            btn.TextWrapped = true
            btn.AutoButtonColor = false
            btn.BorderSizePixel = 0
            btn.ZIndex = 4
            addCorner(btn, 16)
            -- номер слота
            local num = Instance.new("TextLabel", btn)
            num.Name = "Num"
            num.Size = UDim2.new(0, 16, 0, 14)
            num.Position = UDim2.new(0, 4, 0, 2)
            num.BackgroundTransparency = 1
            num.Text = tostring(i)
            num.TextColor3 = COLOR_TITLE
            num.Font = BOLD_FONT
            num.TextSize = 10
            num.ZIndex = 5
            wheelButtons[i] = btn
            local idxSlot = i
            btn.MouseEnter:Connect(function()
                wheelHover = idxSlot
                btn.BackgroundColor3 = COLOR_ACCENT
                local item = getWheelList()[wheelPage * WHEEL_PAGE_SIZE + idxSlot]
                if item then
                    wheelCenterLabel.Text = tostring(item.name)
                    playPreviewInMenu(item.id, item.name)
                else
                    wheelCenterLabel.Text = "—"
                end
            end)
            btn.MouseLeave:Connect(function()
                if wheelHover == idxSlot then
                    wheelHover = 0
                    stopPreviewInMenu()
                end
                btn.BackgroundColor3 = COLOR_SIDEBAR
                wheelCenterLabel.Text = "EMOTES"
            end)
            btn.MouseButton1Click:Connect(function()
                local item = getWheelList()[wheelPage * WHEEL_PAGE_SIZE + idxSlot]
                if item and item.id and item.id > 0 then
                    playAnimById(item.id, item.name, { silent = false, loop = Settings.AnimLoop })
                end
            end)
            btn.MouseButton2Click:Connect(function()
                local globalIndex = wheelPage * WHEEL_PAGE_SIZE + idxSlot
                openAnimPicker(globalIndex, btn)
            end)
        end
        local ang = math.rad((i - 1) * (360 / n) - 90)
        local bx = cx0 + math.cos(ang) * radius - 41
        local by = cy0 + math.sin(ang) * radius - 41
        btn.Position = UDim2.new(0, bx, 0, by)
        btn.Visible = true
        local item = list[startIdx + i]
        local num = btn:FindFirstChild("Num")
        if num then num.Text = tostring(i) end
        if item and item.id and item.id > 0 then
            btn.Text = "\n" .. tostring(item.name)
            btn.TextColor3 = COLOR_TEXT
            btn.BackgroundTransparency = 0
        else
            btn.Text = "\n—"
            btn.TextColor3 = COLOR_TEXT_MUTED
            btn.BackgroundTransparency = 0.15
        end
        btn.BackgroundColor3 = (wheelHover == i) and COLOR_ACCENT or COLOR_SIDEBAR
    end

    wheelPageLabel.Text = string.format("Стр. %d / %d  ·  %d эмоций  ·  слоты 1–12", wheelPage + 1, pages, #list)
end

local function setWheelOpen(state)
