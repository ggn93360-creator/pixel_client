local function recordSelf(root)
    if not root then return end
    local now = tick()
    table.insert(selfHistory, { t = now, cf = root.CFrame, pos = root.Position })
    while #selfHistory > 0 and (now - selfHistory[1].t) > SELF_MAX_AGE do
        table.remove(selfHistory, 1)
    end
    while #selfHistory > 64 do
        table.remove(selfHistory, 1)
    end
end

local function getSelfRewound(lagMs)
    if #selfHistory == 0 then return nil end
    local targetT = tick() - math.max(lagMs, 1) / 1000
    local best = selfHistory[1]
    for i = 1, #selfHistory do
        local e = selfHistory[i]
        if e.t <= targetT then
            best = e
        else
            if i > 1 then
                local prev = selfHistory[i - 1]
                local alpha = (targetT - prev.t) / math.max(e.t - prev.t, 1e-4)
                alpha = math.clamp(alpha, 0, 1)
                return {
                    t = targetT,
                    pos = prev.pos:Lerp(e.pos, alpha),
                    cf = prev.cf:Lerp(e.cf, alpha),
                }
            end
            break
        end
    end
    return best
end

-- BACKTRACK: клон ТЕБЯ на позиции ~ping ms назад (тело не трогаем)
local function updateBacktrackVisuals()
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if root then
        recordSelf(root)
    end

    if not Settings.Backtrack then
        clearSelfBTClone()
        btRewoundCF = nil
        return
    end

    local ms = getBacktrackMs()
    local ping = getPingMs()
    local bt = getSelfRewound(ms)
    if not (bt and bt.cf and char and root) then
        clearSelfBTClone()
        btRewoundCF = nil
        return
    end

    btRewoundCF = bt.cf

    if (not btSelfClone) or (not btSelfClone.Parent) or (btSelfToken ~= char) then
        clearSelfBTClone()
        btSelfClone = makeShimmerClone(char, "PixelBT_Self")
        btSelfToken = char
    end

    if btSelfClone then
        pcall(function() btSelfClone:PivotTo(bt.cf) end)
        -- noclip каждый кадр (на случай ресета свойств)
        for _, d in ipairs(btSelfClone:GetDescendants()) do
            if d:IsA("BasePart") then
                d.CanCollide = false
                d.CanTouch = false
                d.CanQuery = false
                d.Anchored = true
                d.Massless = true
            end
        end
        shimmerClone(btSelfClone, tick(), 0.85)
        local txt = btSelfClone:FindFirstChild("Txt", true)
        if txt then
            txt.Text = string.format("BT YOU %dms\nping %d", math.floor(ms), math.floor(ping))
        end
    end
end

