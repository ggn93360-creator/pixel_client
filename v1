local function FormatTime(seconds)
    seconds = math.max(0, math.floor(seconds or 0))
    local mins = math.floor(seconds / 60)
    local secs = seconds % 60
    return string.format("%02d:%02d", mins, secs)
end

local function UpdateMusicHUD()
    if currentPlayingIndex > 0 and musicList[currentPlayingIndex] then
        MusicTitle.Text = "🎵 " .. musicList[currentPlayingIndex].name
        StatusLabel.Text = backgroundSound.IsPlaying and "Статус: Грає" or "Статус: Пауза"
        StatusLabel.TextColor3 = Color3.fromRGB(180, 180, 180)
    else
        MusicTitle.Text = "🎵 Музика: Не грає"
        StatusLabel.Text = "Статус: Вимкнено"
        StatusLabel.TextColor3 = Color3.fromRGB(180, 180, 180)
    end
end

local function PlayMusic(index, forceChange)
    if musicList[index] then
        if currentPlayingIndex == index and not forceChange then
            if backgroundSound.IsPlaying then
                backgroundSound:Pause()
            else
                backgroundSound:Resume()
            end
        else
            currentPlayingIndex = index
            backgroundSound:Stop()
            backgroundSound.SoundId = musicList[index].id
            backgroundSound:Play()
        end
        SaveConfig()
        UpdateMusicHUD()
    end
end

