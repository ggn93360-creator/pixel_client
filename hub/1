					local fx = (math.sin(p) + 0.2 * math.sin(2 * p)) * S.flex * b.k * (1 + boost * 0.5) * a
					b.w.C0 = CFrame.new(b.prevHalf, 0, 0) * CFrame.Angles(0, 0, math.rad(b.rest + fx)) * CFrame.new(b.len / 2, 0, 0)
				end
			end
