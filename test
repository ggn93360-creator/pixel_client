        or name:find("serious") or name:find("mode") or name:find("burst")
        or name:find("transformation") or name:find("finisher")
end

local function IsCounterAnim(name)
    name = string.lower(tostring(name or ""))
    return name:find("deathcounter") or name:find("death_counter")
        or name:find("counter") or name:find("parry")
end

local function IsM1Anim(name)
    name = string.lower(tostring(name or ""))
    if name:find("walk") or name:find("run") or name:find("jump") or name:find("fall")
        or name:find("idle") or name:find("block") or name:find("guard") or name:find("swim")
        or name:find("climb") or name:find("sit") or name:find("emote") or name:find("dash")
        or name:find("roll") or name:find("land") then
        return false
    end
    if name:find("m1") or name:find("punch") or name:find("swing") or name:find("attack")
        or name:find("combat") or name:find("hit") or name:find("slash") or name:find("jab")
        or name:find("combo") or name:find("strike") or name:find("light") or name:find("heavy")
        or name:find("normal") or name:find("fist") or name:find("melee") or name:find("click") then
        return true
    end
    return false
end

local function SetupStatusTracking(player)
    if player == LocalPlayer then return end
    playerStatus[player] = playerStatus[player] or { charName = nil, ultUntil = 0, counterUntil = 0, m1Until = 0 }

    local function onChar(char)
        local st = playerStatus[player]
        st.charName = DetectCharacterName(char)
        st.ultUntil = 0
        st.counterUntil = 0
        st.m1Until = 0

        task.delay(1, function()
            if char and char.Parent then
                st.charName = DetectCharacterName(char) or st.charName
            end
        end)

        local hum = char:WaitForChild("Humanoid", 5)
        if not hum then return end
        local animator = hum:FindFirstChildOfClass("Animator") or hum:WaitForChild("Animator", 3)

        local function onTrack(track)
            if not track then return end
            local animName = track.Name
            local animObj = track.Animation
            local animIdName = animObj and animObj.Name or ""
            local animId = ""
            pcall(function() animId = tostring(animObj and animObj.AnimationId or "") end)
            local full = animName .. " " .. animIdName .. " " .. animId

            if IsUltAnim(full) then
                local dur = (track.Length and track.Length > 0) and track.Length or 8
                st.ultUntil = tick() + math.clamp(dur, 3, 20)
            end
            if IsCounterAnim(full) then
                st.counterUntil = tick() + 2.5
            end
            -- M1 / любая Action-анимация (TSB)
            local isM1 = IsM1Anim(full)
            local prio = 0
            pcall(function() prio = track.Priority and track.Priority.Value or 0 end)
            if isM1 or (prio >= Enum.AnimationPriority.Action.Value and not IsUltAnim(full) and not IsCounterAnim(full)
                and not full:lower():find("walk") and not full:lower():find("run")
                and not full:lower():find("idle") and not full:lower():find("block")) then
                st.m1Until = tick() + 0.55
            end
        end

        if animator then
            UnloadSystem:TrackConnection(animator.AnimationPlayed:Connect(onTrack))
        end
        pcall(function()
            UnloadSystem:TrackConnection(hum.AnimationPlayed:Connect(onTrack))
        end)

        -- Tool.Activated на персонаже таргета
        local function hookTool(tool)
            if not tool or not tool:IsA("Tool") then return end
            pcall(function()
                UnloadSystem:TrackConnection(tool.Activated:Connect(function()
                    st.m1Until = tick() + 0.5
                end))
            end)
        end
        for _, ch in ipairs(char:GetChildren()) do hookTool(ch) end
        UnloadSystem:TrackConnection(char.ChildAdded:Connect(hookTool))
    end

    UnloadSystem:TrackConnection(player.CharacterAdded:Connect(onChar))
    if player.Character then onChar(player.Character) end
end

