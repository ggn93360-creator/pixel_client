local function ensureToastHost()
    if ToastHost and ToastHost.Parent then return ToastHost end
    local gui = Instance.new("ScreenGui")
    gui.Name = "PixelClientToasts"
    gui.ResetOnSpawn = false
    gui.DisplayOrder = 100
    gui.IgnoreGuiInset = true
    pcall(function() gui.Parent = CoreGui end)
    if not gui.Parent then gui.Parent = LocalPlayer:WaitForChild("PlayerGui") end
    UnloadSystem:TrackInstance(gui)

    local host = Instance.new("Frame")
    host.Name = "ToastHost"
    host.Size = UDim2.new(0, 300, 0, 400)
    host.BackgroundTransparency = 1
    host.Parent = gui
    local lay = Instance.new("UIListLayout", host)
    lay.Name = "Lay"
    lay.SortOrder = Enum.SortOrder.LayoutOrder
    lay.Padding = UDim.new(0, 8)
    ToastHost = host
    if ApplyToastCorner then ApplyToastCorner() end
    return host
end

local function ApplyToastCorner()
    local host = ToastHost
    if not host then return end
    local c = tonumber(Settings.ToastCorner) or 2
    local lay = host:FindFirstChild("Lay")
    if c == 1 then -- Top Left
        host.Position = UDim2.new(0, 16, 0, 20)
        host.AnchorPoint = Vector2.new(0, 0)
        if lay then lay.VerticalAlignment = Enum.VerticalAlignment.Top; lay.HorizontalAlignment = Enum.HorizontalAlignment.Left end
    elseif c == 3 then -- Bottom Left
        host.Position = UDim2.new(0, 16, 1, -20)
        host.AnchorPoint = Vector2.new(0, 1)
        if lay then lay.VerticalAlignment = Enum.VerticalAlignment.Bottom; lay.HorizontalAlignment = Enum.HorizontalAlignment.Left end
    elseif c == 4 then -- Bottom Right
        host.Position = UDim2.new(1, -16, 1, -20)
        host.AnchorPoint = Vector2.new(1, 1)
        if lay then lay.VerticalAlignment = Enum.VerticalAlignment.Bottom; lay.HorizontalAlignment = Enum.HorizontalAlignment.Right end
    else -- Top Right (default)
        host.Position = UDim2.new(1, -16, 0, 20)
        host.AnchorPoint = Vector2.new(1, 0)
        if lay then lay.VerticalAlignment = Enum.VerticalAlignment.Top; lay.HorizontalAlignment = Enum.HorizontalAlignment.Right end
    end
end

