        cone.Parent = hat
        local mesh = Instance.new("SpecialMesh")
        mesh.MeshType = Enum.MeshType.FileMesh
        mesh.MeshId = "rbxassetid://1033714" -- cone-ish; fallback
        mesh.Scale = Vector3.new(1.2, 1.4, 1.2)
        mesh.Parent = cone
        -- if mesh fails look, use cylinder stack
        pcall(function()
            if mesh.MeshId == "" then end
        end)

        local band = Instance.new("Part")
        band.Name = "Band"
        band.Anchored = false
        band.CanCollide = false
        band.Massless = true
        band.Material = Enum.Material.Neon
        band.Color = COLOR_ACCENT
        band.Size = Vector3.new(1.15, 0.08, 1.15)
        band.Parent = hat

        for _, p in ipairs({brim, cone, band}) do
            local w = Instance.new("Weld")
