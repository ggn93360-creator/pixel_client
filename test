        pcall(function()
            local h = char:FindFirstChildOfClass("Highlight")
            if h and h.Name == "PixelStandHL" then h:Destroy() end
            local a = char:FindFirstChild("PixelStandAura")
            if a then a:Destroy() end
        end)
        for _, p in ipairs(char:GetDescendants()) do
            if p:IsA("BasePart") and p:GetAttribute("PixelStandColor") then
                pcall(function()
                    p.Color = p:GetAttribute("PixelStandColor")
                    p:SetAttribute("PixelStandColor", nil)
                end)
            end
        end
    end
end

local function applyStandSelf()
    clearStandSelf()
    if not Settings.StandEnabled then return end
    local char = LocalPlayer.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not root then return end

    local style = math.clamp(tonumber(Settings.StandStyle) or 1, 1, 6)
    local variant = math.clamp(tonumber(Settings.StandVariant) or 1, 1, 4)
    local col = STAND_PALETTE[style] or COLOR_ACCENT
    if variant == 2 then col = col:Lerp(Color3.fromRGB(255, 40, 40), 0.4)
    elseif variant == 3 then col = col:Lerp(Color3.fromRGB(255, 255, 255), 0.6)
    elseif variant == 4 then col = Color3.fromRGB(25, 25, 35) end

    StandAura = {}

    -- Highlight = you ARE the stand
    local hl = Instance.new("Highlight")
    hl.Name = "PixelStandHL"
    hl.FillColor = col
    hl.OutlineColor = col:Lerp(Color3.new(1,1,1), 0.3)
    hl.FillTransparency = (variant == 4) and 0.55 or 0.35
    hl.OutlineTransparency = 0.1
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.Parent = char
    StandAura.hl = hl
    UnloadSystem:TrackInstance(hl)

    -- neon tint body parts (store original)
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
            if not part:GetAttribute("PixelStandColor") then
                part:SetAttribute("PixelStandColor", part.Color)
            end
            pcall(function()
                part.Material = Enum.Material.Neon
                part.Color = col
            end)
        end
    end

    -- aura attachment under root
    local att = Instance.new("Attachment")
    att.Name = "PixelStandAura"
    att.Parent = root
    StandAura.att = att
    UnloadSystem:TrackInstance(att)

    local pe = Instance.new("ParticleEmitter")
    pe.Texture = "rbxasset://textures/particles/sparkles_main.dds"
    pe.Rate = 28
