-- ======================= общий HTTP-хелпер (JSON) =======================
local function httpJson(method, url, body)
	local headers = {["Content-Type"] = "application/json"}
	local function bodyOf(res)
		if type(res) == "string" and #res > 0 then return res end
		if type(res) == "table" then
			local b = res.Body or res.body
			if type(b) == "string" and #b > 0 then return b end
		end
	end
	local tries = {}
	for _, f in ipairs({syn and syn.request, http_request, request}) do
		if type(f) == "function" then
			table.insert(tries, function() return f({Url = url, Method = method, Headers = headers, Body = body}) end)
		end
	end
	if method == "GET" then table.insert(tries, function() return game:HttpGet(url) end) end
	for _, fn in ipairs(tries) do
		local ok, res = pcall(fn)
		if ok then
			local b = bodyOf(res)
			if b then
				local dok, d = pcall(function() return HttpService:JSONDecode(b) end)
				if dok and type(d) == "table" then return d end
			end
		end
	end
end

