local function detectExecutor()
    local name = nil
    pcall(function()
        if identifyexecutor then
            name = identifyexecutor()
        elseif getexecutorname then
            name = getexecutorname()
        end
    end)
    if type(name) == "string" and #name > 0 then
        return name
    end
    -- fallback по глобалам
    if syn then return "Synapse" end
    if is_sirhurt_closure or PROTOSMASHER_LOADED then return "SirHurt/Proto" end
    if fluxus then return "Fluxus" end
    if KRNL_LOADED or krnl then return "Krnl" end
    if secure_load or isexecutorclosure then
        -- generic
    end
    if getgenv and getgenv().NOBITA_LOADED then return "Nobita" end
    if getgenv and getgenv().Arceus then return "Arceus X" end
    if getgenv and (getgenv().Codex or getgenv().CODEX) then return "Codex" end
    if getgenv and getgenv().Hydrogen then return "Hydrogen" end
    if getgenv and getgenv().Delta then return "Delta" end
    if getgenv and getgenv().Trigon then return "Trigon" end
    if getgenv and getgenv().Solara then return "Solara" end
    if getgenv and getgenv().Wave then return "Wave" end
    if getgenv and getgenv().Valyse then return "Valyse" end
    if getgenv and getgenv().Xeno then return "Xeno" end
    if getgenv and getgenv().seliware then return "Seliware" end
    return "Unknown"
end

local function detectPlatform()
    PLATFORM.Executor = detectExecutor()
    local execLower = string.lower(tostring(PLATFORM.Executor))

    -- мобильные инжекторы / билды
    local mobileExecKeywords = {
        "arceus", "codex", "hydrogen", "delta", "trigon", "fluxus android",
        "krnl ios", "ios", "android", "mobile", "hotfix", "calamari",
        "script-ware mobile", "evon", "rr", "codex mobile"
    }
    local isMobileExec = false
    for _, kw in ipairs(mobileExecKeywords) do
        if string.find(execLower, kw, 1, true) then
            isMobileExec = true
            break
        end
    end

    local touch = false
    pcall(function() touch = UserInputService.TouchEnabled end)
    local keyboard = false
    pcall(function() keyboard = UserInputService.KeyboardEnabled end)
    local gyro = false
    pcall(function() gyro = UserInputService.GyroscopeEnabled end)

    local smallScreen = false
    pcall(function()
        local cam = workspace.CurrentCamera
        if cam and cam.ViewportSize.X > 0 and cam.ViewportSize.X < 900 then
            smallScreen = true
        end
    end)

    -- Итог: телефон если мобильный инжектор ИЛИ (тач без нормальной клавы) ИЛИ маленький экран+тач
    PLATFORM.IsMobile = isMobileExec or (touch and (not keyboard or gyro or smallScreen))
    PLATFORM.IsPC = not PLATFORM.IsMobile

    -- Drawing
    pcall(function()
        if typeof(Drawing) == "table" or type(Drawing) == "table" then
            local ok, obj = pcall(function() return Drawing.new("Square") end)
            if ok and obj then
                PLATFORM.HasDrawing = true
                pcall(function() obj:Remove() end)
            end
        end
    end)
    if PLATFORM.IsMobile then
        -- на мобилке Drawing часто кривой — предпочитаем Billboard
        PLATFORM.HasDrawing = false
    end

    PLATFORM.HasFile = (writefile ~= nil and readfile ~= nil)
    PLATFORM.HasHttp = (game.HttpGet ~= nil) or (request ~= nil) or (http_request ~= nil) or (syn and syn.request ~= nil)
    PLATFORM.HasVIM = (VirtualInputManager ~= nil)

    if PLATFORM.IsMobile then
        PLATFORM.Name = "Mobile"
    else
        PLATFORM.Name = "PC"
    end

    print(string.format(
        "[PixelClient] Executor: %s | Platform: %s | Drawing: %s | File: %s",
        tostring(PLATFORM.Executor),
        PLATFORM.Name,
        tostring(PLATFORM.HasDrawing),
        tostring(PLATFORM.HasFile)
    ))
end

