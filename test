--[[
	Pixels Client — кто сейчас играет с таким же скриптом
	API: https://mjuchl2kvk.apps.bot-hosting.cloud/api.php

	Работает сам: пробует HttpService, syn.request, http.request, request и т.д.
	Не требует вручную включать Allow HTTP Requests.
]]

local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local MarketplaceService = game:GetService("MarketplaceService")

local API_URL = "https://mjuchl2kvk.apps.bot-hosting.cloud/api.php"
local REFRESH_SEC = 2
local SHOW_GUI = true

-- кэш названия текущей игры
local cachedGameName = nil

local function getCurrentGameName()
	if cachedGameName then
		return cachedGameName
	end
	local placeId = game.PlaceId
	local name = nil
	local ok, info = pcall(function()
		return MarketplaceService:GetProductInfo(placeId)
	end)
	if ok and type(info) == "table" and info.Name then
		name = tostring(info.Name)
	end
	if not name or name == "" then
		name = "Place " .. tostring(placeId)
	end
	if #name > 48 then
		name = string.sub(name, 1, 45) .. "..."
	end
	cachedGameName = name
	return cachedGameName
end

-- ========== HTTP (авто-выбор) ==========

local httpBackend = nil -- "httpservice" | "syn" | "http" | "request" | "fluxus" | "httpget"

local function tryDecode(raw)
	if type(raw) ~= "string" or raw == "" then
		return nil
	end
	local ok, data = pcall(function()
		return HttpService:JSONDecode(raw)
	end)
	if ok then
		return data
	end
	return nil
end

local function detectBackend()
	-- 1) syn.request (Synapse, многие форки)
	if syn and type(syn.request) == "function" then
		httpBackend = "syn"
		return
	end
	-- 2) http.request
	if http and type(http.request) == "function" then
		httpBackend = "http"
		return
	end
	-- 3) request (глобальная)
	if type(request) == "function" then
		httpBackend = "request"
		return
	end
	-- 4) fluxus
	if fluxus and type(fluxus.request) == "function" then
		httpBackend = "fluxus"
		return
	end
	-- 5) HttpService (обычная игра / Studio с HTTP)
	local ok = pcall(function()
		if HttpService.HttpEnabled then
			HttpService:GetAsync(API_URL .. "?action=list")
		else
			-- иногда HttpEnabled false, но GetAsync всё равно работает в executor
			HttpService:GetAsync(API_URL .. "?action=list")
		end
	end)
	if ok then
		httpBackend = "httpservice"
		return
	end
	-- 6) game:HttpGet (старый/executor стиль)
	if type(game.HttpGet) == "function" then
		local ok2 = pcall(function()
			return game:HttpGet(API_URL .. "?action=list")
		end)
		if ok2 then
			httpBackend = "httpget"
			return
		end
	end
	httpBackend = nil
end

local function rawRequest(method, url, body)
	method = string.upper(method or "GET")
	local headers = { ["Content-Type"] = "application/json" }

	if httpBackend == "syn" then
		local res = syn.request({
			Url = url,
			Method = method,
			Headers = headers,
			Body = body,
		})
		return res and res.Body
	elseif httpBackend == "http" then
		local res = http.request({
			Url = url,
			Method = method,
			Headers = headers,
			Body = body,
		})
		return res and res.Body
	elseif httpBackend == "request" then
		local res = request({
			Url = url,
			Method = method,
			Headers = headers,
			Body = body,
		})
		return res and res.Body
	elseif httpBackend == "fluxus" then
		local res = fluxus.request({
			Url = url,
			Method = method,
			Headers = headers,
			Body = body,
		})
		return res and res.Body
	elseif httpBackend == "httpservice" then
		if method == "GET" then
			return HttpService:GetAsync(url)
		else
			return HttpService:PostAsync(url, body or "{}", Enum.HttpContentType.ApplicationJson)
		end
	elseif httpBackend == "httpget" then
		if method == "GET" then
			return game:HttpGet(url)
		end
		-- POST через HttpGet недоступен — пробуем HttpPost если есть
		if type(game.HttpPost) == "function" then
			return game:HttpPost(url, body or "{}", "application/json")
		end
		return nil
	end
	return nil
end

local function request(method, action, body)
	local url = API_URL .. "?action=" .. action
	local payload = nil
	if body then
		local ok, encoded = pcall(function()
			return HttpService:JSONEncode(body)
		end)
		payload = ok and encoded or nil
	end

	local ok, result = pcall(function()
		return rawRequest(method, url, payload)
	end)
	if not ok or not result then
		warn("[PixelsOnline] HTTP error:", result)
		return nil
	end
	return tryDecode(result)
end

local function fetchList()
	return request("GET", "list")
end

local function fetchStats()
	return request("GET", "stats")
end

local function sendHeartbeat(userid, username, displayname, features)
	return request("POST", "heartbeat", {
		userid = tostring(userid),
		username = username,
		displayname = displayname or username,
		game = getCurrentGameName(),
		placeId = tostring(game.PlaceId),
		features = features or {},
	})
end

-- ========== форматирование ==========

local function ago(ts)
	if not ts or ts == 0 then
		return "?"
	end
	if ts > 10000000000 then
		ts = math.floor(ts / 1000)
	end
	local diff = math.max(0, os.time() - ts)
	if diff < 60 then
		return diff .. " с назад"
	elseif diff < 3600 then
		return math.floor(diff / 60) .. " мин назад"
	elseif diff < 86400 then
		return math.floor(diff / 3600) .. " ч назад"
	else
		return math.floor(diff / 86400) .. " дн назад"
	end
end

local function printPlayers(data, stats)
	local users = (data and data.users) or {}
	local count = (data and data.count) or #users

	print("============================================================")
	print("  PIXELS CLIENT — кто онлайн")
	print("============================================================")

	if stats and stats.stats then
		local s = stats.stats
		print(string.format(
			"  Всего: %s  |  Онлайн: %s  |  Hits: %s",
			tostring(s.total or "?"),
			tostring(s.onlineNow or s.online or count),
			tostring(s.totalHits or "?")
		))
		local top = s.topFeatures
		if type(top) == "table" and #top > 0 then
			local parts = {}
			for i = 1, math.min(8, #top) do
				table.insert(parts, string.format("%s(%s)", tostring(top[i].name), tostring(top[i].count)))
			end
			print("  Топ модули: " .. table.concat(parts, ", "))
		end
	else
		print("  Онлайн сейчас: " .. tostring(count))
	end

	print("------------------------------------------------------------")

	if #users == 0 then
		print("  Никого нет в сети.")
		print("------------------------------------------------------------")
		return
	end

	print(string.format("  %-3s %-18s %-12s %-22s %-12s %s", "#", "Ник", "UserId", "Играет в", "Был", "Модули"))
	print("------------------------------------------------------------")

	for i, u in ipairs(users) do
		local name = u.displayname or u.username or "?"
		local username = u.username or ""
		local uid = tostring(u.userid or "")
		local gameName = u.game or "—"
		if #gameName > 20 then
			gameName = string.sub(gameName, 1, 17) .. "..."
		end
		local last = ago(tonumber(u.lastSeen) or 0)
		local feats = "—"
		if type(u.features) == "table" and #u.features > 0 then
			feats = table.concat(u.features, ", ")
		end
		local mark = (u.online ~= false) and "●" or "○"

		local display = name
		if username ~= "" and username ~= name then
			display = name .. " (@" .. username .. ")"
		end
		if #display > 17 then
			display = string.sub(display, 1, 16) .. "…"
		end

		print(string.format(
			"  %s %-2d %-18s %-12s %-22s %-12s %s",
			mark, i, display, uid, gameName, last, feats
		))
	end

	print("------------------------------------------------------------")
	print("  Всего в списке: " .. tostring(count))
end

-- ========== GUI ==========

local screenGui = nil
local listLabel = nil

local function ensureGui()
	if not SHOW_GUI then
		return
	end
	if RunService:IsServer() then
		return
	end
	local player = Players.LocalPlayer
	if not player then
		return
	end
	local pg = player:FindFirstChild("PlayerGui") or player:WaitForChild("PlayerGui", 5)
	if not pg then
		return
	end

	if screenGui and screenGui.Parent then
		return
	end

	screenGui = Instance.new("ScreenGui")
	screenGui.Name = "PixelsOnlineGui"
	screenGui.ResetOnSpawn = false
	screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	screenGui.Parent = pg

	local frame = Instance.new("Frame")
	frame.Name = "Root"
	frame.Size = UDim2.fromOffset(320, 220)
	frame.Position = UDim2.new(1, -340, 0, 20)
	frame.BackgroundColor3 = Color3.fromRGB(28, 22, 26)
	frame.BackgroundTransparency = 0.15
	frame.BorderSizePixel = 0
	frame.Parent = screenGui

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 10)
	corner.Parent = frame

	local title = Instance.new("TextLabel")
	title.Name = "Title"
	title.Size = UDim2.new(1, -16, 0, 28)
	title.Position = UDim2.fromOffset(8, 6)
	title.BackgroundTransparency = 1
	title.Font = Enum.Font.GothamBold
	title.TextSize = 14
	title.TextColor3 = Color3.fromRGB(232, 138, 160)
	title.TextXAlignment = Enum.TextXAlignment.Left
	title.Text = "PIXELS — кто онлайн"
	title.Parent = frame

	local scroll = Instance.new("ScrollingFrame")
	scroll.Name = "List"
	scroll.Size = UDim2.new(1, -16, 1, -44)
	scroll.Position = UDim2.fromOffset(8, 36)
	scroll.BackgroundTransparency = 1
	scroll.BorderSizePixel = 0
	scroll.ScrollBarThickness = 4
	scroll.CanvasSize = UDim2.fromOffset(0, 0)
	scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
	scroll.Parent = frame

	local layout = Instance.new("UIListLayout")
	layout.Padding = UDim.new(0, 4)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = scroll

	listLabel = Instance.new("TextLabel")
	listLabel.Name = "Content"
	listLabel.Size = UDim2.new(1, 0, 0, 0)
	listLabel.AutomaticSize = Enum.AutomaticSize.Y
	listLabel.BackgroundTransparency = 1
	listLabel.Font = Enum.Font.Code
	listLabel.TextSize = 12
	listLabel.TextColor3 = Color3.fromRGB(240, 230, 232)
	listLabel.TextXAlignment = Enum.TextXAlignment.Left
	listLabel.TextYAlignment = Enum.TextYAlignment.Top
	listLabel.TextWrapped = true
	listLabel.Text = "Загрузка..."
	listLabel.Parent = scroll
end

local function updateGui(data)
	if not listLabel then
		return
	end
	local users = (data and data.users) or {}
	if #users == 0 then
		listLabel.Text = "Никого нет в сети."
		return
	end
	local lines = {}
	for i, u in ipairs(users) do
		local name = u.displayname or u.username or "?"
		local gameName = u.game or "—"
		local feats = ""
		if type(u.features) == "table" and #u.features > 0 then
			feats = " [" .. table.concat(u.features, ", ") .. "]"
		end
		table.insert(lines, string.format("%d. %s\n   → %s%s", i, name, gameName, feats))
	end
	listLabel.Text = table.concat(lines, "\n")
end

-- ========== цикл ==========

local function heartbeatSelf()
	local lp = Players.LocalPlayer
	if not lp then
		return
	end
	sendHeartbeat(tostring(lp.UserId), lp.Name, lp.DisplayName, { "pixels_online" })
end

local function tick()
	heartbeatSelf()
	local data = fetchList()
	if not data then
		return
	end
	local stats = fetchStats()
	printPlayers(data, stats)
	updateGui(data)
end

-- ========== старт ==========

task.spawn(function()
	detectBackend()

	if not httpBackend then
		warn("[PixelsOnline] Не удалось найти рабочий HTTP. Попробуй executor с syn.request / http.request.")
		return
	end

	print("[PixelsOnline] HTTP backend:", httpBackend)
	ensureGui()

	while true do
		local ok, err = pcall(tick)
		if not ok then
			warn("[PixelsOnline]", err)
		end
		task.wait(REFRESH_SEC)
	end
end)

print("[PixelsOnline] запущен. Список каждые " .. REFRESH_SEC .. " сек. Heartbeat вкл.")
