-- ========================================================
local function UpdateMusicHUD()
    if currentPlayingIndex > 0 and musicList[currentPlayingIndex] then
        MusicTitle.Text = "Music: " .. musicList[currentPlayingIndex].name
    else
        MusicTitle.Text = "Music: Stopped"
    end
end

local function PlayMusic(index, forceChange)
    if musicList[index] then
        if currentPlayingIndex == index and not forceChange then
            if backgroundSound.IsPlaying then
                backgroundSound:Pause()
            else
                backgroundSound:Resume()
            end
        else
            currentPlayingIndex = index
            backgroundSound:Stop()
            backgroundSound.SoundId = musicList[index].id
            backgroundSound:Play()
        end
        SaveConfig()
        UpdateMusicHUD()
    end
end

local function RefreshMusicUI()
    for _, child in pairs(ScrollingList:GetChildren()) do
        if child:IsA("Frame") then child:Destroy() end
    end

    for i, track in ipairs(musicList) do
        local itemFrame = Instance.new("Frame")
        itemFrame.Size = UDim2.new(1, -8, 0, 30)
        itemFrame.BackgroundColor3 = COLOR_BTN
        itemFrame.Parent = ScrollingList
        applyPixelBorder(itemFrame, Color3.fromRGB(0, 0, 0), 1)

        local playBtn = Instance.new("TextButton", itemFrame)
        playBtn.Size = UDim2.new(1, -65, 1, 0)
        playBtn.BackgroundTransparency = 1
        playBtn.Text = " " .. track.name
        playBtn.TextColor3 = COLOR_TEXT
        playBtn.Font = MC_FONT
        playBtn.TextSize = 13
        playBtn.TextXAlignment = Enum.TextXAlignment.Left

        playBtn.MouseButton1Click:Connect(function() PlayMusic(i, false) end)

        local deleteBtn = Instance.new("TextButton", itemFrame)
        deleteBtn.Size = UDim2.new(0, 55, 0, 20)
        deleteBtn.Position = UDim2.new(1, -58, 0.5, -10)
        deleteBtn.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
        deleteBtn.Text = "Del"
        deleteBtn.TextColor3 = COLOR_TEXT
        deleteBtn.Font = MC_FONT
        deleteBtn.TextSize = 12
        applyPixelBorder(deleteBtn, Color3.fromRGB(0, 0, 0), 1)

        deleteBtn.MouseButton1Click:Connect(function()
            if currentPlayingIndex == i then
                backgroundSound:Stop()
                currentPlayingIndex = 0
            elseif currentPlayingIndex > i then
                currentPlayingIndex = currentPlayingIndex - 1
            end
            table.remove(musicList, i)
            SaveConfig()
            RefreshMusicUI()
            UpdateMusicHUD()
        end)
    end
end

local function RefreshKillSoundUI()
    for _, child in pairs(KSScrollingList:GetChildren()) do
        if child:IsA("Frame") then child:Destroy() end
    end

