        end
        return
    end
    local ms = math.clamp(tonumber(Settings.FakeLagMs) or 120, 40, 400)
    local sec = ms / 1000
    if math.abs(flAppliedLag - sec) > 0.01 then
        setIncomingLag(sec)
    end
end

