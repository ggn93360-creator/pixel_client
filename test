UpdateVisuals = function(char)
    if not char then return end
    local torso = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
    local head = char:FindFirstChild("Head")
    local rootPart = char:FindFirstChild("HumanoidRootPart")

    -- снять старые RenderStepped от косметики
    if char:GetAttribute("PC_CosmConn") then
        -- connections tracked on model destroy is enough if we parent to model
    end
    for _, n in ipairs({"CustomWings", "CustomHalo", "CustomChineseHat", "CustomTrail", "CustomAura", "CustomOrbs", "CustomFeint"}) do
        local old = char:FindFirstChild(n)
        if old then pcall(function() old:Destroy() end) end
    end
    -- чистим старые attachment trail
    if rootPart then
        for _, a in ipairs(rootPart:GetChildren()) do
            if a:IsA("Attachment") and (a.Name == "PC_Trail0" or a.Name == "PC_Trail1") then
                a:Destroy()
            end
        end
    end

    -- ===== WINGS (feather-fan style, no FileMesh) =====
    
    -- Chinese conical hat
    if Settings.ChineseHat and head then
        local hat = Instance.new("Model")
        hat.Name = "CustomChineseHat"
        hat.Parent = char
        UnloadSystem:TrackInstance(hat)

        local brim = Instance.new("Part")
