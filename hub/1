-- ======================= MESSAGE HUD + ДЕТЕКТОРЫ =======================
do
	local events = visuals:AddTab("Events")
	local holder = new("Frame", {BackgroundTransparency = 1, Size = UDim2.fromOffset(280, 0), AutomaticSize = Enum.AutomaticSize.Y})
	local lay = new("UIListLayout", {Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder}, holder)
	local feedItem = Pixel.HudItem("Message HUD", holder, {anchor = Vector2.new(0, 0), defPos = UDim2.fromOffset(14, 120)})
	local rows, counter = {}, 0
	local KC = {join = rgb(90, 220, 140), leave = rgb(255, 95, 110), soft = rgb(255, 170, 60)}
	local KL = {join = "JOIN", leave = "LEAVE", soft = "SOFT", chat = "CHAT", info = "INFO"}

	local function layoutFeed()
		local p = Feed.pos
		if p == "Top Left" then
			feedItem.anchor = Vector2.new(0, 0); feedItem.defPos = UDim2.fromOffset(14, 120)
			lay.VerticalAlignment = Enum.VerticalAlignment.Top
		elseif p == "Left Center" then
			feedItem.anchor = Vector2.new(0, 0.5); feedItem.defPos = UDim2.new(0, 14, 0.5, 0)
			lay.VerticalAlignment = Enum.VerticalAlignment.Top
		else
			feedItem.anchor = Vector2.new(0, 1); feedItem.defPos = UDim2.new(0, 14, 1, -14)
			lay.VerticalAlignment = Enum.VerticalAlignment.Bottom
		end
		feedItem.pos = nil
		feedItem.apply()
	end

	function Feed.Push(kind, title, text)
		if not Feed.on or Feed.kinds[kind] == false then return end
		counter += 1
		local bottom = Feed.pos == "Bottom Left"
		local slot = new("Frame", {BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 48), LayoutOrder = bottom and counter or -counter}, holder)
		local card = new("CanvasGroup", {BackgroundColor3 = Theme.Background, BackgroundTransparency = 0.15,
			Size = UDim2.fromScale(1, 1), Position = UDim2.fromOffset(-24, 0), GroupTransparency = 1}, slot)
		corner(card, 10)
		new("UIStroke", {Color = WHITE, Thickness = 1, Transparency = 0.92}, card)
		local col = KC[kind]
		local bar = new("Frame", {BackgroundColor3 = col or WHITE, Size = UDim2.new(0, 3, 1, -16), Position = UDim2.fromOffset(8, 8)}, card)
		corner(bar, 2)
		if not col then accent(bar).Rotation = 90 end
		txt("TextLabel", {BackgroundTransparency = 1, TextSize = 13, Text = title, TextColor3 = Theme.Text,
			TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd,
			Position = UDim2.fromOffset(20, 7), Size = UDim2.new(1, -78, 0, 17)}, card, "Bold")
		txt("TextLabel", {BackgroundTransparency = 1, TextSize = 10, Text = KL[kind] or "INFO", TextColor3 = col or Theme.AccentA,
			TextXAlignment = Enum.TextXAlignment.Right, Position = UDim2.new(1, -56, 0, 9), Size = UDim2.fromOffset(46, 14)}, card, "Bold")
		txt("TextLabel", {BackgroundTransparency = 1, TextSize = 11, Text = text, TextColor3 = Theme.SubText,
			TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd,
			Position = UDim2.fromOffset(20, 26), Size = UDim2.new(1, -30, 0, 16)}, card, "Regular")
		tween(card, {Position = UDim2.fromOffset(0, 0), GroupTransparency = 0}, dur(0.3), Enum.EasingStyle.Quart)
		local entry = {slot = slot}
		local done = false
		local function remove()
			if done then return end
			done = true
			for i, r in ipairs(rows) do if r == entry then table.remove(rows, i) break end end
			tween(card, {Position = UDim2.fromOffset(-24, 0), GroupTransparency = 1}, dur(0.25))
			task.delay(dur(0.3), function() slot:Destroy() end)
		end
		entry.remove = remove
		table.insert(rows, entry)
		task.delay(Feed.life, remove)
		while #rows > Feed.max do rows[1].remove() end
	end

	-- детекторы
	local Track = {}
	local function flag(plr, kind, detail)
		local rec = Track[plr]
		if not rec then return end
		local now = os.clock()
		if rec.cool[kind] and now - rec.cool[kind] < 25 then return end
		rec.cool[kind] = now
		Feed.Push("soft", plr.DisplayName .. " (@" .. plr.Name .. ")", kind .. (detail and (" • " .. detail) or ""))
	end
	local rayP = RaycastParams.new()
	rayP.FilterType = Enum.RaycastFilterType.Exclude

	local acc = 0
	connect(RunService.Heartbeat, function(dt)
		if not Det.on then return end
		acc += dt
		if acc < 0.2 then return end
		acc = 0
		local now = os.clock()
		for _, plr in ipairs(Players:GetPlayers()) do
			if plr ~= LP then
				local ch = plr.Character
				local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
				local hum = ch and ch:FindFirstChildOfClass("Humanoid")
				if hrp and hum and hum.Health > 0 then
					local rec = Track[plr]
					if not rec then
						rec = {pos = hrp.Position, t = now, speedT = 0, flyT = 0, cool = {}, born = now, ch = ch}
						Track[plr] = rec
					end
					if rec.ch ~= ch then
						rec.ch = ch; rec.pos = hrp.Position; rec.t = now; rec.born = now; rec.speedT = 0; rec.flyT = 0
					end
					local dtt = now - rec.t
					if dtt >= 0.19 then
						local delta = hrp.Position - rec.pos
						local hs = Vector3.new(delta.X, 0, delta.Z).Magnitude / dtt
						local vy = delta.Y / dtt
						rec.pos = hrp.Position; rec.t = now
						if now - rec.born > 3 and not hum.Sit then
							if Det.tp and delta.Magnitude > 90 then
								flag(plr, "Teleport", math.floor(delta.Magnitude) .. " studs")
								rec.speedT = 0; rec.flyT = 0
							else
								local thr = math.max(hum.WalkSpeed, 16) * (1.25 + 0.5 / Det.sens) + 6
								if Det.speed and hs > thr then rec.speedT += dtt else rec.speedT = math.max(0, rec.speedT - dtt * 2) end
								if rec.speedT > 1.2 then
									flag(plr, "Speed", string.format("%d st/s", math.floor(hs))); rec.speedT = 0
								end
								if Det.fly then
									rayP.FilterDescendantsInstances = {ch}
									local hit = workspace:Raycast(hrp.Position, Vector3.new(0, -12, 0), rayP)
									local lim = hum.HipHeight + hrp.Size.Y / 2 + 4
									local air = (not hit) or (hrp.Position.Y - hit.Position.Y) > lim
									if air and math.abs(vy) < 2 then rec.flyT += dtt else rec.flyT = math.max(0, rec.flyT - dtt * 2) end
									if rec.flyT > 2.5 / Det.sens then flag(plr, "Fly", "hover"); rec.flyT = 0 end
								end
							end
						end
					end
				end
			end
		end
	end)

	connect(Players.PlayerAdded, function(plr)
		if Det.join then Feed.Push("join", plr.DisplayName, "зашёл на сервер (@" .. plr.Name .. ")") end
	end)
	connect(Players.PlayerRemoving, function(plr)
		Track[plr] = nil
		if not Det.leave then return end
		local text = "вышел с сервера"
		if Det.leaveDist then
			local myRoot = getRoot()
			local ch = plr.Character
			local r = ch and ch:FindFirstChild("HumanoidRootPart")
			if myRoot and r then text = text .. " • " .. math.floor((r.Position - myRoot.Position).Magnitude) .. " studs от тебя" end
		end
		if Pixel.PixelUsers[plr.UserId] then text = text .. " • Pixel user" end
		Feed.Push("leave", plr.DisplayName, text)
	end)

	events:AddLabel("Message HUD - лента событий")
	events:AddToggle("Message HUD", true, function(on) Feed.on = on end, function(p)
		p:AddDropdown("Позиция", {"Top Left", "Left Center", "Bottom Left"}, "Top Left", function(o) Feed.pos = o; layoutFeed() end)
		p:AddSlider("Макс. сообщений", 2, 10, 6, function(v) Feed.max = v end)
		p:AddSlider("Время показа (сек)", 2, 20, 6, function(v) Feed.life = v end)
		Pixel.HudUI(p, feedItem)
	end)
	events:AddLabel("Детекторы")
	events:AddToggle("Leave detector", true, function(on) Det.leave = on end, function(p)
		p:AddToggle("Показывать дистанцию", true, function(on) Det.leaveDist = on end)
	end)
	events:AddToggle("Join detector", true, function(on) Det.join = on end)
	events:AddToggle("Soft detector", false, function(on) Det.on = on end, function(p)
		p:AddToggle("Speed", true, function(on) Det.speed = on end)
		p:AddToggle("Fly", true, function(on) Det.fly = on end)
		p:AddToggle("Teleport", true, function(on) Det.tp = on end)
		p:AddToggle("Pixel-юзеры", true, function(on) Det.pixel = on end)
		p:AddSlider("Чувствительность", 0.5, 2, 1, function(v) Det.sens = v end, 0.1)
	end)
	events:AddButton("Тест сообщений", function()
		Feed.Push("join", "Pixel_Player", "зашёл на сервер")
		Feed.Push("soft", "Cheater_01", "Speed • 62 st/s")
		Feed.Push("leave", "Someone", "вышел с сервера • 14 studs от тебя")
	end)
	layoutFeed()
	Win:OnUnload(function() holder:Destroy() end)
end

-- ======================= CHAT (глобальный чат Pixel-юзеров через твой API) =======================
local catChat = Win:AddCategory("Chat", "chat")
do
	local API_URL = "https://mjuchl2kvk.apps.bot-hosting.cloud/api.php"
	local G = {lastMsg = "", lastMsgT = 0, lastLang = "ru", seen = {}, users = {}, enabled = true, toHud = true}
	local logs, orders = {}, {ru = 0, en = 0}
	local http = httpJson

	local function device() return UIS.TouchEnabled and "Mobile" or "PC" end
	local placeName = tostring(game.PlaceId)
	task.spawn(function()
		pcall(function()
			local info = game:GetService("MarketplaceService"):GetProductInfo(game.PlaceId)
			if info and info.Name then placeName = tostring(info.Name) end
		end)
	end)

	local function status()
		local features = {device(), "PixelClient"}
		if G.lastMsg ~= "" then
			table.insert(features, "msg:" .. G.lastMsg:sub(1, 120))
			table.insert(features, "msgt:" .. tostring(G.lastMsgT))
			table.insert(features, "msglang:" .. G.lastLang)
		end
		local f = Pixel.CosmFlags()
		if f.wings then table.insert(features, "cosm_wings:1") end
		if f.halo then table.insert(features, "cosm_halo:1") end
		if f.trail then table.insert(features, "cosm_trail:1") end
		local json = HttpService:JSONEncode({userid = tostring(LP.UserId), username = LP.Name, displayname = LP.DisplayName,
			game = placeName, device = device(), executor = "PixelClient", features = features})
		http("POST", API_URL .. "?action=heartbeat", json)
		http("POST", API_URL .. "?action=update", json)
	end

	local function parseMsg(u)
		if type(u) ~= "table" or type(u.features) ~= "table" then return end
		local msg, ts, lang
		for _, f in ipairs(u.features) do
			local s = tostring(f)
			msg = s:match("^msg:(.+)$") or msg
			ts = tonumber(s:match("^msgt:(%d+)$")) or ts
			lang = s:match("^msglang:(%w+)$") or lang
		end
		return msg, ts, lang or "ru"
	end

	local function esc(s) return (tostring(s):gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;")) end
	local function c3(c) return string.format("rgb(%d,%d,%d)", math.floor(c.R * 255 + 0.5), math.floor(c.G * 255 + 0.5), math.floor(c.B * 255 + 0.5)) end
	local function nameColor(n)
		local h = 0
		for i = 1, #n do h = (h * 31 + n:byte(i)) % 360 end
		return Color3.fromHSV(h / 360, 0.45, 1)
	end

	local function addLine(lang, who, text, mode)
		local holder = logs[lang]
		if not holder then return end
		orders[lang] += 1
		local body
		if mode == "sys" then
			body = '<font color="rgb(150,150,178)"><i>' .. esc(text) .. '</i></font>'
		else
			local col = mode == "self" and Theme.AccentA or nameColor(who)
			body = string.format('<font color="rgb(120,120,150)">%s</font>  <font color="%s"><b>%s</b></font>  %s',
				os.date("%H:%M"), c3(col), esc(who), esc(text))
		end
		txt("TextLabel", {BackgroundTransparency = 1, RichText = true, TextWrapped = true, TextSize = 12, TextColor3 = Theme.Text,
			TextXAlignment = Enum.TextXAlignment.Left, AutomaticSize = Enum.AutomaticSize.Y, Size = UDim2.new(1, -6, 0, 0),
			LayoutOrder = orders[lang], Text = body}, holder, "Regular")
		local kids = {}
		for _, c in ipairs(holder:GetChildren()) do if c:IsA("TextLabel") then table.insert(kids, c) end end
		while #kids > 60 do kids[1]:Destroy(); table.remove(kids, 1) end
		task.delay(0.06, function()
			if holder.Parent then holder.CanvasPosition = Vector2.new(0, math.max(holder.AbsoluteCanvasSize.Y - holder.AbsoluteWindowSize.Y, 0)) end
		end)
	end

	local lastSend = 0
	local function send(lang, text)
		text = (tostring(text or ""):gsub("^%s+", ""):gsub("%s+$", ""))
		if text == "" or not G.enabled then return false end
		if os.clock() - lastSend < 0.8 then return false end
		lastSend = os.clock()
		if #text > 120 then text = text:sub(1, 120) end
		G.lastMsg, G.lastMsgT, G.lastLang = text, os.time(), lang
		addLine(lang, LP.DisplayName, text, "self")
		task.spawn(status)
		return true
	end

	local function buildChat(lang, title, hint)
		local tab = catChat:AddTab(title)
		tab:AddLabel(hint)
		local box = tab:AddCustom(250)
		local scroll = new("ScrollingFrame", {BackgroundTransparency = 1, Size = UDim2.new(1, -16, 1, -52), Position = UDim2.fromOffset(8, 8),
			ScrollBarThickness = 3, ScrollBarImageColor3 = Theme.AccentA, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y}, box)
		table.insert(scrollbars, scroll)
		list(scroll, 4)
		logs[lang] = scroll
		local input = txt("TextBox", {BackgroundColor3 = Theme.ElementHi, BackgroundTransparency = 0.3, Text = "",
			PlaceholderText = "Сообщение... (Enter)", PlaceholderColor3 = Theme.SubText, TextColor3 = Theme.Text, TextSize = 12,
			ClearTextOnFocus = false, TextXAlignment = Enum.TextXAlignment.Left, ClipsDescendants = true,
			Size = UDim2.new(1, -92, 0, 28), Position = UDim2.new(0, 8, 1, -36)}, box, "Regular")
		corner(input, 7)
		new("UIPadding", {PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8)}, input)
		local btn = txt("TextButton", {BackgroundColor3 = Theme.AccentA, BackgroundTransparency = 0.2, Text = "Send", TextColor3 = WHITE,
			TextSize = 12, AutoButtonColor = false, Size = UDim2.fromOffset(70, 28), Position = UDim2.new(1, -78, 1, -36)}, box, "Bold")
		corner(btn, 7)
		local function go()
			if send(lang, input.Text) then input.Text = "" end
		end
		btn.MouseButton1Click:Connect(go)
		input.FocusLost:Connect(function(enter) if enter then go() end end)
		addLine(lang, "", lang == "ru" and "RU канал подключён" or "EN channel connected", "sys")
	end
	buildChat("ru", "Русский", "Только русский чат (между софтами, не Roblox chat)")
	buildChat("en", "English", "English-only channel (soft chat, not Roblox)")

	local onlineTab = catChat:AddTab("Online")
	onlineTab:AddLabel("Кто сейчас в сети с Pixel Client")
	local onlineHolder
	do
		local box = onlineTab:AddCustom(200)
		onlineHolder = new("ScrollingFrame", {BackgroundTransparency = 1, Size = UDim2.new(1, -16, 1, -16), Position = UDim2.fromOffset(8, 8),
			ScrollBarThickness = 3, ScrollBarImageColor3 = Theme.AccentA, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y}, box)
		table.insert(scrollbars, onlineHolder)
		list(onlineHolder, 4)
	end
	local function refreshOnline(users)
		for _, c in ipairs(onlineHolder:GetChildren()) do if c:IsA("TextLabel") then c:Destroy() end end
		for i, u in ipairs(users) do
			local dev = "?"
			if type(u.features) == "table" then
				for _, f in ipairs(u.features) do
					local s = string.lower(tostring(f))
					if s == "pc" then dev = "PC" elseif s == "mobile" or s == "phone" then dev = "Mobile" end
				end
			end
			txt("TextLabel", {BackgroundTransparency = 1, Size = UDim2.new(1, -4, 0, 32), TextSize = 12, TextColor3 = Theme.Text,
				TextXAlignment = Enum.TextXAlignment.Left, LayoutOrder = i,
				Text = string.format("%s  ·  %s\n%s", tostring(u.displayname or u.username or "?"), dev, tostring(u.game or "?"))}, onlineHolder, "Medium")
		end
		if #users == 0 then
			txt("TextLabel", {BackgroundTransparency = 1, Size = UDim2.new(1, -4, 0, 20), TextSize = 12, TextColor3 = Theme.SubText,
				TextXAlignment = Enum.TextXAlignment.Left, Text = "Никого онлайн..."}, onlineHolder, "Regular")
		end
	end

	local set = catChat:AddTab("Settings")
	set:AddToggle("Чат включён", true, function(on) G.enabled = on end)
	set:AddToggle("Сообщения в Message HUD", true, function(on) G.toHud = on; Feed.kinds.chat = on end)
	set:AddButton("Очистить чаты", function()
		for _, h in pairs(logs) do
			for _, c in ipairs(h:GetChildren()) do if c:IsA("TextLabel") then c:Destroy() end end
		end
	end)

	-- метки косметики у других игроков с софтом
	local remote = {}
	local function clearRemote(plr)
		local r = remote[plr]
		if not r then return end
		pcall(function() r.bb:Destroy() end)
		remote[plr] = nil
	end
	local function applyRemote(plr, flags)
		local char = plr.Character
		local head = char and (char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart"))
		if not head or not (flags.wings or flags.halo or flags.trail) then clearRemote(plr) return end
		local r = remote[plr]
		if not r or not r.bb.Parent then
			clearRemote(plr)
			local bb = new("BillboardGui", {Size = UDim2.fromOffset(100, 16), StudsOffset = Vector3.new(0, 3.9, 0), AlwaysOnTop = true, Adornee = head}, char)
			local l = new("TextLabel", {BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Font = Enum.Font.GothamBold, TextSize = 11,
				TextColor3 = rgb(255, 200, 230), TextStrokeTransparency = 0.4}, bb)
			r = {bb = bb, lbl = l}
			remote[plr] = r
		end
		local tags = {}
		if flags.wings then table.insert(tags, "Wings") end
		if flags.halo then table.insert(tags, "Halo") end
		if flags.trail then table.insert(tags, "Trail") end
		r.lbl.Text = table.concat(tags, " · ")
	end

	task.spawn(function()
		task.wait(1.5)
		pcall(status)
		while gui.Parent do
			local ok, d = pcall(function() return http("GET", API_URL .. "?action=list", nil) end)
			local users = (ok and d and d.status == "ok" and d.users) or {}
			G.users = users
			pcall(refreshOnline, users)
			local pixelNow = {}
			for _, u in ipairs(users) do
				local uid = tostring(u.userid or "")
				local idn = tonumber(uid)
				if uid ~= "" and idn and idn ~= LP.UserId then
					pixelNow[idn] = true
					local plr = Players:GetPlayerByUserId(idn)
					if plr and not Pixel.PixelUsers[idn] and Det.on and Det.pixel then
						Feed.Push("soft", plr.DisplayName, "использует Pixel Client")
					end
					local msg, ts, lang = parseMsg(u)
					if msg and ts then
						local key = uid .. "|" .. ts .. "|" .. msg
						if not G.seen[key] then
							G.seen[key] = true
							local who = tostring(u.displayname or u.username or uid)
							addLine(lang == "en" and "en" or "ru", who, msg, "other")
							if G.toHud then Feed.Push("chat", who, msg) end
						end
					end
					if plr then
						local flags = {}
						if type(u.features) == "table" then
							for _, f in ipairs(u.features) do
								local s = tostring(f)
								if s == "cosm_wings:1" then flags.wings = true end
								if s == "cosm_halo:1" then flags.halo = true end
								if s == "cosm_trail:1" then flags.trail = true end
							end
						end
						pcall(applyRemote, plr, flags)
					end
				end
			end
			Pixel.PixelUsers = pixelNow
			pcall(status)
			task.wait(2)
		end
	end)
	connect(Players.PlayerRemoving, clearRemote)
	Win:OnUnload(function() for p in pairs(remote) do clearRemote(p) end end)
end

