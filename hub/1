Pixel.DefaultsJson = Pixel.Config.Encode() -- значения по умолчанию для кнопки сброса
runLoader(function()
	Win.Ready = true
	Win:SetVisible(true)
	Pixel:Notify("Pixel Client", "Загружен • " .. (Fit.phone and "тап по watermark" or TOGGLE_KEY.Name) .. " - меню", 4)
	Pixel.State.data.runs += 1
	Pixel.State.save()
	if not Pixel.State.data.tutorialDone then task.delay(1.2, runTutorial) end
	-- PC: скрытый запуск Python-companion (на телефоне ничего не трогаем)
	if Pixel.LaunchCompanion and not Fit.phone then
		task.spawn(function()
			local r = Pixel.LaunchCompanion()
			if r == "manual" or r == "download" then
				Pixel:Notify("Now Playing", "Companion не запустился сам. HUD -> Now Playing -> запустить вручную", 5)
			end
		end)
	end
end)

return Pixel
