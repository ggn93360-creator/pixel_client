local DesyncState = {
    active = false,
    clone = nil,
    floor = nil,
    motorPairs = {},
    collConns = {},
    statConns = {},
    camAngX = 0,
    camAngY = 0,
    camDist = 10,
    keys = {W=false,S=false,A=false,D=false,Space=false},
    -- mobile
    touchLookId = nil,   -- InputObject for camera drag
    isMobile = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
}

local function DesyncStop()
    local char = LocalPlayer.Character
    for _, c in ipairs(DesyncState.collConns) do pcall(function() c:Disconnect() end) end
    for _, c in ipairs(DesyncState.statConns) do pcall(function() c:Disconnect() end) end
    DesyncState.collConns = {}
    DesyncState.statConns = {}
    DesyncState.motorPairs = {}

    if DesyncState.clone and DesyncState.clone:FindFirstChild("HumanoidRootPart") and char and char:FindFirstChild("HumanoidRootPart") then
        char.HumanoidRootPart.CFrame = DesyncState.clone.HumanoidRootPart.CFrame
        char.HumanoidRootPart.AssemblyLinearVelocity = Vector3.zero
        for _, part in pairs(char:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = (part.Name ~= "HumanoidRootPart")
                part.CustomPhysicalProperties = nil
                part.LocalTransparencyModifier = 0
            elseif part:IsA("Decal") then
                part.Transparency = 0
            end
        end
    end
    pcall(function()
        local cam = Workspace.CurrentCamera
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if cam then
            cam.CameraType = Enum.CameraType.Custom
            if hum then cam.CameraSubject = hum end
        end
    end)
    if DesyncState.clone then pcall(function() DesyncState.clone:Destroy() end) end
    if DesyncState.floor then pcall(function() DesyncState.floor:Destroy() end) end
    DesyncState.clone = nil
    DesyncState.floor = nil
    DesyncState.active = false
    DesyncState.touchLookId = nil
    -- вернуть обычную камеру
    pcall(function()
        local cam = Workspace.CurrentCamera
        if cam then cam.CameraType = Enum.CameraType.Custom end
    end)
    local cam = Workspace.CurrentCamera
    if cam then cam.CameraType = Enum.CameraType.Custom end
end

local function DesyncStart()
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return false end
    DesyncStop()

    char.Archivable = true
    local clone = char:Clone()
    clone.Name = "PC_DesyncClone"
    clone.Parent = Workspace
    for _, v in pairs(clone:GetDescendants()) do
        if v:IsA("Script") or v:IsA("LocalScript") or v:IsA("Animator") then
            -- keep Animator on clone humanoid; strip scripts
            if v:IsA("Script") or v:IsA("LocalScript") then v:Destroy() end
        end
        if v:IsA("ForceField") then v:Destroy() end
    end
    -- clone collidable / visible
    for _, p in pairs(clone:GetDescendants()) do
        if p:IsA("BasePart") then
            p.CanCollide = (p.Name == "HumanoidRootPart") and false or true
            p.Anchored = false
            p.LocalTransparencyModifier = 0
        end
    end
    local cHum = clone:FindFirstChildOfClass("Humanoid")
    if cHum then
        cHum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
        pcall(function() cHum:ChangeState(Enum.HumanoidStateType.Running) end)
    end
    clone.HumanoidRootPart.CFrame = char.HumanoidRootPart.CFrame
    -- hide real character locally
    for _, p in pairs(char:GetDescendants()) do
        if p:IsA("BasePart") then
            p.LocalTransparencyModifier = 1
            p.CanCollide = false
        elseif p:IsA("Decal") then
            p.Transparency = 1
        end
    end

    local charHum = char:FindFirstChildOfClass("Humanoid")
    local cloneHum = clone:FindFirstChildOfClass("Humanoid")
    if charHum and cloneHum then
        cloneHum.WalkSpeed = charHum.WalkSpeed
        cloneHum.JumpPower = charHum.JumpPower
        cloneHum.JumpHeight = charHum.JumpHeight
        table.insert(DesyncState.statConns, charHum:GetPropertyChangedSignal("WalkSpeed"):Connect(function()
            if cloneHum and cloneHum.Parent then cloneHum.WalkSpeed = charHum.WalkSpeed end
        end))
        table.insert(DesyncState.statConns, charHum:GetPropertyChangedSignal("JumpPower"):Connect(function()
            if cloneHum and cloneHum.Parent then cloneHum.JumpPower = charHum.JumpPower end
        end))
        table.insert(DesyncState.statConns, charHum:GetPropertyChangedSignal("JumpHeight"):Connect(function()
            if cloneHum and cloneHum.Parent then cloneHum.JumpHeight = charHum.JumpHeight end
        end))
    end

    for _, part in pairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            part.CanCollide = false
            part.CustomPhysicalProperties = PhysicalProperties.new(0, 0, 0, 0, 0)
        end
    end
    table.insert(DesyncState.collConns, char.DescendantAdded:Connect(function(part)
        if part:IsA("BasePart") then
            part.CanCollide = false
            part.CustomPhysicalProperties = PhysicalProperties.new(0, 0, 0, 0, 0)
        end
    end))

    for _, part in pairs(clone:GetDescendants()) do
        if part:IsA("BasePart") then part.CanCollide = true end
    end

    local floor = Instance.new("Part")
    floor.Size = Vector3.new(10, 1, 10)
    floor.Anchored = true
    floor.CanCollide = true
    floor.Transparency = 1
    floor.Parent = Workspace
    UnloadSystem:TrackInstance(floor)

    DesyncState.motorPairs = {}
    for _, motor in pairs(char:GetDescendants()) do
        if motor:IsA("Motor6D") then
            local cm = clone:FindFirstChild(motor.Name, true)
            if cm and cm:IsA("Motor6D") then
                table.insert(DesyncState.motorPairs, {Real = motor, Clone = cm})
            end
        end
    end

    DesyncState.clone = clone
    DesyncState.floor = floor
    DesyncState.active = true
    DesyncState.touchLookId = nil
    DesyncState.isMobile = UserInputService.TouchEnabled
    -- стартовые углы камеры (удобно на телефоне)
    pcall(function()
        local cam = Workspace.CurrentCamera
        if cam then
            local look = cam.CFrame.LookVector
            DesyncState.camAngX = math.atan2(-look.X, -look.Z)
            DesyncState.camAngY = math.asin(math.clamp(look.Y, -1, 1))
        end
    end)
    UnloadSystem:TrackInstance(clone)
    return true
end

