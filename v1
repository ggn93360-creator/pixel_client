local function UpdateVisuals(char)
    if not char then return end
    local torso = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
    local head = char:FindFirstChild("Head")
    local rootPart = char:FindFirstChild("HumanoidRootPart")
    
    if char:FindFirstChild("CustomWings") then char.CustomWings:Destroy() end
    if char:FindFirstChild("CustomHalo") then char.CustomHalo:Destroy() end
    if char:FindFirstChild("CustomTrail") then char.CustomTrail:Destroy() end
    
    if Settings.WingsEnabled and torso then
        local wingModel = Instance.new("Model")
        wingModel.Name = "CustomWings"
        wingModel.Parent = char
        for i = 1, 8 do
            local part = Instance.new("Part")
            part.Size = Vector3.new(0.5, 3.2, 0.2)
            part.CFrame = torso.CFrame * CFrame.new(0, 0.5, 0.6) * CFrame.Angles(0, 0, math.rad(i * 22 - 90))
            part.CanCollide = false
            part.Material = Enum.Material.SmoothPlastic
            part.Color = Color3.fromRGB(180, 50, 50)
            part.Parent = wingModel
            local weld = Instance.new("WeldConstraint", part)
            weld.Part0 = torso
            weld.Part1 = part
        end
    end
    
    if Settings.HaloEnabled and head then
        local haloPart = Instance.new("Part")
        haloPart.Name = "CustomHalo"
        haloPart.Size = Vector3.new(2.2, 0.15, 2.2)
        haloPart.Shape = Enum.PartType.Cylinder
        haloPart.CFrame = head.CFrame * CFrame.new(0, 1.6, 0) * CFrame.Angles(math.rad(90), 0, 0)
        haloPart.CanCollide = false
        haloPart.Material = Enum.Material.Neon
        haloPart.Color = Color3.fromRGB(255, 215, 0)
        haloPart.Parent = char
        local weld = Instance.new("WeldConstraint", haloPart)
        weld.Part0 = head
        weld.Part1 = haloPart
    end
    
    if Settings.TrailEnabled and rootPart then
        local att0 = Instance.new("Attachment", rootPart)
        att0.Position = Vector3.new(0, -1, 0)
        local att1 = Instance.new("Attachment", rootPart)
        att1.Position = Vector3.new(0, 1, 0)
        local trail = Instance.new("Trail")
        trail.Name = "CustomTrail"
        trail.Attachment0 = att0
        trail.Attachment1 = att1
        trail.Color = ColorSequence.new(Color3.fromRGB(255, 215, 0))
        trail.Lifetime = 0.5
        trail.Parent = rootPart
    end
end

