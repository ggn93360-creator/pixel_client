function UnloadSystem:Unload()
    self.Active = false
    clearAllOverheadTags()

    for _, conn in ipairs(self.Connections) do
        if conn and conn.Connected then conn:Disconnect() end
    end
    for _, inst in ipairs(self.Instances) do
        if inst and inst.Parent then inst:Destroy() end
    end
    for _, draw in ipairs(self.Drawings) do
        pcall(function() draw:Remove() end)
    end
    table.clear(self.Connections)
    table.clear(self.Instances)
    table.clear(self.Drawings)
    table.clear(ESP_Cache)

    if LocalPlayer.Character then
        local char = LocalPlayer.Character
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then hum.AutoRotate = true end
        if char:FindFirstChild("CustomWings") then char.CustomWings:Destroy() end
        if char:FindFirstChild("CustomHalo") then char.CustomHalo:Destroy() end
        if char:FindFirstChild("CustomChineseHat") then char.CustomChineseHat:Destroy() end
        if char:FindFirstChild("CustomTrail") then char.CustomTrail:Destroy() end
        char:SetAttribute("PixelsClientUser", nil)
    end
    
    local cam = Workspace.CurrentCamera
    if cam then cam.FieldOfView = 70 end

    Lighting.Brightness = OriginalLighting.Brightness
    Lighting.ClockTime = OriginalLighting.ClockTime
    Lighting.GlobalShadows = OriginalLighting.GlobalShadows
    
    -- Stop fling / jerk if running
    pcall(function()
        FlingActive = false
        Workspace.FallenPartsDestroyHeight = FlingFPDH or -500
        stopJerk()
    end)
    
    print("[Pixel Client] Unloaded successfully.")
end

