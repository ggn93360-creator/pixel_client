-- ===== AUTH CODE (клиент сверяет) =====
local function makeAuthCode()
    local t = tostring(math.floor(tick() * 1000))
    local uid = tostring(LocalPlayer.UserId)
    local seed = t .. ":" .. uid .. ":PixelHub"
    local h = 0
    for i = 1, #seed do
        h = (h * 31 + string.byte(seed, i)) % 2147483647
    end
    return string.format("PC-%s-%X", uid, h)
end

local function pushAuth()
    local code = makeAuthCode()
    pcall(function()
        local g = (getgenv and getgenv()) or _G
        g.PixelClient_Auth = code
        g.PixelClient_ExpectedAuth = code
        g.PixelClient_AuthTime = tick()
        g.PixelClient_FromHub = true
        g.PixelClient_Place = currentPlaceId
    end)
    return code
end

-- выставляем сразу при открытии Hub
local sessionCode = pushAuth()

local function loadGameScript(gameData)
    local code = pushAuth()
    print("[Pixel Hub] Auth:", code)

    local function run(src, label)
        local ok, err = pcall(function()
            local fn = loadstring(src)
            if not fn then error("loadstring returned nil") end
            fn()
        end)
        if ok then
            print("[Pixel Hub] OK:", label)
            return true
        end
        warn("[Pixel Hub] FAIL", label, err)
        return false
    end

    -- локальный файл (если есть)
    if gameData.LocalFile and readfile and isfile then
        local okFile = false
        pcall(function() okFile = isfile(gameData.LocalFile) end)
        if okFile then
            local body = readfile(gameData.LocalFile)
            if body and run(body, "local:" .. gameData.LocalFile) then
                return true
            end
        end
    end

    -- URL
    if gameData.ScriptUrl and game.HttpGet then
        local ok, body = pcall(function()
            return game:HttpGet(gameData.ScriptUrl)
        end)
        if ok and body and run(body, "http") then
            return true
        end
    end
    return false
end

