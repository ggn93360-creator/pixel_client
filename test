local function spawnHitPixels(pos)
    if not Settings.HitPixels or not pos then return end
    local colors = {
        COLOR_TITLE,
        COLOR_ACCENT,
        Color3.fromRGB(255, 255, 255),
        Color3.fromRGB(255, 100, 180),
        Color3.fromRGB(120, 200, 255),
    }
    local count = 10
    for i = 1, count do
        local px = Instance.new("Part")
        px.Name = "PC_HitPixel"
        px.Size = Vector3.new(0.18, 0.18, 0.18)
        px.Material = Enum.Material.Neon
        px.Color = colors[((i - 1) % #colors) + 1]
        px.Anchored = true
        px.CanCollide = false
        px.CastShadow = false
        local offset = Vector3.new(
            (math.random() - 0.5) * 2.2,
            (math.random() - 0.3) * 1.8,
            (math.random() - 0.5) * 2.2
        )
        px.CFrame = CFrame.new(pos + offset)
        px.Parent = Workspace
        UnloadSystem:TrackInstance(px)

        local dir = offset.Unit * (4 + math.random() * 6) + Vector3.new(0, 2 + math.random() * 3, 0)
        local life = 0.18 + math.random() * 0.12
        local start = tick()
        local startPos = px.Position
        task.spawn(function()
            while px.Parent and (tick() - start) < life do
                local t = (tick() - start) / life
                px.CFrame = CFrame.new(startPos + dir * t)
                px.Transparency = t
                px.Size = Vector3.new(0.18, 0.18, 0.18) * (1 - t * 0.7)
                task.wait()
            end
            pcall(function() px:Destroy() end)
        end)
    end
end

