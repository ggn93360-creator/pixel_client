        end
    end

    fpsCounter = fpsCounter + 1
    if time() - lastFpsUpdate >= 1 then
        currentFps = fpsCounter
        fpsCounter = 0
        lastFpsUpdate = time()
    end

    for key, data in pairs(skillSlots) do
        local timeLeft = data.CooldownEnd - tick()
