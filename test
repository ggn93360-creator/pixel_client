-- ========================================================
-- BODY EMISSION — кольцо под ногами + излучение вокруг
-- (scope: BuildUI — видно Combat/Visuals toggles)
-- ========================================================
local bodyEmissionConn = nil

local function stopBodyEmission()
    if bodyEmissionConn then
        pcall(function() bodyEmissionConn:Disconnect() end)
        bodyEmissionConn = nil
    end
    local char = LocalPlayer.Character
    if char then
        local f = char:FindFirstChild("PC_BodyEmission")
        if f then pcall(function() f:Destroy() end) end
        local hl = char:FindFirstChild("PC_Outline")
        if hl then pcall(function() hl:Destroy() end) end
        local root = char:FindFirstChild("HumanoidRootPart")
        if root then
            local att = root:FindFirstChild("EmitAtt")
            if att then pcall(function() att:Destroy() end) end
        end
    end
end

local function startBodyEmission()
    stopBodyEmission()
    if not Settings.BodyOutline then return end
    local char = LocalPlayer.Character
    if not char then
        warn("[PixelClient] BodyEmission: no character")
        return
    end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then
        warn("[PixelClient] BodyEmission: no HRP")
        return
    end

    local folder = Instance.new("Folder")
    folder.Name = "PC_BodyEmission"
    folder.Parent = char
    UnloadSystem:TrackInstance(folder)

    -- Highlight
    local hl = Instance.new("Highlight")
    hl.Name = "PC_Outline"
    hl.Adornee = char
    hl.FillTransparency = 0.7
    hl.OutlineTransparency = 0
    hl.OutlineColor = COLOR_TITLE
    hl.FillColor = COLOR_ACCENT
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.Parent = char
    UnloadSystem:TrackInstance(hl)

    local size = tonumber(Settings.BodyEmissionSize) or 1.2
    local rate = tonumber(Settings.BodyEmissionRate) or 40

    -- Кольцо (PartType.Cylinder лежит плоско: поворот -90 по Z)
    local ring = Instance.new("Part")
    ring.Name = "EmitRing"
    ring.Shape = Enum.PartType.Cylinder
    ring.Anchored = true
    ring.CanCollide = false
    ring.CanQuery = false
    ring.CanTouch = false
    ring.CastShadow = false
    ring.Material = Enum.Material.Neon
    ring.Color = COLOR_ACCENT
    ring.Transparency = 0.2
    ring.Size = Vector3.new(0.15, size * 5, size * 5) -- cylinder: X=height, YZ=diameter
    ring.CFrame = CFrame.new(root.Position.X, root.Position.Y - 2.9, root.Position.Z) * CFrame.Angles(0, 0, math.rad(90))
    ring.Parent = folder

    local disc = Instance.new("Part")
    disc.Name = "EmitDisc"
    disc.Shape = Enum.PartType.Cylinder
    disc.Anchored = true
    disc.CanCollide = false
    disc.CanQuery = false
    disc.CanTouch = false
    disc.CastShadow = false
    disc.Material = Enum.Material.Neon
    disc.Color = COLOR_GLOW
    disc.Transparency = 0.55
    disc.Size = Vector3.new(0.1, size * 2.8, size * 2.8)
    disc.CFrame = CFrame.new(root.Position.X, root.Position.Y - 2.85, root.Position.Z) * CFrame.Angles(0, 0, math.rad(90))
    disc.Parent = folder

    -- PointLight под ногами
    local light = Instance.new("PointLight")
    light.Name = "EmitLight"
    light.Brightness = 3
    light.Range = 12 * size
    light.Color = COLOR_ACCENT
    light.Parent = disc

    -- Attachment + particles on HRP
    local att = Instance.new("Attachment")
    att.Name = "EmitAtt"
    att.Position = Vector3.new(0, -2.4, 0)
    att.Parent = root

    local pe = Instance.new("ParticleEmitter")
    pe.Name = "EmitParticles"
    pe.Texture = "rbxassetid://243660364" -- sparkles
    pe.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, COLOR_ACCENT),
        ColorSequenceKeypoint.new(0.5, COLOR_GLOW),
        ColorSequenceKeypoint.new(1, COLOR_TITLE),
    })
    pe.Size = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 0.4 * size),
        NumberSequenceKeypoint.new(0.4, 0.7 * size),
        NumberSequenceKeypoint.new(1, 0),
    })
    pe.Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 0.15),
        NumberSequenceKeypoint.new(0.6, 0.45),
        NumberSequenceKeypoint.new(1, 1),
    })
    pe.Lifetime = NumberRange.new(0.8, 1.6)
    pe.Rate = rate
    pe.Speed = NumberRange.new(2, 5)
    pe.SpreadAngle = Vector2.new(40, 40)
    pe.Acceleration = Vector3.new(0, 3, 0)
    pe.RotSpeed = NumberRange.new(-120, 120)
    pe.LightEmission = 1
    pe.LightInfluence = 0
    pe.Drag = 0.5
    pe.Parent = att

    local ringPe = Instance.new("ParticleEmitter")
    ringPe.Name = "RingSparks"
    ringPe.Texture = "rbxassetid://243660364"
    ringPe.Color = ColorSequence.new(COLOR_ACCENT, COLOR_TITLE)
    ringPe.Size = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 0.5 * size),
        NumberSequenceKeypoint.new(1, 0),
    })
    ringPe.Transparency = NumberSequence.new(0.3, 1)
    ringPe.Lifetime = NumberRange.new(0.5, 1)
    ringPe.Rate = rate * 0.8
    ringPe.Speed = NumberRange.new(1, 3)
    ringPe.SpreadAngle = Vector2.new(180, 180)
    ringPe.LightEmission = 1
    ringPe.Parent = att

    -- burst on start so visible immediately
    pe:Emit(20)
    ringPe:Emit(15)

    bodyEmissionConn = RunService.RenderStepped:Connect(function()
        if not UnloadSystem.Active or not Settings.BodyOutline then
            stopBodyEmission()
            return
        end
        local c = LocalPlayer.Character
        local r = c and c:FindFirstChild("HumanoidRootPart")
        if not r or not ring.Parent then
            stopBodyEmission()
            return
        end
        local pulse = 0.3 + math.abs(math.sin(tick() * 3.5)) * 0.4
        local sz = tonumber(Settings.BodyEmissionSize) or 1.2
        ring.Size = Vector3.new(0.15, sz * 5, sz * 5)
        disc.Size = Vector3.new(0.1, sz * 2.8, sz * 2.8)
        local y = r.Position.Y - 2.9
        ring.CFrame = CFrame.new(r.Position.X, y, r.Position.Z) * CFrame.Angles(0, 0, math.rad(90))
        disc.CFrame = CFrame.new(r.Position.X, y + 0.05, r.Position.Z) * CFrame.Angles(0, 0, math.rad(90))
        ring.Transparency = 0.15 + (1 - pulse) * 0.35
        disc.Transparency = 0.45 + (1 - pulse) * 0.35
        ring.Color = COLOR_ACCENT
        disc.Color = COLOR_GLOW
        light.Brightness = 2 + pulse * 3
