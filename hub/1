-- ======================= VISUALS: COSMETICS (гардероб: можно одевать несколько вещей сразу) =======================
local WardrobeFlags = {wings = false, halo = false, trail = false}
Pixel.CosmFlags = function() return WardrobeFlags end

do
	local fxFolder = new("Folder", {Name = "PixelFX"}, workspace)

	-- ---------- хелперы ----------
	local function mkPart(size, color, material, transparency, parent, shape)
		local p = Instance.new("Part")
		p.Size = size; p.Color = color; p.Material = material; p.Transparency = transparency
		p.CanCollide = false; p.CanTouch = false; p.CanQuery = false; p.Massless = true
		p.CastShadow = false; p.Anchored = false
		if shape == "sphere" then new("SpecialMesh", {MeshType = Enum.MeshType.Sphere}, p)
		elseif shape == "cyl" then p.Shape = Enum.PartType.Cylinder
		elseif shape == "ball" then p.Shape = Enum.PartType.Ball end
		p.Parent = parent
		return p
	end
	local function weld(p0, p1, c0)
		local w = Instance.new("Weld")
		w.Part0 = p0; w.Part1 = p1; w.C0 = c0
		w.Parent = p1
		return w
	end
	local function matOf(S) return Enum.Material[S.material] or Enum.Material.Neon end
	-- цветокоррекция вещи: сдвиг оттенка, насыщенность, яркость
	local function adj(S, c)
		if S.hue == 0 and S.sat == 1 and S.val == 1 then return c end
		local h, sa, v = c:ToHSV()
		return Color3.fromHSV((h + S.hue / 360) % 1, math.clamp(sa * S.sat, 0, 1), math.clamp(v * S.val, 0, 1))
	end
	local curEnv
	local function pt(model, S, size, color, shape, alpha)
		local col = adj(S, color or S.color)
		local p = mkPart(size, col, matOf(S), alpha or S.alpha, model, shape)
		if curEnv and curEnv.parts then curEnv.parts[#curEnv.parts + 1] = {p, col} end
		return p
	end
	local UP = CFrame.Angles(0, 0, math.rad(90)) -- цилиндр (ось X) -> вертикальный

	-- ---------- хелперы: сглаживание анимаций, гладкие кольца и цепочки ----------
	local function smooth(env, key, target, dt, rate)
		local v = env.st[key] or target
		v = v + (target - v) * (1 - math.exp(-(rate or 8) * (dt or 0.016)))
		env.st[key] = v
		return v
	end
	-- кольцо из шариков (гладкий "бублик") в плоскости XZ; plane - CFrame плоскости/центра
	local function ringBalls(root, model, S, n, r, y, d, colFn, alpha, plane)
		for k = 0, n - 1 do
			local a = k / n * math.pi * 2
			weld(root, pt(model, S, Vector3.new(d, d, d), colFn and colFn(k / n) or S.color, "ball", alpha),
				(plane or CFrame.new()) * CFrame.new(math.cos(a) * r, y, math.sin(a) * r))
		end
	end
	-- гладкая трубка по точкам (цилиндры + шарики на стыках), толщина th0 -> th1
	local function chain(root, model, S, pts, th0, th1, colFn, alpha)
		weld(root, pt(model, S, Vector3.new(th0, th0, th0), colFn and colFn(0) or S.color, "ball", alpha), CFrame.new(pts[1]))
		for i = 1, #pts - 1 do
			local f = (i - 1) / math.max(#pts - 2, 1)
			local th = th0 + (th1 - th0) * f
			local a, b = pts[i], pts[i + 1]
			local len = (b - a).Magnitude
			if len > 0.001 then
				local col = colFn and colFn(f) or S.color
				weld(root, pt(model, S, Vector3.new(len, th, th), col, "cyl", alpha), CFrame.lookAt((a + b) / 2, b) * CFrame.Angles(0, math.pi / 2, 0))
				weld(root, pt(model, S, Vector3.new(th, th, th), col, "ball", alpha), CFrame.new(b))
			end
		end
	end


