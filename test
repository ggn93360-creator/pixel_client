        wingModel.Parent = char
        local sz = Settings.WingSize or 1
        local back = Settings.WingBack or 0.65
        local outBase = Settings.WingOut or 0.85
        local upBase = Settings.WingUp or 0.55
        local style = math.clamp(tonumber(Settings.WingStyle) or 1, 1, 5)
        local joints = {}

        local palette = {
            [1] = {Color3.fromRGB(255, 255, 255), Color3.fromRGB(220, 230, 255), Color3.fromRGB(180, 200, 255)}, -- white angel
            [2] = {Color3.fromRGB(25, 0, 0), Color3.fromRGB(120, 10, 15), Color3.fromRGB(200, 40, 30)}, -- demon
            [3] = {Color3.fromRGB(0, 220, 255), Color3.fromRGB(80, 120, 255), Color3.fromRGB(200, 100, 255)}, -- cyber
            [4] = {Color3.fromRGB(15, 15, 20), Color3.fromRGB(50, 50, 60), Color3.fromRGB(90, 90, 100)}, -- shadow
            [5] = {Color3.fromRGB(255, 100, 180), Color3.fromRGB(180, 120, 255), Color3.fromRGB(100, 220, 255)}, -- fairy
        }
        local cols = palette[style] or palette[1]
        local mat = (style == 3) and Enum.Material.Neon or Enum.Material.SmoothPlastic

        local function buildWing(side)
            -- shoulder pad
            local shoulder = Instance.new("Part")
            shoulder.Name = (side < 0 and "L" or "R") .. "Shoulder"
            shoulder.Size = Vector3.new(0.35 * sz, 0.45 * sz, 0.55 * sz)
            shoulder.CanCollide = false
            shoulder.Massless = true
            shoulder.Material = mat
            shoulder.Color = cols[2]
            shoulder.Parent = wingModel
            local ws = Instance.new("Weld")
            ws.Part0 = torso
            ws.Part1 = shoulder
            local baseS = CFrame.new(side * 0.55, upBase * 0.4, back)
                * CFrame.Angles(0, math.rad(side * 15), math.rad(side * 8))
            ws.C0 = baseS
            ws.Parent = shoulder
            table.insert(joints, {weld = ws, base = baseS, side = side, layer = 0, idx = 0})

            -- long primary feathers (fan)
            local count = (style == 5) and 9 or 7
            for i = 1, count do
                local f = Instance.new("WedgePart")
                f.Name = (side < 0 and "L" or "R") .. "Feather" .. i
                local len = (3.2 - i * 0.18) * sz
                local thick = (0.12 + (count - i) * 0.02) * sz
                local wide = (0.9 - i * 0.05) * sz
                f.Size = Vector3.new(thick, len, wide)
                f.CanCollide = false
                f.Massless = true
                f.Material = mat
                f.Color = cols[(i % 3) + 1]
                f.Transparency = (style == 4) and (0.25 + i * 0.03) or (0.05 + i * 0.015)
                f.Parent = wingModel

                local t_norm = (i - 1) / math.max(count - 1, 1) -- 0..1 from top to tip
                local spread = 25 + t_norm * 55 -- degrees fan
                local lift = 15 - t_norm * 35
                local out = outBase + t_norm * 1.8 * sz
                local up = upBase + (1 - t_norm) * 0.6 - t_norm * 0.3
                local bk = back - t_norm * 0.15

                local w = Instance.new("Weld")
                w.Part0 = torso
                w.Part1 = f
                -- перевёрнуты + наклон вперёд (WingTilt)
                local tilt = tonumber(Settings.WingTilt) or 18
                local base = CFrame.new(side * out, up, bk)
                    * CFrame.Angles(
                        math.rad(180 + lift - tilt),
                        math.rad(side * (-90 - spread * 0.25)),
                        math.rad(side * (-spread * 0.9))
                    )
                w.C0 = base
                w.Parent = f
                table.insert(joints, {weld = w, base = base, side = side, layer = 1, idx = i})
            end

            -- inner coverts (shorter layer)
            for i = 1, 4 do
                local c = Instance.new("Part")
                c.Name = (side < 0 and "L" or "R") .. "Covert" .. i
                c.Size = Vector3.new(0.1 * sz, (1.6 - i * 0.2) * sz, (0.7 - i * 0.08) * sz)
                c.CanCollide = false
                c.Massless = true
                c.Material = mat
                c.Color = cols[2]
                c.Transparency = 0.1
                c.Parent = wingModel
                local wc = Instance.new("Weld")
                wc.Part0 = torso
                wc.Part1 = c
                local tilt = tonumber(Settings.WingTilt) or 18
                local baseC = CFrame.new(side * (outBase + 0.35 + i * 0.12), upBase + 0.15 - i * 0.05, back + 0.1)
                    * CFrame.Angles(math.rad(180 + 5 - i * 4 - tilt * 0.7), math.rad(side * (-85 - i * 6)), math.rad(side * (-20 - i * 8)))
                wc.C0 = baseC
                wc.Parent = c
                table.insert(joints, {weld = wc, base = baseC, side = side, layer = 2, idx = i})
            end

            local glow = Instance.new("Part")
            glow.Size = Vector3.new(0.25, 0.25, 0.25)
            glow.Transparency = 1
            glow.CanCollide = false
            glow.Massless = true
            glow.Parent = wingModel
            local gw = Instance.new("Weld")
            gw.Part0 = torso
            gw.Part1 = glow
            gw.C0 = CFrame.new(side * (outBase + 0.8), upBase, back)
            gw.Parent = glow
            local pl = Instance.new("PointLight", glow)
            pl.Color = cols[1]
            pl.Brightness = (style == 4) and 0.3 or 0.9
            pl.Range = 7
        end

        buildWing(-1)
        buildWing(1)

        UnloadSystem:TrackConnection(RunService.RenderStepped:Connect(function()
            if not Settings.WingsEnabled or not wingModel.Parent then return end
            local spd = Settings.WingFlapSpeed or 2.8
            local amp = Settings.WingFlapAmount or 24
            local styleF = math.clamp(tonumber(Settings.WingFlapStyle) or 1, 1, 4)
            local phase = tick() * spd
            for _, j in ipairs(joints) do
                if j.weld and j.weld.Parent then
                    local lag = j.layer * 0.16 + j.idx * 0.06
                    local p2 = phase - lag
                    local flap, foldMul, openMul, twistMul
                    if styleF == 1 then
                        -- soft wave
                        local s = math.sin(p2)
                        flap = s * amp
                        foldMul, openMul, twistMul = 0.55, 0.35, 0.15
                    elseif styleF == 2 then
                        -- bird: резкий вниз, мягкий вверх
                        local s = math.sin(p2)
                        local asym = s >= 0 and (s * 0.7) or (s * 1.45)
                        flap = (asym + math.sin(p2 * 2.1) * 0.18) * amp
                        foldMul, openMul, twistMul = 0.75, 0.5, 0.25
                    elseif styleF == 3 then
                        -- heavy slow power flaps
                        local s = math.sin(p2)
                        local beat = math.sign(s) * (math.abs(s) ^ 0.55)
                        flap = beat * amp * 1.15
                        foldMul, openMul, twistMul = 0.9, 0.55, 0.1
                    else
                        -- glide: почти плоско + лёгкая дрожь
                        flap = math.sin(p2 * 0.35) * amp * 0.35 + math.sin(p2 * 3.2) * amp * 0.12
                        foldMul, openMul, twistMul = 0.35, 0.55, 0.4
                    end
                    local fold = math.rad(flap * (foldMul + j.layer * 0.1))
                    local open = math.rad(flap * (openMul + j.idx * 0.035))
                    local twist = math.rad(math.sin(p2 * 1.15) * amp * twistMul)
                    pcall(function()
                        j.weld.C0 = j.base * CFrame.Angles(fold * 0.7, twist * j.side * 0.22, j.side * open)
                    end)
                end
            end
        end))
    end

