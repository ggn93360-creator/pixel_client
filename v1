-- Анимация стартовой загрузки
task.spawn(function()
    local steps = {
        {0.15, "Initializing..."},
        {0.35, "Detecting game..."},
        {0.55, "Loading modules..."},
        {0.78, "Preparing UI..."},
        {1.00, "Done"},
    }
    local idx = 1
    local t0 = tick()
    local duration = 1.35
    while tick() - t0 < duration do
        local p = math.clamp((tick() - t0) / duration, 0, 1)
        local ep = 1 - (1 - p) * (1 - p)
        BarFill.Size = UDim2.new(ep, 0, 1, 0)
        LoadPct.Text = math.floor(ep * 100) .. "%"
        while idx <= #steps and ep >= steps[idx][1] do
            LoadSub.Text = steps[idx][2]
            idx = idx + 1
        end
        task.wait()
    end
    BarFill.Size = UDim2.new(1, 0, 1, 0)
    LoadPct.Text = "100%"
    LoadSub.Text = "Welcome"
    task.wait(0.2)

    TweenService:Create(LoadOverlay, TweenInfo.new(0.35), {BackgroundTransparency = 1}):Play()
    for _, d in ipairs(LoadOverlay:GetDescendants()) do
        if d:IsA("TextLabel") then
            TweenService:Create(d, TweenInfo.new(0.3), {TextTransparency = 1}):Play()
        elseif d:IsA("Frame") and d ~= LoadOverlay then
            TweenService:Create(d, TweenInfo.new(0.3), {BackgroundTransparency = 1}):Play()
        end
    end
    task.wait(0.35)
    LoadOverlay.Visible = false
    Window.Visible = true
    Window.Size = UDim2.new(0, 480, 0, 330)
    Window.BackgroundTransparency = 0.3
    TweenService:Create(Window, TweenInfo.new(0.4, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
        Size = UDim2.new(0, 520, 0, 360),
        BackgroundTransparency = 0.05
    }):Play()
end)

