local UnloadSystem = { Connections = {}, Instances = {} }

function UnloadSystem:TrackConnection(conn)
    table.insert(self.Connections, conn)
    return conn
end

function UnloadSystem:TrackInstance(inst)
    table.insert(self.Instances, inst)
    return inst
end

