	Size = UDim2.fromOffset(0, 0), Position = UDim2.fromOffset(14, 14)}, gui)
local hudStackLay = new("UIListLayout", {SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 6)}, hudStack)

local function posToStr(p)
	return p and string.format("%g,%g,%g,%g", p.X.Scale, p.X.Offset, p.Y.Scale, p.Y.Offset) or ""
end
local function strToPos(s)
	local a, b, c, d = tostring(s):match("^([%-%d%.e%+]+),([%-%d%.e%+]+),([%-%d%.e%+]+),([%-%d%.e%+]+)$")
	if a then return UDim2.new(tonumber(a), tonumber(b), tonumber(c), tonumber(d)) end
end

local function hudItem(name, frame, o)
	o = o or {}
	local it = {name = name, frame = frame, canDock = o.dock and true or false, docked = o.docked and true or false,
		scale = 1, w = 0, h = 0, anchor = o.anchor or Vector2.new(0, 0), defPos = o.defPos or UDim2.fromOffset(14, 14),
		pos = nil, order = o.order or 1}
	local uis = new("UIScale", {Scale = 1}, frame)
	local baseAuto, baseSize = frame.AutomaticSize, frame.Size
	frame.Active = true

	function it.applySize()
		local autoX = baseAuto == Enum.AutomaticSize.XY or baseAuto == Enum.AutomaticSize.X
		local autoY = baseAuto == Enum.AutomaticSize.XY or baseAuto == Enum.AutomaticSize.Y
		local useW, useH = it.w > 0, it.h > 0
		local nx, ny = autoX and not useW, autoY and not useH
		frame.AutomaticSize = (nx and ny) and Enum.AutomaticSize.XY or (nx and Enum.AutomaticSize.X)
			or (ny and Enum.AutomaticSize.Y) or Enum.AutomaticSize.None
		frame.Size = UDim2.new(useW and UDim.new(0, it.w) or baseSize.X, useH and UDim.new(0, it.h) or baseSize.Y)
	end
	function it.setBase(sz) baseSize = sz; it.applySize() end
	function it.apply()
		local dock = it.canDock and it.docked
		frame.Parent = dock and hudStack or gui
		if dock then
			frame.AnchorPoint = Vector2.new(0, 0); frame.Position = UDim2.new(); frame.LayoutOrder = it.order
		else
			frame.AnchorPoint = it.anchor; frame.Position = it.pos or it.defPos
		end
		uis.Scale = it.scale * Fit.hud
		it.applySize()
	end

	-- перетаскивание (только в раздельном режиме)
	local dragging, start, startPos
	frame.InputBegan:Connect(function(i)
		if isPress(i) and not (it.canDock and it.docked) and not o.noDrag then
			dragging, start, startPos = true, i.Position, frame.Position
		end
	end)
	connect(UIS.InputChanged, function(i)
		if dragging and isMove(i) then
			local d = i.Position - start
			frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
		end
	end)
	connect(UIS.InputEnded, function(i)
		if dragging and isPress(i) then dragging = false; it.pos = frame.Position end
	end)

	register("HUD/" .. name .. "/pos", function() return posToStr(it.pos) end, function(v) it.pos = strToPos(v); it.apply() end)
	table.insert(HudItems, it)
	table.insert(Fit.listeners, it.apply)
	it.apply()
	return it
end
Pixel.HudItem = hudItem

