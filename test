local function protectDashInFront(tRoot)
    local myChar = LocalPlayer.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myRoot or not tRoot then return end
    local look = tRoot.CFrame.LookVector
    -- stand in FRONT of protected player (between them and threat)
    local pos = tRoot.Position + look * 3.5 + Vector3.new(0, 0.3, 0)
    myRoot.CFrame = CFrame.lookAt(pos, pos + look)
    myRoot.AssemblyLinearVelocity = Vector3.zero
    myRoot.AssemblyAngularVelocity = Vector3.zero
end

-- Слот стенда: чуть ЗА правым плечом мастера (полёт, не телепорт)
local function getStandShoulderSlot(tRoot)
    local want = math.clamp(tonumber(Settings.StandDistance) or 3.2, 1.5, 8)
    local look = tRoot.CFrame.LookVector
    local right = tRoot.CFrame.RightVector
    local flatLook = Vector3.new(look.X, 0, look.Z)
    if flatLook.Magnitude > 0.05 then flatLook = flatLook.Unit else flatLook = Vector3.new(0, 0, -1) end
    local flatRight = Vector3.new(right.X, 0, right.Z)
    if flatRight.Magnitude > 0.05 then flatRight = flatRight.Unit else flatRight = Vector3.new(1, 0, 0) end

    local bob = 0
    if Settings.StandIdleBob then
        bob = math.sin(tick() * 2.4) * 0.25
    end
    -- назад + чуть ПРАВЕЕ плеча + выше
    return tRoot.Position
        - flatLook * want
        + flatRight * 2.15
        + Vector3.new(0, 1.35 + bob, 0)
end

-- Магнит-стайл: далеко = ТЕЛЕПОРТ, близко = мгновенный snap (как автофарм)
local function standFlyTo(myRoot, desired, lookAt, dt)
    if not myRoot or not desired then return end
    local to = desired - myRoot.Position
    local dist = to.Magnitude
    local lookPos = lookAt or (desired + myRoot.CFrame.LookVector)
    dt = math.clamp(dt or 0.016, 0.001, 0.05)

    -- уже на точке
    if dist < 0.08 then
        myRoot.CFrame = CFrame.lookAt(desired, lookPos)
        myRoot.AssemblyLinearVelocity = Vector3.zero
        myRoot.AssemblyAngularVelocity = Vector3.zero
        return
    end

    -- далеко → сразу телепорт к слоту (магнит)
    if dist > 8 then
        myRoot.CFrame = CFrame.lookAt(desired, lookPos)
        myRoot.AssemblyLinearVelocity = Vector3.zero
        myRoot.AssemblyAngularVelocity = Vector3.zero
        return
    end

    -- средне → почти мгновенный lerp (0.55–0.9 за кадр)
    if dist > 2.5 then
        local alpha = math.clamp(18 * dt, 0.45, 0.92)
        local nextPos = myRoot.Position:Lerp(desired, alpha)
        myRoot.CFrame = CFrame.lookAt(nextPos, lookPos)
        myRoot.AssemblyLinearVelocity = Vector3.zero
        myRoot.AssemblyAngularVelocity = Vector3.zero
        return
    end

    -- близко → жёсткий snap + лёгкий vel
    local alpha = math.clamp(28 * dt, 0.65, 0.98)
    local nextPos = myRoot.Position:Lerp(desired, alpha)
    myRoot.CFrame = CFrame.lookAt(nextPos, lookPos)
    myRoot.AssemblyLinearVelocity = Vector3.zero
    myRoot.AssemblyAngularVelocity = Vector3.zero
end

