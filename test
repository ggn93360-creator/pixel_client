local function DetectCharacterName(char)
    if not char then return nil end
    -- Инструмент в руке / в персонаже часто называется как персонаж
    for _, obj in ipairs(char:GetChildren()) do
        if obj:IsA("Tool") or obj:IsA("Model") then
            local n = string.lower(obj.Name)
            if n:find("saitama") or n:find("caped") then return "Saitama" end
            if n:find("garou") then return "Garou" end
            if n:find("genos") then return "Genos" end
            if n:find("sonic") then return "Sonic" end
            if n:find("metal") and n:find("bat") then return "Metal Bat" end
            if n:find("atomic") then return "Atomic" end
            if n:find("tatsumaki") or n:find("tornado") then return "Tatsumaki" end
            if n:find("suiryu") then return "Suiryu" end
            if n:find("kj") then return "KJ" end
        end
    end
    -- Иногда имя в атрибутах
    local attr = char:GetAttribute("Character") or char:GetAttribute("Char") or char:GetAttribute("SelectedCharacter")
    if attr then return tostring(attr) end
    return nil
end

local function IsUltAnim(name)
