local function makeShimmerClone(fromChar, nameTag)
    if not fromChar then return nil end
    local ok, clone = pcall(function()
        fromChar.Archivable = true
        local c = fromChar:Clone()
        fromChar.Archivable = false
        return c
    end)
    if not ok or not clone then return nil end
    clone.Name = nameTag or "PixelBTSelf"
    for _, d in ipairs(clone:GetDescendants()) do
        if d:IsA("BasePart") then
            d.Anchored = true
            d.CanCollide = false
            d.CanTouch = false
            d.CanQuery = false
            d.CastShadow = false
            d.Massless = true
            pcall(function() d.CollisionGroup = "PixelBTNoclip" end)
            pcall(function()
                d.Material = Enum.Material.ForceField
                if d.Name == "HumanoidRootPart" then
                    d.Transparency = 1
                else
                    d.Transparency = 0.35
                end
            end)
        elseif d:IsA("Script") or d:IsA("LocalScript") or d:IsA("Sound")
            or d:IsA("ParticleEmitter") or d:IsA("Fire") or d:IsA("Smoke")
            or d:IsA("Highlight") or d:IsA("ForceField")
            or d:IsA("BillboardGui") or d:IsA("SurfaceGui") then
            pcall(function() d:Destroy() end)
        elseif d:IsA("Humanoid") then
            d.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
            d.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
            pcall(function()
                d.PlatformStand = true
                d.WalkSpeed = 0
                d.JumpPower = 0
            end)
        end
    end
    for _, ch in ipairs(clone:GetChildren()) do
        if ch:IsA("LocalScript") or ch:IsA("Script") then
            pcall(function() ch:Destroy() end)
        end
    end
    local root = clone:FindFirstChild("HumanoidRootPart") or clone.PrimaryPart
    if root then
        local bb = Instance.new("BillboardGui")
        bb.Name = "BTLabel"
        bb.Size = UDim2.new(0, 120, 0, 34)
        bb.StudsOffset = Vector3.new(0, 3.5, 0)
        bb.AlwaysOnTop = true
        bb.Adornee = root
        bb.Parent = clone
        local lbl = Instance.new("TextLabel")
        lbl.Name = "Txt"
        lbl.Size = UDim2.new(1, 0, 1, 0)
        lbl.BackgroundTransparency = 1
        lbl.Font = Enum.Font.GothamBold
        lbl.TextSize = 12
        lbl.TextColor3 = Color3.fromRGB(255, 200, 230)
        lbl.TextStrokeTransparency = 0.3
        lbl.Text = "BT YOU"
        lbl.Parent = bb
    end
    clone.Parent = Workspace
    UnloadSystem:TrackInstance(clone)
    return clone
end

local function shimmerClone(model, t, baseHue)
    if not model or not model.Parent then return end
    local hue = (baseHue + (t * 0.4) % 1) % 1
    local col = Color3.fromHSV(hue, 0.6, 1)
    local pulse = 0.28 + 0.28 * (0.5 + 0.5 * math.sin(t * 7))
    for _, d in ipairs(model:GetDescendants()) do
        if d:IsA("BasePart") then
            if d.Name == "HumanoidRootPart" then
                d.Transparency = 1
            else
                d.Color = col
                d.Transparency = pulse
                d.Material = Enum.Material.ForceField
            end
        end
    end
end

