	-- ====================== НОВЫЕ АКСЕССУАРЫ ======================
	-- кольцо из сегментов в плоскости XZ вокруг оси Y
	local function circle(root, model, S, n, r, y, th, h, colFn, alpha)
		local segLen = 2 * math.pi * r / n * 1.15
		for k = 0, n - 1 do
			local a = k / n * math.pi * 2
			weld(root, pt(model, S, Vector3.new(th, h, segLen), colFn and colFn(k / n) or S.color, nil, alpha),
				CFrame.new(math.cos(a) * r, y, math.sin(a) * r) * CFrame.Angles(0, -a, 0))
		end
	end
	-- конус из стопки цилиндров (c0 -> c1 по высоте, bend - наклон назад)
	local function cone(root, model, S, s, layers, d0, d1, h, y0, bend, c0, c1)
		for k = 1, layers do
			local f = (k - 1) / (layers - 1)
			local d = (d0 + (d1 - d0) * f) * s
			weld(root, pt(model, S, Vector3.new(h * s, d, d), c0:Lerp(c1, f), "cyl"),
				CFrame.new(0, y0 * s + (k - 1) * h * s * 0.9, bend * f * f * s) * UP)
		end
	end
	local function drawSword(root, model, S, s, cf)
		weld(root, pt(model, S, Vector3.new(0.14 * s, 3.4 * s, 0.14 * s), S.color), cf * CFrame.new(0, -0.2 * s, 0))
		weld(root, pt(model, S, Vector3.new(0.16 * s, 0.9 * s, 0.16 * s), S.color2, nil, 0), cf * CFrame.new(0, 1.95 * s, 0))
