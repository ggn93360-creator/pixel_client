    end

    -- Логика отображения других пользователей скрипта (Client Users ESP)
    for _, child in pairs(ClientUsersFolder:GetChildren()) do
        child:Destroy()
    end

    if Settings.ClientUsersESP then
        for _, player in pairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character then
                local char = player.Character
                local head = char:FindFirstChild("Head")
                if char:GetAttribute("PixelsClientUser") == true and head then
                    local billboard = Instance.new("BillboardGui")
                    billboard.Name = "ClientUserTag"
                    billboard.Size = UDim2.new(0, 120, 0, 30)
                    billboard.StudsOffset = Vector3.new(0, 2.5, 0)
                    billboard.AlwaysOnTop = true
                    billboard.Parent = ClientUsersFolder
                    billboard.Adornee = head

                    local tagLabel = Instance.new("TextLabel", billboard)
                    tagLabel.Size = UDim2.new(1, 0, 1, 0)
                    tagLabel.BackgroundTransparency = 1
                    tagLabel.Text = "⚡ [Pixels User]"
                    tagLabel.TextColor3 = Color3.fromRGB(0, 255, 255)
                    tagLabel.TextStrokeTransparency = 0
                    tagLabel.Font = Enum.Font.SourceSansBold
                    tagLabel.TextSize = 14
                end
            end
        end
    end

    local closestTarget = nil
    local shortestDist = Settings.Range

    if Settings.AutoF or Settings.TargetESP then
        for _, player in pairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character then
                local isFriend = false
                if Settings.IgnoreFriends then
                    isFriend = IsFriend(player)
                end

                if not isFriend then
                    local tRoot = player.Character:FindFirstChild("HumanoidRootPart")
                    local tHum = player.Character:FindFirstChildOfClass("Humanoid")
                    if tRoot and tHum and tHum.Health > 0 then
                        local heightDiff = math.abs(rootLocal.Position.Y - tRoot.Position.Y)
                        if heightDiff <= Settings.MaxHeightDiff then
                            local dist = (Vector3.new(rootLocal.Position.X, 0, rootLocal.Position.Z) - Vector3.new(tRoot.Position.X, 0, tRoot.Position.Z)).Magnitude
                            if dist <= shortestDist then
                                shortestDist = dist
                                closestTarget = player.Character
                            end
                        end
                    end
                end
            end
        end
    end

    currentTarget = closestTarget

    -- Отслеживание убийства цели (Killstreak + Kill Sound)
    if currentTarget then
        local targetHum = currentTarget:FindFirstChildOfClass("Humanoid")
        if targetHum and targetHum ~= lastTargetHum then
            if targetDiedConn then targetDiedConn:Disconnect() end
            lastTargetHum = targetHum
            targetDiedConn = targetHum.Died:Connect(function()
                Settings.Killstreak = Settings.Killstreak + 1
                if Settings.KillSoundEnabled then
                    PlayKillSound(currentKillSoundIndex, false)
                end
            end)
        end
    else
        if targetDiedConn then
            targetDiedConn:Disconnect()
            targetDiedConn = nil
        end
        lastTargetHum = nil
    end

    if currentTarget and Settings.AutoF then
        local tRoot = currentTarget:FindFirstChild("HumanoidRootPart")
        if tRoot then FaceTarget(tRoot) end
    end

    for _, orb in ipairs(Orbs) do orb.Transparency = 1 end
    ESPRing.Transparency = 1
    ESPHighlight.Enabled = false
    ESPArrow.Transparency = 1

    if Settings.TargetESP and currentTarget then
        local tRoot = currentTarget:FindFirstChild("HumanoidRootPart")
        if tRoot then
            if Settings.ESPStyle == "Orbs" then
                local time = tick() * 3
                local radius = 3
                for i, orb in ipairs(Orbs) do
                    orb.Transparency = 0.3
                    local offset = (math.pi * 2 / #Orbs) * i
                    orb.Position = tRoot.Position + Vector3.new(math.cos(time + offset) * radius, math.sin(time * 2 + offset) * 1.5, math.sin(time + offset) * radius)
                end
            elseif Settings.ESPStyle == "Ring" then
                ESPRing.Transparency = 0.3
                ESPRing.Position = tRoot.Position - Vector3.new(0, 2.7, 0)
            elseif Settings.ESPStyle == "Box" then
                ESPHighlight.Adornee = currentTarget
                ESPHighlight.Enabled = true
            elseif Settings.ESPStyle == "Arrows" then
                ESPArrow.Transparency = 0.2
                ESPArrow.Position = tRoot.Position + Vector3.new(0, 3.5, 0)
                ESPArrow.CFrame = CFrame.new(ESPArrow.Position) * CFrame.Angles(0, tick() * 4, 0)
            end
        end
    end

    if Settings.TargetHUD and currentTarget then
        HUDFrame.Visible = true
        local targetHum = currentTarget:FindFirstChildOfClass("Humanoid")
        local tPlayer = Players:GetPlayerFromCharacter(currentTarget)
        
        if tPlayer then
            HUDName.Text = tPlayer.DisplayName .. " (@" .. tPlayer.Name .. ")"
            AvatarImage.Image = GetAvatar(tPlayer.UserId)
        end
        
        if targetHum then
            local hpPercent = math.clamp(targetHum.Health / targetHum.MaxHealth, 0, 1)
            HealthFill.Size = UDim2.new(hpPercent, 0, 1, 0)
            HealthFill.BackgroundColor3 = Color3.fromRGB(255 - (hpPercent * 255), hpPercent * 255, 50)
        end
        
        local dist = math.floor((rootLocal.Position - currentTarget.HumanoidRootPart.Position).Magnitude)
        HUDDist.Text = "Distance: " .. dist .. " studs"
        HUDStroke.Color = Color3.fromRGB(255, 50, 50)
    else
        HUDFrame.Visible = false
    end

    if isBlocking and not Settings.AutoF then
        isBlocking = false
        currentBlockTrack = nil
        pcall(function() VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.F, false, game) end)
    end
end))
