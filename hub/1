			Size = UDim2.new(1, -28, 0, 90), Position = UDim2.fromOffset(14, 48)}, f)
		corner(sv, 6)
		local wf = new("Frame", {BackgroundColor3 = WHITE, Size = UDim2.fromScale(1, 1)}, sv)
